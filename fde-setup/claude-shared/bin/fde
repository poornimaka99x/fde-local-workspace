                   help="propose the design-panel shape and select roles; approves nothing")
    c.add_argument("--replace", action="store_true",
                   help="reconfigure a panel that has not started work")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_create)

    c = dp.add_parser("show", help="the panel, its participants and its digests")
    c.add_argument("run_id")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_show)

    c = dp.add_parser("context", help="the sealed context manifest and its hashes")
    c.add_argument("run_id")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_context)

    c = dp.add_parser("start", help="start one participant; returns its exact prompt")
    c.add_argument("run_id")
    c.add_argument("participant_id")
    c.add_argument("--print-prompt", dest="print_prompt", action="store_true",
                   help="write the prompt itself to stdout")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_start)

    c = dp.add_parser("record", help="record what one participant produced")
    c.add_argument("run_id")
    c.add_argument("participant_id")
    c.add_argument("--status", choices=["ok", "failed"], required=True)
    c.add_argument("--file", metavar="FILE")
    c.add_argument("--stdin", action="store_true")
    c.add_argument("--error", metavar="TEXT", help="a safe, operator-visible reason")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_record)

    c = dp.add_parser("stop", help="mark a running participant stopped")
    c.add_argument("run_id")
    c.add_argument("participant_id")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_stop)

    c = dp.add_parser("retry", help="return a failed, stopped or interrupted participant to pending")
    c.add_argument("run_id")
    c.add_argument("participant_id")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_retry)

    c = dp.add_parser("recover", help="turn orphaned running work into retryable interruptions")
    c.add_argument("run_id")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_recover)

    c = dp.add_parser("approve-degraded",
                      help="approve reconciling a panel where only one proposal succeeded")
    c.add_argument("run_id")
    c.set_defaults(fn=cmd_design_panel_approve_degraded)

    c = dp.add_parser("reconcile", help="open the barrier and start reconciliation")
    c.add_argument("run_id")
    c.add_argument("--print-prompt", dest="print_prompt", action="store_true")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_reconcile)

    c = dp.add_parser("record-reconciliation", help="record the reconciliation answer")
    c.add_argument("run_id")
    c.add_argument("--status", choices=["ok", "failed"], default="ok")
    c.add_argument("--file", metavar="FILE")
    c.add_argument("--stdin", action="store_true")
    c.add_argument("--error", metavar="TEXT")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_record_reconciliation)

    c = dp.add_parser("references", help="the vendored design-language reference catalog")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_references)

    c = dp.add_parser("packs", help="the vendored optional guidance packs and what they change")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_packs)

    c = dp.add_parser("lenses", help="the default design lenses")
    c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_design_panel_lenses)

    s = sub.add_parser("_consume-approval", help=argparse.SUPPRESS)
    s.add_argument("run_id")
    s.add_argument("stage")
    s.add_argument("--task-file", required=True)
    s.set_defaults(fn=cmd_consume_approval)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
