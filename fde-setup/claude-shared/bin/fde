#!/usr/bin/env python3
"""fde — the local workflow controller for forward-deployed engineering runs.

One run = one requirement taken from intake to publication. The controller owns
three things the agents must not own themselves:

  1. Roles.       Who does what is decided by the user, per run, before anything
                  else happens. Identities are not roles; nothing is inherited
                  from the previous run.
  2. Approvals.   Codex may write only under a one-time, hash-bound, expiring
                  approval. Anything leaving this machine — Jira, Confluence,
                  SharePoint, Bitbucket, GitHub, deployment, email or Teams —
                  needs its own.
  3. The record.  Every state change, invocation and approval is appended to the
                  run's events.jsonl, so "what did the agents actually do" has a
                  answer that does not depend on anyone's memory.

Python 3, standard library only.
"""
from __future__ import annotations

import argparse
import base64
import contextlib
import datetime as _dt
import errno
import fcntl
import hashlib
import html
import io
import json
import mimetypes
import os
import pathlib
import re
import secrets
import shutil
import stat
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import zipfile

