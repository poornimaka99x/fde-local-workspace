    "FDE_TOOLKIT_ROOT", SHARED / "fde-toolkit" / "plugins" / "fde-core"))

BEDROCK_AWS_PROFILE = "bedrock-dev"
BEDROCK_AWS_REGION = "eu-west-1"
ATLASSIAN_MCP_URL = "https://mcp.atlassian.com/v1/mcp/authv2"

DEFAULT_APPROVAL_TTL_MIN = 30

# Machine-readable views carry a version so a reader can refuse a shape it does
# not understand. Bump it when a field changes meaning, not when one is added.
SCHEMA_VERSION = 1

# Projects group runs. The registry is controller-owned like everything else a
# run depends on: nothing but this controller writes it.
PROJECTS = pathlib.Path(os.environ.get("FDE_PROJECTS_DIR", SHARED / "projects"))

# Attachments are copied into the run, hashed, and recorded append-only. The
# ceiling is configurable downward only — no caller may raise it.
MAX_ATTACHMENT_BYTES = 100 * 1024 * 1024

# Flags that must never appear anywhere in this toolkit.
# One line on purpose: the exemption marker below covers exactly the line it is
# on, and this list is the one honest place these strings are allowed to appear.
FORBIDDEN_CODEX_FLAGS = ("--yolo", "danger-full-access", "--dangerously-bypass-approvals-and-sandbox")  # fde-safety-exempt: the list itself

# ------------------------------------------------------------- state machine --

# Every state a run CAN be in. Which of them a given run actually visits is
# decided by its plan. Most real work is a slice of the full pipeline — research
# that needs validating and presenting; a presentation plus a Jira breakdown —
# and marching such a job through eleven irrelevant states is how a tool starts
# getting worked around instead of used.
STATES = [
    "awaiting_orchestrator",
    "awaiting_plan",
    "awaiting_roles",
    "roles_confirmed",
    "intake",
    "research",
    "solutioning",
    "review",
    "reconciliation",
    "presentation",
    "planning",
    "awaiting_implementation_approval",
    "implementation",
    "verification",
    "awaiting_deployment_approval",
    "deployment",
    "observability",
    "awaiting_publication_approval",
    "publication",
    "complete",
    "blocked",
]

# You pick the orchestrator first, before you even state the ask. It is the
# identity that will read your sentence and propose what the run should do, so
# choosing it is not a detail to fill in later — it is the first decision.
PRELUDE = ["awaiting_orchestrator", "awaiting_plan", "awaiting_roles", "roles_confirmed"]

# The work stages, in the only order they can sensibly run. A plan is a subset of
# this list; it never reorders it.
STAGE_ORDER = [
    "intake",
    "research",
    "solutioning",
    "review",
    "reconciliation",
    "presentation",
    "planning",
    "implementation",
    "verification",
    "deployment",
    "observability",
    "publication",
]

STAGE_LABEL = {
    "intake": "intake",
    "research": "research",
    "solutioning": "solution architecture",
    "review": "adversarial review",
    "reconciliation": "reconciliation",
    "presentation": "presentation",
    "planning": "development plan",
    "implementation": "implementation",
    "verification": "verification",
    "deployment": "deployment",
    "observability": "observability and monitoring",
    "publication": "publication",
}

# A gate state is inserted automatically before the stage it guards, and only
# when that stage is in the plan. You cannot plan your way past an approval.
STAGE_GATE = {
    "implementation": "awaiting_implementation_approval",
    "deployment": "awaiting_deployment_approval",
    "publication": "awaiting_publication_approval",
}

GATE_STATES = {gate: stage for stage, gate in STAGE_GATE.items()}

# Shorthand for the shapes that come up often. Free text is the normal way in —
# these exist so a shape you run every week does not need re-describing.
SHAPES = {
    "research": ["intake", "research"],
    "research-to-adr": ["intake", "research", "solutioning", "review", "reconciliation"],
    "review-only": ["intake", "review"],
    "presentation": ["intake", "presentation"],
    "delivery-plan": ["intake", "planning"],
    "build": ["intake", "implementation", "verification"],
    "pr-review": ["intake", "review", "verification"],
    "design-to-build": ["intake", "solutioning", "presentation", "planning", "implementation", "verification"],
    # A design panel is a normal run with a named shape. Several UI/UX designers
    # work the same solutioning stage independently; reconciliation is where the
    # disagreement is settled, and presentation is where the answer is shown.
    "design-panel": ["intake", "solutioning", "review", "reconciliation", "presentation"],
    "release": ["verification", "deployment", "observability"],
    "operate": ["intake", "observability"],
    "full": list(STAGE_ORDER),
}

# Which role a stage needs filled. An identity may hold several roles, so if you
# want the orchestrator to also write the delivery plan, assign it both.
STAGE_ROLES = {
    "intake": ["orchestrator"],
    "research": ["research"],
    "solutioning": ["solutioning"],
    "review": ["review"],
    "reconciliation": ["orchestrator"],
    "presentation": ["presentation"],
    "planning": ["deliveryPlanning"],
    "implementation": ["implementation"],
    "verification": ["testEngineering"],
    "deployment": ["releaseManagement"],
    "observability": ["observability"],
    "publication": ["orchestrator"],
}

# Specialist roles are offered only when their stage is in the plan. They may be
# assigned to any capable identity, assigned to the same identity as another
# role, or explicitly left empty. Subagents provide the specialist method; this
# registry decides which account is authorised to invoke them for this run.
OPTIONAL_ROLES = {
    "productManagement": {"intake", "research", "planning"},
    "uiUxDesign": {"solutioning", "presentation", "implementation", "verification"},
    "designSystem": {"solutioning", "implementation", "verification"},
    "prReview": {"review"},
    "standardsReview": {"review", "verification"},
    "securityReview": {"review", "verification"},
    "ciInvestigation": {"verification"},
    "microsoftContext": {"intake", "research"},
}

# What a stage normally feeds on — any one of these is enough. Advisory: fde says
# what is missing and then does what you asked. Reviewing raw research without an
# architecture in between is a real thing to want, not a mistake.
STAGE_PREREQ = {
    "research": ["intake"],
    "solutioning": ["research"],
    "review": ["solutioning", "research"],
    "reconciliation": ["review"],
    "presentation": ["reconciliation", "solutioning", "research"],
    "planning": ["reconciliation", "solutioning", "research"],
    "implementation": ["planning", "solutioning"],
    "verification": ["implementation"],
    "deployment": ["verification"],
    "observability": ["deployment", "implementation"],
    "publication": [],
}

STAGE_ARTIFACTS = {
    "intake": [],
    "research": [("research", "research-brief.md")],
    "solutioning": [("architecture", "architecture-options.md"), ("architecture", "adr.md")],
    "review": [("review", "review.md")],
    "reconciliation": [("review", "reconciliation.md")],
    "presentation": [("presentation", "solution-presentation.pptx")],
    "planning": [("delivery-plan", "development-plan.md"), ("delivery-plan", "jira-plan.json")],
    "implementation": [("implementation", "implementation-task.md")],
    "verification": [("implementation", "verification-report.md")],
    "deployment": [("deployment", "deployment-report.md")],
    "observability": [("observability", "observability-plan.md")],
    "publication": [(".", "publication-manifest.json")],
}

STAGE_DIR = {
    "intake": "research",
    "research": "research",
    "solutioning": "architecture",
    "review": "review",
    "reconciliation": "review",
    "presentation": "presentation",
    "planning": "delivery-plan",
    "implementation": "implementation",
    "verification": "implementation",
    "deployment": "deployment",
    "observability": "observability",
    "publication": "delivery-plan",
}

# Derived: which stages a role may act in. Built from STAGE_ROLES so the two can
# never drift apart.
ROLE_STAGES = {}
for _stage, _roles in STAGE_ROLES.items():
    for _r in _roles:
        ROLE_STAGES.setdefault(_r, set()).add(_stage)
for _r, _stages in OPTIONAL_ROLES.items():
    ROLE_STAGES.setdefault(_r, set()).update(_stages)

ALL_ROLES = list(STAGE_ROLES) and [
    "orchestrator", "productManagement", "research", "solutioning",
    "uiUxDesign", "designSystem", "review", "prReview", "standardsReview",
    "securityReview", "deliveryPlanning", "presentation", "implementation",
    "testEngineering", "ciInvestigation", "releaseManagement",
    "observability", "microsoftContext",
]

# Roles a run may assign to several identities at once. A design panel needs two
# or three designers on the same stage, so uiUxDesign joins research and review
# here; a record written when it was single-valued still reads, because
# Run.assignees() normalises a bare string into a one-element list.
MULTI_ROLES = {"research", "review", "uiUxDesign"}

PUBLICATION_TARGETS = (
    "jira", "confluence", "sharepoint", "bitbucket", "github", "deployment",
    "email", "teams",
)

ARTIFACT_DIRS = [
    "research", "architecture", "review", "presentation", "delivery-plan",
    "implementation", "deployment", "observability", "evidence", "learning",
    "design-panel",
]

# Output hygiene deliberately excludes provenance removal. These are the only
# invisible characters FDE removes automatically from text artifacts. ZWJ/ZWNJ,
# variation selectors and ordinary bidi isolates are preserved because they can
# carry real language or emoji semantics.
UNSAFE_INVISIBLE_CODEPOINTS = {
    0x00AD: "soft-hyphen",
    0x200B: "zero-width-space",
    0x202A: "left-to-right-embedding",
    0x202B: "right-to-left-embedding",
    0x202C: "pop-directional-formatting",
    0x202D: "left-to-right-override",
    0x202E: "right-to-left-override",
    0x2060: "word-joiner",
    0xFEFF: "zero-width-no-break-space",
}

TEXT_ARTIFACT_SUFFIXES = {
    ".css", ".csv", ".htm", ".html", ".ini", ".js", ".json", ".md",
    ".py", ".sh", ".svg", ".toml", ".ts", ".tsv", ".txt", ".xml",
    ".yaml", ".yml",
}

OOXML_ARTIFACT_SUFFIXES = {".docx", ".pptx", ".xlsx"}

HYGIENE_REPORT_PREFIX = "output-hygiene-"


def expand_stages(stages):
    """A plan, in canonical order, with its approval gates inserted."""
    chosen = [s for s in STAGE_ORDER if s in set(stages)]
    out = []
    for s in chosen:
        if s in STAGE_GATE:
            out.append(STAGE_GATE[s])
        out.append(s)
    return chosen, out


def state_sequence(stages):
    _chosen, expanded = expand_stages(stages)
    return PRELUDE + expanded + ["complete"]


def transitions_for(stages):
    seq = state_sequence(stages)
    tr = {a: {b} for a, b in zip(seq, seq[1:])}
    tr.setdefault("complete", set())
    for s in seq:
        tr[s].add("blocked")
    tr["blocked"] = set(seq)
    return tr


def roles_needed(stages):
    """Which roles this plan actually requires, in the canonical display order."""
    need = {"orchestrator"}
    for s in stages:
        need.update(STAGE_ROLES.get(s, []))
    for r, when in OPTIONAL_ROLES.items():
        if when & set(stages):
            need.add(r)
    return [r for r in ALL_ROLES if r in need]


def prereq_warnings(run_stages):
    """Advisory only. Names what a stage normally feeds on when the plan omits it."""
    have = set(run_stages)
    out = []
    for s in run_stages:
        feeders = STAGE_PREREQ.get(s, [])
        if feeders and not (have & set(feeders)):
            out.append(f"{STAGE_LABEL[s]} normally follows "
                       f"{' or '.join(STAGE_LABEL[f] for f in feeders)}, which this plan skips — "
                       f"supply that input yourself or expect thin output")
    return out

# ------------------------------------------------------------------ plumbing --


class Fail(SystemExit):
    def __init__(self, msg, code=1):
        super().__init__(code)
        self.msg = msg


def die(msg, code=1):
    sys.stdout.flush()
    print(f"fde: {msg}", file=sys.stderr)
    raise SystemExit(code)


def now():
    return _dt.datetime.now(_dt.timezone.utc).astimezone()


def iso(ts=None):
    return (ts or now()).isoformat(timespec="seconds")


def parse_iso(s):
    return _dt.datetime.fromisoformat(s)


def slug(s, n=40):
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", (s or "").lower())).strip("-")[:n] or "run"


def write_atomic(path: pathlib.Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def write_bytes_atomic(path: pathlib.Path, data: bytes):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_bytes(data)
    if path.exists():
        os.chmod(tmp, path.stat().st_mode & 0o777)
    os.replace(tmp, path)


def write_json(path: pathlib.Path, data):
    write_atomic(path, json.dumps(data, indent=2) + "\n")


def read_json(path: pathlib.Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def append_jsonl(path: pathlib.Path, record):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, sort_keys=True) + "\n")
        fh.flush()
        os.fsync(fh.fileno())


def read_jsonl(path: pathlib.Path):
    out = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line:
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(record, dict):
                    out.append(record)
    except FileNotFoundError:
        pass
    return out


def sha256_file(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


# -------------------------------------------------------------------- agents --


def load_agents():
    data = read_json(AGENTS_FILE)
    if data is None:
        die(f"no agent registry at {AGENTS_FILE} — is the toolkit installed?", 2)
    if "agents" not in data:
        die(f"{AGENTS_FILE} has no 'agents' key", 2)
    for aid, a in data["agents"].items():
        for banned in ("role", "defaultRole", "preferred", "default"):
            if banned in a:
                die(f"{AGENTS_FILE}: agent '{aid}' declares '{banned}'. "
                    "Identities must not carry roles — roles are assigned per run.", 2)
    return data


def agent_label(agents, aid):
    a = agents["agents"].get(aid)
    return a.get("label", aid) if a else aid


def agent_available(agents, aid):
    """(available: bool, detail: str). Availability is about the local surface,
    not about whether the identity is any good at the job."""
    a = agents["agents"].get(aid)
    if not a:
        return False, "unknown identity"
    kind = a.get("kind")
    if kind == "claude":
        p = a.get("profile", "")
        d = PROFILES_DIR / p
        if not d.is_dir():
            return False, f"no profile dir at {d} — run claude-profile-new {p}"
        return True, f"profile {p}"
    if kind == "codex":
        return (True, "codex CLI") if shutil.which("codex") else (False, "codex CLI not installed")
    if kind == "gemini":
        return (True, "gemini CLI") if shutil.which("gemini") else (False, "gemini CLI not installed")
    if kind == "copilot-studio":
        if directline_secret(quiet=True) or os.environ.get("COPILOT_TOKEN_ENDPOINT"):
            return True, "Direct Line configured"
        return False, "no Direct Line secret or token endpoint"
    return False, f"unknown kind '{kind}'"


def directline_secret(quiet=False):
    """Keychain first, environment second. Never printed by anything that logs."""
    if shutil.which("security"):
        try:
            r = subprocess.run(
                ["security", "find-generic-password", "-a", os.environ.get("USER", ""),
                 "-s", "fde-copilot-directline", "-w"],
                capture_output=True, text=True, timeout=10)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    return os.environ.get("COPILOT_DIRECTLINE_SECRET", "").strip()


# ----------------------------------------------------------------- run store --


class Run:
    def __init__(self, run_id):
        self.id = run_id
        # A run id names a directory; it is never a path. Anything with a
        # separator, and any symlink standing in for a run, is refused before a
        # single file is read: a run that resolves elsewhere would make every
        # path check below meaningless.
        if not run_id or "/" in run_id or "\\" in run_id or run_id in (".", ".."):
            die(f"invalid run id: {run_id!r}", 2)
        self.dir = RUNS / run_id
        if self.dir.is_symlink():
            die(f"run {run_id} is a symlink; refusing to read through it", 4)
        if not self.dir.is_dir():
            die(f"no such run: {run_id}\n       try: fde list", 4)
        try:
            if self.dir.resolve(strict=True).parent != RUNS.resolve(strict=True):
                die(f"run {run_id} resolves outside {RUNS}; refusing", 4)
        except OSError as exc:
            die(f"run {run_id} could not be resolved: {exc}", 4)

    # -- paths
    @property
    def manifest_path(self): return self.dir / "manifest.json"
    @property
    def roles_path(self): return self.dir / "roles.json"
    @property
    def plan_path(self): return self.dir / "plan.json"
    @property
    def events_path(self): return self.dir / "events.jsonl"
    @property
    def approvals_path(self): return self.dir / "approvals.jsonl"
    @property
    def checkpoints_path(self): return self.dir / "checkpoints.jsonl"
    @property
    def tasks_dir(self): return self.dir / "tasks"
    @property
    def artifacts_dir(self): return self.dir / "artifacts"

    # -- manifest
    def manifest(self):
        m = read_json(self.manifest_path)
        if m is None:
            die(f"run {self.id} has no manifest.json", 4)
        return m

    def save_manifest(self, m):
        m["updatedAt"] = iso()
        write_json(self.manifest_path, m)

    @property
    def state(self):
        return self.manifest().get("state", "awaiting_roles")

    # -- log
    def event(self, kind, **fields):
        append_jsonl(self.events_path, {"at": iso(), "event": kind, "runId": self.id, **fields})

    def events(self):
        return read_jsonl(self.events_path)

    def approvals(self):
        return read_jsonl(self.approvals_path)

    def checkpoints(self):
        return read_jsonl(self.checkpoints_path)

    def latest_checkpoint(self, stage):
        matches = [c for c in self.checkpoints() if c.get("stage") == stage]
        return matches[-1] if matches else None

    def require_passing_checkpoint(self, stage, artifacts):
        missing = [str(p.relative_to(self.dir)) for p in artifacts if not p.is_file()]
        if missing:
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: required evidence "
                f"artifact(s) missing: {', '.join(missing)}", 9)
        checkpoint = self.latest_checkpoint(stage)
        if not checkpoint:
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: no checkpoint is "
                f"recorded.\n       run: fde checkpoint {self.id} --stage {stage} "
                f"--status pass --evidence <file-or-note>", 9)
        if checkpoint.get("status") != "pass":
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: latest checkpoint "
                f"is '{checkpoint.get('status')}', not 'pass'.", 9)
        if not checkpoint.get("evidence"):
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: the passing "
                f"checkpoint contains no evidence.", 9)

    def write_requirement(self, text):
        m = self.manifest()
        write_atomic(self.dir / "requirement.md", (
            f"# Requirement\n\n"
            f"- captured: {iso()}\n"
            f"- jira: {m.get('jiraKey') or '(none given)'}\n"
            f"- source: given by the user; nothing has been fetched\n\n"
            f"---\n\n{text}\n"))
        m["requirement"] = text[:400]
        km = re.match(r"^([A-Z][A-Z0-9]+-\d+)\b", text.strip())
        if km and not m.get("jiraKey"):
            m["jiraKey"] = km.group(1)
        self.save_manifest(m)

    def orchestrator(self):
        who = self.assignees("orchestrator")
        return who[0] if who else None

    def guard_orchestrator(self, what):
        if not self.orchestrator():
            die(f"run {self.id} has no orchestrator yet, so {what} is not permitted.\n"
                f"       run: fde orchestrator {self.id} <identity>", 6)

    # -- plan
    def plan(self):
        return read_json(self.plan_path)

    def planned(self):
        p = self.plan()
        return bool(p and (p.get("confirmedAt") or p.get("proposedAt")))

    def stages(self):
        """This run's stages. A run created before plans existed is a full one."""
        p = self.plan()
        if p and p.get("stages"):
            return [s for s in STAGE_ORDER if s in set(p["stages"])]
        return list(STAGE_ORDER)

    def skipped(self):
        return [s for s in STAGE_ORDER if s not in set(self.stages())]

    def sequence(self):
        return state_sequence(self.stages())

    def roles_needed(self):
        return roles_needed(self.stages())

    def plan_line(self):
        return "  →  ".join(STAGE_LABEL[s] for s in self.stages())

    # -- roles
    def roles(self):
        return read_json(self.roles_path)

    def roles_confirmed(self):
        s = self.state
        if s == "blocked":
            s = self.manifest().get("blockedFrom") or "awaiting_orchestrator"
        if s in ("awaiting_orchestrator", "awaiting_plan", "awaiting_roles"):
            return False
        plan = self.plan() or {}
        if plan.get("approvalRequired") and not plan.get("executionApprovedAt"):
            return False
        return True

    def assignees(self, role):
        r = self.roles() or {}
        v = (r.get("assignments") or {}).get(role)
        if v in (None, "none", ""):
            return []
        return list(v) if isinstance(v, list) else [v]

    def role_of(self, agent_id, stage=None):
        """Which assigned role, if any, lets this identity act (in this stage)."""
        r = self.roles() or {}
        hits = []
        for role in (r.get("assignments") or {}):
            if agent_id in self.assignees(role):
                if stage is None or stage in ROLE_STAGES.get(role, set()):
                    hits.append(role)
        return hits

    # -- state
    def set_state(self, new, reason=""):
        if new not in STATES:
            die(f"unknown state '{new}'. Known: {', '.join(STATES)}", 2)
        m = self.manifest()
        old = m.get("state")
        if new == old:
            return old
        if old == "verification" and new == "awaiting_deployment_approval":
            self.require_passing_checkpoint("verification", [
                self.artifacts_dir / "implementation" / "verification-report.md",
            ])
        if old == "observability" and new in ("awaiting_publication_approval", "complete"):
            self.require_passing_checkpoint("observability", [
                self.artifacts_dir / "observability" / "observability-plan.md",
            ])
        if old in GATE_STATES and new == GATE_STATES[old]:
            self.check_gate(old, new)
        if new not in transitions_for(self.stages()).get(old, set()):
            nxt = self.next_state(old)
            hint = f" Next in this run's plan is '{nxt}'." if nxt else ""
            die(f"illegal transition {old} -> {new}.{hint}\n"
                f"       This run's plan: {self.plan_line()}", 5)
        if new in ("publication", "complete"):
            report_path, report = run_output_hygiene(
                self, apply=True, trigger=f"transition:{old}->{new}")
            print(f"hygiene {report['summary']['files']} artifact(s), "
                  f"{report['summary']['changedFiles']} changed")
            print(f"evidence {report_path.relative_to(self.dir)}")
        if new == "blocked":
            m["blockedFrom"] = old
        if old == "blocked":
            m.pop("blockedFrom", None)
        m["state"] = new
        self.save_manifest(m)
        self.event("state", **{"from": old, "to": new, "reason": reason})
        return old

    def check_gate(self, gate, stage):
        """Leaving an approval gate requires the approval that gate exists for."""
        apps = approval_state(self)
        if gate == "awaiting_implementation_approval":
            live = [a for a in apps.values()
                    if a["type"] == "codex-approval"
                    and approval_status(a) in ("valid", "consumed")]
            if live:
                return
            if "chatgpt_codex" in self.assignees("implementation"):
                die(f"run {self.id} cannot enter implementation: Codex holds that role "
                    f"and no write approval has been granted.\n"
                    f"       run: fde approve-codex {self.id} implementation "
                    f"--task-file <file> --repo <path>", 7)
            # A Claude identity implements inside a session you are sitting in, so
            # the approval is you, in that session, turn by turn. Say so out loud
            # rather than pretending a gate was cleared.
            self.event("approval.implementation.not-required",
                       reason="implementer is not Codex; work happens interactively "
                              "under the user's own supervision")
            return
        if gate == "awaiting_deployment_approval":
            live = [a for a in apps.values()
                    if a["type"] == "publication-approval"
                    and a.get("target") == "deployment"
                    and approval_status(a) in ("valid", "consumed")]
            if not live:
                die(f"run {self.id} cannot deploy: no deployment has been approved.\n"
                    f"       run: fde approve-publish {self.id} deployment "
                    f"--summary '<environment and release>'", 7)
            return
        if gate == "awaiting_publication_approval":
            live = [a for a in apps.values()
                    if a["type"] == "publication-approval"
                    and a.get("target") != "deployment"
                    and approval_status(a) in ("valid", "consumed")]
            if not live:
                die(f"run {self.id} cannot publish: nothing has been approved for "
                    f"publication.\n"
                    f"       run: fde approve-publish {self.id} "
                    f"<jira|confluence|sharepoint|bitbucket|email|teams>", 7)

    def next_state(self, current=None):
        seq = self.sequence()
        cur = current or self.state
        if cur == "blocked":
            cur = self.manifest().get("blockedFrom") or seq[0]
        try:
            return seq[seq.index(cur) + 1]
        except (ValueError, IndexError):
            return None

    def guard_plan(self, what):
        if not self.planned():
            die(f"run {self.id} has no confirmed plan, so {what} is not permitted yet.\n"
                f"       run: fde plan {self.id} --stages <stages>   (or --shape <name>)", 6)

    def guard_roles(self, what):
        if not self.roles_confirmed():
            die(f"run {self.id} is in state '{self.state}'. Roles are not confirmed, so "
                f"{what} is not permitted yet.\n       run: fde roles {self.id}", 6)


def _artifact_files(run: Run):
    """Yield regular in-scope artifacts without following symlinks."""
    if not run.artifacts_dir.is_dir():
        return
    for path in sorted(run.artifacts_dir.rglob("*")):
        rel = path.relative_to(run.artifacts_dir)
        if path.is_symlink():
            yield path, rel, "symlink"
        elif path.is_file():
            if rel.parent == pathlib.Path("evidence") and rel.name.startswith(HYGIENE_REPORT_PREFIX):
                continue
            yield path, rel, "file"


def _sanitize_text_artifact(data: bytes):
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return data, [], ["not-utf8; left unchanged"]

    counts = {}
    out = []
    for ch in text:
        cp = ord(ch)
        label = UNSAFE_INVISIBLE_CODEPOINTS.get(cp)
        if label is None and 0xE0000 <= cp <= 0xE007F:
            label = "unicode-tag-character"
        if label:
            counts[label] = counts.get(label, 0) + 1
            continue
        out.append(ch)
    cleaned = "".join(out)

    redactions = 0
    homes = {str(HOME)}
    user_profile = os.environ.get("USERPROFILE", "").strip()
    if user_profile:
        homes.add(user_profile.rstrip("/\\"))
    for home in sorted((h for h in homes if h and h not in ("/", "\\")), key=len, reverse=True):
        for sep in ("/", "\\"):
            needle = home.rstrip("/\\") + sep
            redactions += cleaned.count(needle)
            cleaned = cleaned.replace(needle, "~" + sep)

    changes = [f"removed {count} {label}" for label, count in sorted(counts.items())]
    if redactions:
        changes.append(f"redacted {redactions} home-directory path reference(s)")
    return cleaned.encode("utf-8"), changes, []


def _xml_remove_elements(data: bytes, names):
    changes = []
    for name, label in names:
        tag = re.escape(name.encode("ascii"))
        pattern = re.compile(
            rb"<(?:(?:[A-Za-z_][\w.-]*):)?" + tag +
            rb"\b[^>]*(?:/>|>.*?</(?:(?:[A-Za-z_][\w.-]*):)?" + tag + rb"\s*>)",
            re.DOTALL,
        )
        data, count = pattern.subn(b"", data)
        if count:
            changes.append(f"removed {count} {label} Office propert{'y' if count == 1 else 'ies'}")
    return data, changes


def _xml_remove_path_template(data: bytes):
    pattern = re.compile(
        rb"<(?:(?:[A-Za-z_][\w.-]*):)?Template\b[^>]*>(?P<value>.*?)"
        rb"</(?:(?:[A-Za-z_][\w.-]*):)?Template\s*>",
        re.DOTALL,
    )
    count = 0

    def remove_if_local(match):
        nonlocal count
        value = html.unescape(match.group("value").decode("utf-8", errors="ignore")).strip()
        local = (value.startswith(("/", "~", "file:")) or
                 bool(re.match(r"^[A-Za-z]:[\\/]", value)) or
                 str(HOME) in value)
        if local:
            count += 1
            return b""
        return match.group(0)

    data = pattern.sub(remove_if_local, data)
    changes = ["removed local-path Office template property"] if count else []
    return data, changes


def _sanitize_ooxml_artifact(data: bytes):
    changes = []
    observations = []
    source = io.BytesIO(data)
    target = io.BytesIO()
    changed_parts = {}
    try:
        with zipfile.ZipFile(source, "r") as zin:
            infos = zin.infolist()
            if sum(i.file_size for i in infos) > 200 * 1024 * 1024:
                return data, [], ["expanded Office document exceeds 200 MiB; left unchanged"]
            lowered_names = [i.filename.lower() for i in infos]
            if any(name.startswith("_xmlsignatures/") or "c2pa" in name or
                   "jumbf" in name for name in lowered_names):
                return data, [], [
                    "Office signature/provenance part detected; package left unchanged"
                ]
            for info in infos:
                payload = zin.read(info.filename)
                part_changes = []
                if info.filename == "docProps/core.xml":
                    payload, part_changes = _xml_remove_elements(payload, [
                        ("lastModifiedBy", "last-modified-by"),
                    ])
                elif info.filename == "docProps/app.xml":
                    payload, part_changes = _xml_remove_elements(payload, [
                        ("Manager", "manager"),
                        ("HyperlinkBase", "hyperlink-base"),
                    ])
                    payload, template_changes = _xml_remove_path_template(payload)
                    part_changes.extend(template_changes)
                elif info.filename == "docProps/custom.xml":
                    observations.append("custom Office properties preserved for provenance")
                if part_changes:
                    changed_parts[info.filename] = payload
                    changes.extend(part_changes)
            if not changed_parts:
                return data, [], observations
            with zipfile.ZipFile(target, "w") as zout:
                for info in infos:
                    payload = changed_parts.get(info.filename)
                    if payload is None:
                        payload = zin.read(info.filename)
                    zout.writestr(info, payload)
    except (OSError, zipfile.BadZipFile, RuntimeError) as exc:
        raise ValueError(f"invalid Office package: {exc}") from exc
    return target.getvalue(), changes, observations


def _inspect_private_binary_metadata(path: pathlib.Path):
    """Read-only metadata inspection. Never rewrites binary artifacts."""
    if not shutil.which("exiftool"):
        return []
    try:
        proc = subprocess.run([
            "exiftool", "-json", "-GPS*", "-CameraOwnerName", "-BodySerialNumber",
            "-LensSerialNumber", "-SerialNumber", "-HostComputer", str(path),
        ], capture_output=True, text=True, timeout=15)
        if proc.returncode != 0:
            return ["binary privacy metadata inspection failed; file left unchanged"]
        rows = json.loads(proc.stdout or "[]")
        fields = sorted(k for k, value in (rows[0] if rows else {}).items()
                        if k != "SourceFile" and value not in (None, "", [], {}))
        if fields:
            return ["privacy metadata detected but preserved to avoid invalidating provenance: " +
                    ", ".join(fields)]
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return ["binary privacy metadata inspection failed; file left unchanged"]
    return []


def _service_is_allowed(url):
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.hostname:
        return False, "service URL must be http(s)"
    if parsed.username or parsed.password:
        return False, "service credentials must use WATERMARKS_SERVER_API_KEY, not the URL"
    loopback = parsed.hostname.lower() in ("localhost", "127.0.0.1", "::1")
    if not loopback and os.environ.get("FDE_ALLOW_REMOTE_HYGIENE_SERVICE") != "1":
        return False, "remote service refused; set FDE_ALLOW_REMOTE_HYGIENE_SERVICE=1 explicitly"
    return True, ""


def _inspect_with_provenance_service(files, service_url):
    """Call only the linked service's inspect endpoint; never its clean endpoint."""
    if not service_url:
        return {"status": "not-configured", "results": []}
    allowed, reason = _service_is_allowed(service_url)
    if not allowed:
        return {"status": "refused", "error": reason, "results": []}
    batch = []
    skipped = max(0, len(files) - 50)
    total_bytes = 0
    for path, rel in files[:50]:
        try:
            data = path.read_bytes()
        except OSError:
            skipped += 1
            continue
        if len(data) > 10 * 1024 * 1024 or total_bytes + len(data) > 20 * 1024 * 1024:
            skipped += 1
            continue
        batch.append({"file": base64.b64encode(data).decode("ascii"), "name": rel.as_posix()})
        total_bytes += len(data)
    if not batch:
        return {"status": "ok", "results": [], "skipped": skipped}
    body = json.dumps({"files": batch}).encode("utf-8")
    headers = {"Content-Type": "application/json"}
    api_key = os.environ.get("WATERMARKS_SERVER_API_KEY", "").strip()
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    request = urllib.request.Request(
        service_url.rstrip("/") + "/inspect/batch", data=body, headers=headers,
        method="POST")
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        return {"status": "unavailable", "error": str(exc), "results": [], "skipped": skipped}
    if not isinstance(payload, dict) or not isinstance(payload.get("results", []), list):
        return {"status": "unavailable", "error": "invalid service response",
                "results": [], "skipped": skipped}
    summaries = []
    for item in payload.get("results", []):
        summaries.append({
            "name": item.get("name"),
            "ok": bool(item.get("ok")),
            "kind": item.get("kind"),
            "suspicious": bool(item.get("suspicious")),
        })
    return {"status": "ok", "results": summaries, "skipped": skipped}


def run_output_hygiene(run: Run, *, apply=True, service_url=None, trigger="manual"):
    """Sanitize only FDE artifacts and produce tamper-evident run evidence."""
    run.guard_roles("running output hygiene")
    started = iso()
    records = []
    errors = []
    service_files = []
    changed_files = 0
    would_change_files = 0
    for path, rel, kind in _artifact_files(run):
        record = {"path": f"artifacts/{rel.as_posix()}"}
        if kind == "symlink":
            record.update({"status": "skipped", "observations": ["symlink not followed"]})
            records.append(record)
            continue
        try:
            before = path.read_bytes()
            record["sha256Before"] = sha256_bytes(before)
            suffix = path.suffix.lower()
            changes = []
            observations = []
            after = before
            if suffix in TEXT_ARTIFACT_SUFFIXES:
                after, changes, observations = _sanitize_text_artifact(before)
            elif suffix in OOXML_ARTIFACT_SUFFIXES:
                after, changes, observations = _sanitize_ooxml_artifact(before)
            else:
                observations.extend(_inspect_private_binary_metadata(path))
                observations.append("binary content and provenance metadata left unchanged")
            if changes:
                would_change_files += 1
            if changes and apply:
                write_bytes_atomic(path, after)
                changed_files += 1
            else:
                after = before
            record.update({
                "status": "changed" if changes and apply else ("would-change" if changes else "clean"),
                "sha256After": sha256_bytes(after),
                "changes": changes,
                "observations": observations,
            })
            records.append(record)
            service_files.append((path, rel))
        except (OSError, ValueError) as exc:
            message = f"{rel.as_posix()}: {exc}"
            errors.append(message)
            record.update({"status": "error", "error": str(exc)})
            records.append(record)

    service_url = service_url if service_url is not None else os.environ.get(
        "WATERMARKS_SERVICE_URL", "").strip()
    provenance_scan = _inspect_with_provenance_service(service_files, service_url)
    evidence_dir = run.artifacts_dir / "evidence"
    stamp = now().strftime("%Y%m%dT%H%M%S%z")
    report_path = evidence_dir / f"{HYGIENE_REPORT_PREFIX}{stamp}-{secrets.token_hex(3)}.json"
    report = {
        "type": "fde-output-hygiene",
        "version": 1,
        "runId": run.id,
        "at": started,
        "trigger": trigger,
        "mode": "apply" if apply else "check",
        "scope": "artifacts/ only; symlinks are never followed",
        "policy": {
            "preserve": [
                "C2PA and content credentials", "creator/copyright/ownership metadata",
                "visible watermarks", "unknown binary metadata",
            ],
            "remove": [
                "allowlisted unsafe invisible Unicode", "absolute home-directory prefixes",
                "Office last-modified-by, manager, hyperlink-base and local template paths",
            ],
            "externalService": "inspect-only; /clean is never called",
        },
        "summary": {
            "files": len(records), "changedFiles": changed_files,
            "wouldChangeFiles": would_change_files,
            "errors": len(errors), "provenanceService": provenance_scan.get("status"),
        },
        "files": records,
        "provenanceScan": provenance_scan,
        "errors": errors,
    }
    write_json(report_path, report)
    report_rel = str(report_path.relative_to(run.dir))
    report_hash = sha256_file(report_path)
    event_kind = "output-hygiene.failed" if errors else "output-hygiene.completed"
    run.event(event_kind, trigger=trigger, mode=report["mode"], report=report_rel,
              reportSha256=report_hash, files=len(records), changedFiles=changed_files,
              wouldChangeFiles=would_change_files,
              errors=len(errors), provenancePreserved=True,
              provenanceService=provenance_scan.get("status"))
    if errors:
        die(f"run {run.id} output hygiene failed for {len(errors)} artifact(s).\n"
            f"       evidence: {report_rel}", 10)
    return report_path, report


def new_run(requirement: str = "", project_id=None, model=None, effort=None) -> Run:
    key = (requirement or "").strip()
    m = re.match(r"^([A-Z][A-Z0-9]+-\d+)\b", key)
    jira_key = m.group(1) if m else None
    stem = f"{now():%Y%m%d}-{slug(jira_key or key or 'run')}-{secrets.token_hex(2)}"
    d = RUNS / stem
    if d.exists():
        die(f"run directory already exists: {d}", 1)
    for sub in ["tasks", "inputs"] + [f"artifacts/{a}" for a in ARTIFACT_DIRS]:
        (d / sub).mkdir(parents=True, exist_ok=True)
    write_json(d / "manifest.json", {
        "runId": stem,
        "createdAt": iso(),
        "updatedAt": iso(),
        "state": "awaiting_orchestrator",
        "jiraKey": jira_key,
        "requirement": key[:400],
        "projectId": project_id,
        # Session choices are durable run data.  fde-start reads them again on
        # every resume, so the GUI never has to remember (or silently change)
        # how an orchestrator conversation was launched.
        "sessionConfig": {
            "model": model or "default",
            "effort": effort or "auto",
        },
        "toolkit": "fde-core",
    })
    r = Run(stem)
    if key:
        r.write_requirement(key)
    r.event("run.created", jiraKey=jira_key, hasRequirement=bool(key),
            projectId=project_id, model=model or "default", effort=effort or "auto")
    if project_id:
        project_event(project_id, "run.created", runId=stem)
    r.event("note", note="Created in awaiting_orchestrator. Choosing an orchestrator and "
                         "scoping the work read nothing; no connector, repository or "
                         "client-context access is permitted until roles are confirmed.")
    return r


def list_runs():
    if not RUNS.is_dir():
        return []
    out = []
    for d in sorted(RUNS.iterdir()):
        if d.is_dir() and not d.is_symlink() and (d / "manifest.json").exists():
            out.append(read_json(d / "manifest.json", {}))
    return out


# ------------------------------------------------------------- machine views --

# The GUI and any other machine reader consume these. Human output stays exactly
# as it was: JSON is an addition, never a replacement.


def emit_json(payload):
    """JSON mode writes JSON to stdout and nothing else. Diagnostics go to stderr."""
    json.dump(payload, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


def read_jsonl_report(path: pathlib.Path):
    """Every record, plus every line that could not be parsed.

    A ledger is append-only and may be read while it is being written, so its
    last line can be half a record. That line is reported, never silently
    dropped and never repaired."""
    records, malformed = [], []
    try:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return records, malformed
    except OSError as exc:
        return records, [{"line": 0, "error": str(exc), "raw": ""}]
    for n, line in enumerate(raw.splitlines(), 1):
        text = line.strip()
        if not text:
            continue
        try:
            record = json.loads(text)
        except json.JSONDecodeError as exc:
            malformed.append({"line": n, "error": str(exc), "raw": text[:500]})
            continue
        # Valid JSON is not the same as a usable record. A bare string, number
        # or list is reported as malformed rather than handed to a reader that
        # will call .get() on it.
        if not isinstance(record, dict):
            malformed.append({"line": n, "error": "record is not a JSON object",
                              "raw": text[:500]})
            continue
        records.append(record)
    return records, malformed


# ------------------------------------------------------------------ projects --

PROJECT_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,79}$")


def project_dir(project_id):
    return PROJECTS / project_id


def valid_project_id(project_id):
    return bool(project_id) and bool(PROJECT_ID_RE.match(project_id))


def load_project(project_id):
    """A project, or a nonzero exit. Never a half-answer."""
    if not valid_project_id(project_id):
        die(f"invalid project id '{project_id}'\n       try: fde projects", 2)
    path = project_dir(project_id) / "project.json"
    if not path.is_file():
        die(f"no such project: {project_id}\n       try: fde projects", 4)
    doc = read_json(path)
    if not isinstance(doc, dict) or not doc.get("projectId"):
        die(f"project {project_id} has a malformed project.json at {path}", 4)
    # The id inside the record is used to build paths later. A record that names
    # a different project — or a path — does not get to redirect that.
    if doc.get("projectId") != project_id:
        die(f"project {project_id} has a record naming "
            f"'{doc.get('projectId')}'; refusing to act on it", 4)
    return doc


def project_event(project_id, kind, **fields):
    append_jsonl(project_dir(project_id) / "events.jsonl",
                 {"at": iso(), "event": kind, "projectId": project_id, **fields})


def resolve_repo_paths(values):
    """Absolute, symlink-resolved, existing directories. Repositories are read
    about, never created, cloned, modified or deleted by this controller."""
    out = []
    for raw in values or []:
        candidate = pathlib.Path(raw).expanduser()
        try:
            resolved = candidate.resolve(strict=True)
        except (OSError, RuntimeError):
            die(f"repository path does not exist: {raw}", 2)
        if not resolved.is_dir():
            die(f"repository path is not a directory: {resolved}", 2)
        text = str(resolved)
        if text not in out:
            out.append(text)
    return out


def new_project(name, description="", repos=()):
    name = (name or "").strip()
    if not name:
        die("a project needs a name", 2)
    if len(name) > 200:
        die("project name is too long (200 characters max)", 2)
    repo_paths = resolve_repo_paths(repos)
    PROJECTS.mkdir(parents=True, exist_ok=True)
    for _ in range(8):
        project_id = f"{slug(name, 40)}-{secrets.token_hex(2)}"
        directory = project_dir(project_id)
        if not directory.exists():
            break
    else:
        die("could not allocate a unique project id", 1)
    stamp = iso()
    doc = {
        "schemaVersion": SCHEMA_VERSION,
        "projectId": project_id,
        "name": name,
        "description": (description or "").strip(),
        "repoPaths": repo_paths,
        "createdAt": stamp,
        "updatedAt": stamp,
    }
    directory.mkdir(parents=True, exist_ok=True)
    write_json(directory / "project.json", doc)
    project_event(project_id, "project.created", name=name, repoPaths=repo_paths)
    return doc


def list_projects():
    """(projects, warnings). A malformed project is named, not hidden."""
    projects, warnings = [], []
    if not PROJECTS.is_dir():
        return projects, warnings
    for directory in sorted(PROJECTS.iterdir()):
        if not directory.is_dir() or directory.is_symlink():
            continue
        path = directory / "project.json"
        if not path.is_file():
            continue
        doc = read_json(path)
        if isinstance(doc, dict) and doc.get("projectId"):
            projects.append(doc)
        else:
            warnings.append(f"{path}: malformed project.json; project not listed")
    return projects, warnings


def run_dirs():
    if not RUNS.is_dir():
        return []
    return [d for d in sorted(RUNS.iterdir()) if d.is_dir() and not d.is_symlink()]


def runs_index():
    """(entries, warnings) where an entry is (run_dir, manifest)."""
    entries, warnings = [], []
    for directory in run_dirs():
        path = directory / "manifest.json"
        if not path.is_file():
            continue
        manifest = read_json(path)
        if isinstance(manifest, dict):
            entries.append((directory, manifest))
        else:
            warnings.append(f"{path}: malformed manifest.json; run listed without detail")
            entries.append((directory, {"runId": directory.name, "state": None,
                                        "malformed": True}))
    return entries, warnings


def project_summary(doc, run_manifests):
    stamps = [m.get("updatedAt") for m in run_manifests if m.get("updatedAt")]
    stamps.append(doc.get("updatedAt"))
    return {
        "schemaVersion": doc.get("schemaVersion", SCHEMA_VERSION),
        "projectId": doc.get("projectId"),
        "name": doc.get("name"),
        "description": doc.get("description") or "",
        "repoPaths": list(doc.get("repoPaths") or []),
        "createdAt": doc.get("createdAt"),
        "updatedAt": doc.get("updatedAt"),
        "runCount": len(run_manifests),
        "lastActivityAt": max([s for s in stamps if s], default=None),
    }


def cmd_projects(args):
    projects, warnings = list_projects()
    entries, run_warnings = runs_index()
    warnings += run_warnings
    grouped = {}
    for _directory, manifest in entries:
        grouped.setdefault(manifest.get("projectId") or None, []).append(manifest)

    if getattr(args, "json", False):
        for warning in warnings:
            print(f"fde: {warning}", file=sys.stderr)
        return emit_json({
            "schemaVersion": SCHEMA_VERSION,
            "projects": [project_summary(p, grouped.get(p.get("projectId"), []))
                         for p in projects],
            "unassignedRunCount": len(grouped.get(None, [])),
            "warnings": warnings,
        })

    if not projects:
        print('no projects yet — fde project create --name "<name>"')
    else:
        width = max(len(p.get("projectId") or "") for p in projects)
        for p in projects:
            runs = grouped.get(p.get("projectId"), [])
            print(f"  {(p.get('projectId') or '?'):<{width}}  {(p.get('name') or '?')[:38]:<38} "
                  f"{len(runs):>3} run(s)  {len(p.get('repoPaths') or []):>2} repo(s)")
    unassigned = len(grouped.get(None, []))
    if unassigned:
        print(f"\n  {unassigned} run(s) belong to no project (unassigned)")
    for warning in warnings:
        print(f"  warning: {warning}")
    return 0


def cmd_project_create(args):
    doc = new_project(args.name, args.description or "", args.repo or [])
    if getattr(args, "json", False):
        return emit_json({"schemaVersion": SCHEMA_VERSION, "project": doc})
    print(f"project  {doc['projectId']}")
    print(f"name     {doc['name']}")
    if doc["description"]:
        print(f"about    {doc['description']}")
    for repo in doc["repoPaths"]:
        print(f"repo     {repo}")
    print(f"\nnext     fde start \"<what you want done>\" --project {doc['projectId']}")
    return 0


def cmd_project_update(args):
    doc = load_project(args.project_id)
    changed = {}
    if args.name is not None:
        name = args.name.strip()
        if not name:
            die("a project needs a name", 2)
        if len(name) > 200:
            die("project name is too long (200 characters max)", 2)
        changed["name"] = name
    if args.description is not None:
        changed["description"] = args.description.strip()
    if args.repo:
        changed["repoPaths"] = resolve_repo_paths(args.repo)
    if not changed:
        die("nothing to update — give --name, --description or --repo", 2)
    doc.update(changed)
    doc["schemaVersion"] = SCHEMA_VERSION
    doc["updatedAt"] = iso()
    write_json(project_dir(doc["projectId"]) / "project.json", doc)
    project_event(doc["projectId"], "project.updated", changed=sorted(changed))
    if getattr(args, "json", False):
        return emit_json({"schemaVersion": SCHEMA_VERSION, "project": doc})
    print(f"project  {doc['projectId']}")
    print(f"updated  {', '.join(sorted(changed))}")
    return 0


def cmd_project_show(args):
    doc = load_project(args.project_id)
    agents = load_agents()
    entries, warnings = runs_index()
    mine = [(d, m) for d, m in entries if m.get("projectId") == doc["projectId"]]
    events, malformed = read_jsonl_report(project_dir(doc["projectId"]) / "events.jsonl")

    if getattr(args, "json", False):
        return emit_json({
            "schemaVersion": SCHEMA_VERSION,
            "project": project_summary(doc, [m for _d, m in mine]),
            "runs": [run_summary(d, m, agents) for d, m in mine],
            "events": events,
            "malformedEvents": malformed,
            "warnings": warnings,
        })

    print(f"\nproject  {doc['projectId']}")
    print(f"name     {doc.get('name')}")
    print(f"about    {doc.get('description') or '(none)'}")
    print(f"created  {doc.get('createdAt')}")
    print("repos")
    for repo in doc.get("repoPaths") or []:
        print(f"  {repo}")
    if not doc.get("repoPaths"):
        print("  none recorded")
    print(f"\nruns ({len(mine)})")
    for _directory, manifest in mine:
        print(f"  {manifest.get('runId','?'):<38} {str(manifest.get('state')):<26} "
              f"{(manifest.get('requirement') or '(not stated)')[:40]}")
    if not mine:
        print("  none yet")
    for warning in warnings:
        print(f"  warning: {warning}")
    print()
    return 0


def project_chat_references(project_id):
    """Chat ids that still reference a project. Chat records are GUI-owned,
    so this is deliberately a read-only guard over top-level JSON records."""
    references = []
    if not CHATS.is_dir() or CHATS.is_symlink():
        return references
    for path in sorted(CHATS.glob("chat-*.json")):
        if not path.is_file() or path.is_symlink():
            continue
        try:
            record = read_json(path)
        except (OSError, ValueError, json.JSONDecodeError):
            continue
        if isinstance(record, dict) and record.get("projectId") == project_id:
            references.append(record.get("chatId") or path.stem)
    return references


def cmd_project_delete(args):
    """Remove only the project registry entry, and keep it in recoverable trash.

    Runs, chats and repositories are independent records. A project still used by
    a run or chat is refused instead of being cascaded or leaving dangling links.
    """
    project_id = args.project_id
    if args.confirm != project_id:
        die("project deletion requires --confirm with the exact project id", 2)
    directory = project_dir(project_id)
    if directory.is_symlink():
        die(f"project {project_id} is a symlink; refusing to delete it", 4)
    doc = load_project(project_id)
    try:
        if directory.resolve(strict=True).parent != PROJECTS.resolve(strict=True):
            die(f"project {project_id} resolves outside the project registry; refusing", 4)
    except (OSError, RuntimeError):
        die(f"project {project_id} cannot be resolved safely; refusing", 4)

    entries, _warnings = runs_index()
    run_ids = [m.get("runId") or d.name for d, m in entries
               if m.get("projectId") == project_id]
    chat_ids = project_chat_references(project_id)
    if run_ids or chat_ids:
        parts = []
        if run_ids:
            parts.append(f"{len(run_ids)} run(s)")
        if chat_ids:
            parts.append(f"{len(chat_ids)} chat(s)")
        die(f"project {project_id} is still referenced by {' and '.join(parts)}; "
            "delete those records or move them to another project first", 5)

    deleted_at = iso()
    project_event(project_id, "project.deleted", deletedAt=deleted_at)
    trash = PROJECTS / ".trash"
    if trash.is_symlink():
        die("project trash is a symlink; refusing to use it", 5)
    trash.mkdir(parents=True, exist_ok=True)
    stamp = _dt.datetime.now(_dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    target = trash / f"{project_id}-{stamp}-{secrets.token_hex(3)}"
    os.replace(directory, target)
    payload = {
        "schemaVersion": SCHEMA_VERSION,
        "deletedProject": {
            "projectId": project_id,
            "name": doc.get("name"),
            "deletedAt": deleted_at,
            "recoverable": True,
            "runCount": 0,
            "chatCount": 0,
        },
    }
    if getattr(args, "json", False):
        return emit_json(payload)
    print(f"deleted  {project_id}")
    print("kept     recoverable project metadata in the registry trash")
    print("repos    unchanged")
    return 0


# --------------------------------------------------------------- attachments --

ATTACHMENT_NAME_RE = re.compile(r"[^A-Za-z0-9._-]+")


def sanitize_attachment_name(raw, fallback="attachment"):
    """A display name that cannot be a path, a traversal or a shell word.

    Everything before the last separator is discarded, so a browser-supplied
    "../../etc/passwd" becomes "passwd" and never reaches the filesystem as a
    path at all."""
    name = (raw or "").replace("\\", "/").split("/")[-1]
    name = "".join(ch for ch in name if ch.isprintable())
    name = ATTACHMENT_NAME_RE.sub("-", name).strip("-. ")
    while ".." in name:
        name = name.replace("..", ".")
    if not name or name in (".", ".."):
        name = fallback
    if len(name) > 120:
        pure = pathlib.PurePosixPath(name)
        suffix = pure.suffix[:16]
        name = (pure.stem[: 120 - len(suffix)] or fallback) + suffix
    return name


def stored_attachment_name(safe_name):
    pure = pathlib.PurePosixPath(safe_name)
    return f"{pure.stem}-{secrets.token_hex(4)}{pure.suffix}"


def attachment_limit(explicit=None):
    """The size ceiling. FDE_MAX_ATTACHMENT_BYTES and --max-bytes may lower it;
    nothing raises it."""
    limit = MAX_ATTACHMENT_BYTES
    for candidate in (os.environ.get("FDE_MAX_ATTACHMENT_BYTES", "").strip(), explicit):
        if candidate in (None, ""):
            continue
        try:
            value = int(candidate)
        except (TypeError, ValueError):
            die("attachment size limit must be an integer number of bytes", 2)
        if value <= 0:
            die("attachment size limit must be a positive number of bytes", 2)
        limit = min(limit, value)
    return limit


NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


def _open_run_subdir(run: Run, parts):
    """A descriptor for <run>/<parts>, opened one component at a time and never
    through a symlink. Checking the path and then writing to it is not the same
    thing as writing to the directory you checked."""
    fd = os.open(str(run.dir), os.O_RDONLY | os.O_DIRECTORY | NOFOLLOW)
    try:
        for part in parts:
            try:
                os.mkdir(part, 0o700, dir_fd=fd)
            except FileExistsError:
                pass
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
    except OSError as exc:
        os.close(fd)
        die(f"attachment refused: {'/'.join(parts)} in run {run.id} is not a "
            f"directory this controller may write to: {exc}", 2)
    return fd


def _store_attachment(run: Run, stream, original_name, limit):
    """Copy bytes into the run under a generated name, hashing what is stored.

    The destination directory is held open as a descriptor, and the temporary
    file is created with O_EXCL|O_NOFOLLOW inside it, so neither the directory
    nor the file can be swapped for a link to somewhere else."""
    safe = sanitize_attachment_name(original_name)
    stored = stored_attachment_name(safe)
    tmp_name = f".{stored}.tmp{os.getpid()}"
    files_dir = run.dir / "inputs" / "files"
    dir_fd = _open_run_subdir(run, ("inputs", "files"))
    digest = hashlib.sha256()
    size = 0
    try:
        fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW,
                     0o600, dir_fd=dir_fd)
        with os.fdopen(fd, "wb") as out:
            while True:
                chunk = stream.read(1024 * 1024)
                if not chunk:
                    break
                size += len(chunk)
                if size > limit:
                    raise ValueError(
                        f"file is larger than the {limit} byte attachment limit")
                digest.update(chunk)
                out.write(chunk)
            out.flush()
            os.fsync(out.fileno())
        if os.replace in os.supports_dir_fd:
            os.replace(tmp_name, stored, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        else:
            os.replace(files_dir / tmp_name, files_dir / stored)
    except (OSError, ValueError) as exc:
        try:
            os.unlink(tmp_name, dir_fd=dir_fd)
        except OSError:
            pass
        die(f"attachment refused: {exc}", 2)
    finally:
        os.close(dir_fd)
    return files_dir / stored, stored, safe, size, digest.hexdigest()


def attachment_records(run: Run):
    return read_jsonl_report(run.dir / "inputs" / "attachments.jsonl")


def cmd_attach(args):
    run = Run(args.run_id)
    limit = attachment_limit(args.max_bytes)

    if args.stdin:
        if args.source_path:
            die("give a source path or --stdin, not both", 2)
        if not args.name:
            die("--stdin needs --name <original-name>", 2)
        source = "stdin"
        dest, stored, safe, size, digest = _store_attachment(
            run, sys.stdin.buffer, args.name, limit)
    else:
        if not args.source_path:
            die("give a file to attach, or --stdin --name <original-name>", 2)
        src = pathlib.Path(args.source_path).expanduser()
        # O_NOFOLLOW refuses the open outright if the final component is a
        # symlink, so there is no window between checking and reading.
        try:
            fd = os.open(str(src), os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        except OSError as exc:
            if getattr(exc, "errno", None) in (errno.ELOOP, errno.EMLINK):
                die(f"refusing to attach a symlink: {src}", 2)
            die(f"cannot read {src}: {exc}", 2)
        with os.fdopen(fd, "rb") as handle:
            info = os.fstat(fd)
            if stat.S_ISDIR(info.st_mode):
                die(f"refusing to attach a directory: {src}", 2)
            if not stat.S_ISREG(info.st_mode):
                die(f"refusing to attach a non-regular file (device, socket or "
                    f"fifo): {src}", 2)
            if info.st_size > limit:
                die(f"attachment refused: {src} is {info.st_size} bytes, over the "
                    f"{limit} byte limit", 2)
            source = str(src)
            dest, stored, safe, size, digest = _store_attachment(
                run, handle, args.name or src.name, limit)

    record = {
        "schemaVersion": SCHEMA_VERSION,
        "attachmentId": secrets.token_hex(8),
        "runId": run.id,
        "originalName": safe,
        "storedName": stored,
        "relativePath": f"inputs/files/{stored}",
        "mediaType": mimetypes.guess_type(safe)[0] or "application/octet-stream",
        "size": size,
        "sha256": digest,
        "attachedAt": iso(),
        "source": "stdin" if args.stdin else "file",
    }
    append_jsonl(run.dir / "inputs" / "attachments.jsonl", record)
    run.event("attachment.added", attachmentId=record["attachmentId"],
              originalName=safe, storedName=stored, relativePath=record["relativePath"],
              mediaType=record["mediaType"], size=size, sha256=digest,
              source=record["source"])

    if getattr(args, "json", False):
        return emit_json({"schemaVersion": SCHEMA_VERSION, "attachment": record})
    print(f"attachment  {record['attachmentId']}")
    print(f"name        {safe}")
    print(f"stored      {record['relativePath']}")
    print(f"type        {record['mediaType']}")
    print(f"size        {size} bytes")
    print(f"sha256      {digest}")
    if source != "stdin":
        print(f"copied from {source}  (the original was not moved or modified)")
    return 0


def cmd_attachments(args):
    run = Run(args.run_id)
    records, malformed = attachment_records(run)
    if getattr(args, "json", False):
        return emit_json({
            "schemaVersion": SCHEMA_VERSION,
            "runId": run.id,
            "attachments": records,
            "malformed": malformed,
        })
    if not records:
        print(f"run {run.id} has no attachments — fde attach {run.id} <file>")
    for record in records:
        present = (run.dir / record.get("relativePath", "")).is_file()
        print(f"  {record.get('attachmentId','?'):<16} "
              f"{(record.get('originalName') or '?')[:40]:<40} "
              f"{record.get('size', 0):>10} bytes  "
              f"{'present' if present else 'MISSING'}  "
              f"{(record.get('sha256') or '')[:12]}")
    for bad in malformed:
        print(f"  warning: attachments.jsonl line {bad['line']} is malformed and was "
              f"not interpreted")
    return 0


# ------------------------------------------------------------ derived views --

# An orchestrator session id is opaque. It is read, checked for shape, and
# handed back for `fde-start --resume`. Nothing here interprets it, and no
# transcript store is read.
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,200}$")


def orchestrator_view(roles, agents):
    assignments = (roles or {}).get("assignments") or {}
    who = assignments.get("orchestrator")
    if isinstance(who, list):
        who = who[0] if who else None
    if not who:
        return None
    agent = (agents or {}).get("agents", {}).get(who, {})
    return {"agentId": who, "label": agent.get("label", who),
            "kind": agent.get("kind") or "unknown"}


def session_view(run_dir: pathlib.Path, roles, agents):
    """Whether this run has a resumable orchestrator session, and nothing more."""
    view = {"provider": None, "profile": None, "sessionId": None,
            "resumable": False, "resumeReason": None}
    who = orchestrator_view(roles, agents)
    if not who:
        view["resumeReason"] = "This run has no orchestrator yet"
        return view
    agent = (agents or {}).get("agents", {}).get(who["agentId"], {})
    kind = who["kind"]
    view["provider"] = kind
    try:
        raw = (run_dir / "orchestrator-session-id").read_text(
            encoding="utf-8", errors="replace").strip()
    except OSError:
        raw = ""
    if kind == "claude":
        view["profile"] = agent.get("profile")
        view["resumable"] = True
        if raw and SESSION_ID_RE.match(raw):
            view["sessionId"] = raw
        elif raw:
            view["resumeReason"] = ("orchestrator-session-id is malformed; "
                                    "fde-start will record a new one")
        else:
            view["resumeReason"] = ("no session recorded yet; fde-start --resume "
                                    "will start one")
    elif kind == "codex":
        view["resumeReason"] = "Resume this run in its original Codex task"
    else:
        view["resumeReason"] = f"no interactive resume path for a '{kind}' orchestrator"
    return view


def run_summary(run_dir: pathlib.Path, manifest, agents):
    roles = read_json(run_dir / "roles.json")
    roles = roles if isinstance(roles, dict) else None
    plan = read_json(run_dir / "plan.json")
    plan = plan if isinstance(plan, dict) else None
    return {
        "runId": manifest.get("runId") or run_dir.name,
        "dir": str(run_dir),
        "state": manifest.get("state"),
        "blockedFrom": manifest.get("blockedFrom"),
        "projectId": manifest.get("projectId"),
        "requirement": manifest.get("requirement") or None,
        "jiraKey": manifest.get("jiraKey"),
        "createdAt": manifest.get("createdAt"),
        "updatedAt": manifest.get("updatedAt"),
        "orchestrator": orchestrator_view(roles, agents),
        "stages": list(plan.get("stages") or []) if plan else None,
        "planConfirmed": bool(plan and plan.get("confirmedAt")),
        "session": session_view(run_dir, roles, agents),
        "malformed": bool(manifest.get("malformed")),
    }


def event_page(records, total, limit, cursor):
    """The latest bounded page by default; an explicit cursor pages forward."""
    limit = max(1, min(int(limit or 50), 1000))
    if cursor is None:
        offset = max(0, total - limit)
    else:
        offset = max(0, min(int(cursor), total))
    items = records[offset:offset + limit]
    following = offset + len(items)
    return {
        "total": total,
        "offset": offset,
        "limit": limit,
        "returned": len(items),
        "nextCursor": following if following < total else None,
        "items": items,
    }


def status_payload(run: Run, agents, events_limit=50, events_cursor=None):
    manifest = run.manifest()
    warnings = []

    plan = run.plan()
    plan = plan if isinstance(plan, dict) else None
    roles = run.roles()
    roles = roles if isinstance(roles, dict) else None
    assignments = (roles or {}).get("assignments") or {}

    events, bad_events = read_jsonl_report(run.events_path)
    approvals_raw, bad_approvals = read_jsonl_report(run.approvals_path)
    checkpoints, bad_checkpoints = read_jsonl_report(run.checkpoints_path)
    for label, bad in (("events.jsonl", bad_events),
                       ("approvals.jsonl", bad_approvals),
                       ("checkpoints.jsonl", bad_checkpoints)):
        for entry in bad:
            warnings.append(f"{label} line {entry['line']} is malformed and was not "
                            f"interpreted")

    sequence = run.sequence()
    here = manifest.get("state")
    position = sequence.index(here) if here in sequence else -1
    timeline = []
    for stage in run.stages():
        if here in sequence and stage in sequence and sequence.index(stage) < position:
            stage_state = "done"
        elif stage == here:
            stage_state = "current"
        else:
            stage_state = "pending"
        timeline.append({"stage": stage, "label": STAGE_LABEL[stage],
                         "state": stage_state})

    role_rows = []
    for role, label, multi in ROLE_PROMPTS:
        if role not in run.roles_needed():
            continue
        value = assignments.get(role)
        ids = value if isinstance(value, list) else ([value] if value else [])
        role_rows.append({
            "role": role,
            "label": label,
            "multi": multi,
            "optional": role in OPTIONAL_ROLES,
            "assignees": [{"agentId": aid, "label": agent_label(agents, aid)}
                          for aid in ids if aid and aid != "none"],
        })

    approval_rows = []
    for approval_id, approval in approval_state(run).items():
        approval_rows.append({
            "approvalId": approval_id,
            "type": approval.get("type"),
            "status": approval_status(approval),
            "stage": approval.get("stage"),
            "target": approval.get("target"),
            "summary": approval.get("summary") or "",
            "items": list(approval.get("items") or []),
            "issuedAt": approval.get("issuedAt"),
            "expiresAt": approval.get("expiresAt"),
            "consumed": bool(approval.get("consumed")),
            "consumedAt": approval.get("consumedAt"),
            "revoked": bool(approval.get("revoked")),
            "taskFile": approval.get("taskFile"),
            "taskFileHash": approval.get("taskFileHash"),
            "repositoryPath": approval.get("repositoryPath"),
            "writableRoot": approval.get("writableRoot"),
            "network": bool(approval.get("network")),
        })

    expected = [{"stage": stage, "path": label, "found": found}
                for stage, label, found in artifact_report(run)]
    discovered, truncated = [], False
    for path, rel, kind in _artifact_files(run):
        if len(discovered) >= 500:
            truncated = True
            break
        entry = {"path": f"artifacts/{rel.as_posix()}", "kind": kind}
        if kind == "file":
            try:
                info = path.stat()
                entry["size"] = info.st_size
                entry["modifiedAt"] = iso(_dt.datetime.fromtimestamp(
                    info.st_mtime, _dt.timezone.utc).astimezone())
            except OSError as exc:
                entry["error"] = str(exc)
        discovered.append(entry)

    attachments, bad_attachments = attachment_records(run)
    for entry in bad_attachments:
        warnings.append(f"inputs/attachments.jsonl line {entry['line']} is malformed "
                        f"and was not interpreted")

    hygiene = None
    for event in events:
        if event.get("event") in ("output-hygiene.completed", "output-hygiene.failed"):
            hygiene = event
    hygiene_view = None
    if hygiene:
        report = hygiene.get("report")
        hygiene_view = {
            "status": "failed" if hygiene.get("event", "").endswith("failed") else "completed",
            "at": hygiene.get("at"),
            "mode": hygiene.get("mode"),
            "files": hygiene.get("files"),
            "changedFiles": hygiene.get("changedFiles"),
            "wouldChangeFiles": hygiene.get("wouldChangeFiles"),
            "errors": hygiene.get("errors"),
            "evidencePath": report,
            "evidenceSha256": hygiene.get("reportSha256"),
            "evidencePresent": bool(report and (run.dir / report).is_file()),
            "provenancePreserved": bool(hygiene.get("provenancePreserved", True)),
            "provenanceService": hygiene.get("provenanceService"),
        }

    project_id = manifest.get("projectId")
    if project_id is not None and not (
            isinstance(project_id, str) and valid_project_id(project_id)):
        warnings.append(f"run names project {project_id!r}, which is not a usable "
                        f"project id; ignoring it")
        project_id = None
    project = None
    if project_id:
        doc = read_json(project_dir(project_id) / "project.json")
        if isinstance(doc, dict) and doc.get("projectId"):
            project = {"projectId": doc.get("projectId"), "name": doc.get("name"),
                       "repoPaths": list(doc.get("repoPaths") or [])}
        else:
            warnings.append(f"run names project '{project_id}', which is not in the "
                            f"registry")

    requirement_path = run.dir / "requirement.md"
    return {
        "schemaVersion": SCHEMA_VERSION,
        "runId": run.id,
        "dir": str(run.dir),
        "manifest": manifest,
        "state": manifest.get("state"),
        "blockedFrom": manifest.get("blockedFrom"),
        "projectId": project_id,
        "project": project,
        "requirement": {
            "summary": manifest.get("requirement") or None,
            "jiraKey": manifest.get("jiraKey"),
            "hasFile": requirement_path.is_file(),
            "path": "requirement.md" if requirement_path.is_file() else None,
        },
        "plan": plan,
        "planLine": run.plan_line() if plan else None,
        "stageTimeline": timeline,
        "sequence": sequence,
        "nextState": run.next_state(),
        "nextAction": next_action(run),
        "roles": {
            "confirmed": run.roles_confirmed(),
            "confirmedAt": (roles or {}).get("confirmedAt"),
            "selectedAt": (roles or {}).get("selectedAt"),
            "orchestrator": orchestrator_view(roles, agents),
            "assignments": role_rows,
        },
        "approvals": approval_rows,
        "checkpoints": checkpoints,
        "events": event_page(events, len(events), events_limit, events_cursor),
        "artifacts": {"expected": expected, "discovered": discovered,
                      "truncated": truncated},
        "attachments": attachments,
        "outputHygiene": hygiene_view,
        "session": session_view(run.dir, roles, agents),
        "designPanel": design_panel_summary(run),
        "warnings": warnings,
    }


# ---------------------------------------------------------------- approvals --


def approval_state(run: Run):
    """Replay approvals.jsonl into {approvalId: record}, applying consumption."""
    by_id = {}
    for rec in run.approvals():
        t = rec.get("type")
        if t in ("codex-approval", "publication-approval"):
            by_id[rec["approvalId"]] = dict(rec)
        elif t in ("codex-approval-consumed", "publication-approval-consumed"):
            a = by_id.get(rec.get("approvalId"))
            if a is not None:
                a["consumed"] = True
                a["consumedAt"] = rec.get("at")
        elif t == "approval-revoked":
            a = by_id.get(rec.get("approvalId"))
            if a is not None:
                a["revoked"] = True
    return by_id


def approval_status(a, at=None):
    at = at or now()
    if a.get("revoked"):
        return "revoked"
    if a.get("consumed"):
        return "consumed"
    try:
        if parse_iso(a["expiresAt"]) <= at:
            return "expired"
    except (KeyError, ValueError):
        return "malformed"
    return "valid"


def require_typed_confirmation(expected: str):
    print(f"\nType exactly:  {expected}")
    print("(anything else cancels)")
    try:
        typed = sys.stdin.readline()
    except KeyboardInterrupt:
        typed = ""
    if (typed or "").strip() != expected:
        die("not approved — the confirmation phrase did not match. Nothing was recorded.", 7)


# ------------------------------------------------------------------- doctor --

OK, WARN, BAD = "ok", "warn", "bad"


def _row(rows, name, status, detail="", required=False):
    rows.append((name, status, detail, required))


def check_claude_profile(name):
    d = PROFILES_DIR / name
    if not d.is_dir():
        return WARN, "not created"
    if (d / ".credentials.json").exists() or (d / "projects").is_dir():
        return OK, "authenticated"
    return WARN, "created, not signed in"


def check_bedrock():
    """One source of truth: the bedrock profile's settings.json. The shell
    wrapper must not override it, and env.sh must not contradict it."""
    d = PROFILES_DIR / "bedrock"
    problems, notes = [], []
    settings = read_json(d / "settings.json", {}) if d.is_dir() else None
    if settings is None:
        return WARN, "profile not created"
    env = (settings or {}).get("env", {})
    prof, region = env.get("AWS_PROFILE"), env.get("AWS_REGION")
    if not prof or not region:
        return WARN, f"settings.json has no AWS_PROFILE/AWS_REGION (expected {BEDROCK_AWS_PROFILE}/{BEDROCK_AWS_REGION})"
    if prof != BEDROCK_AWS_PROFILE:
        problems.append(f"settings AWS_PROFILE={prof}, expected {BEDROCK_AWS_PROFILE}")
    if region != BEDROCK_AWS_REGION:
        problems.append(f"settings AWS_REGION={region}, expected {BEDROCK_AWS_REGION}")

    wrapper = SHARED / "shell" / "claude-profiles.sh"
    if wrapper.exists():
        txt = wrapper.read_text(encoding="utf-8", errors="replace")
        body = txt.split("cc-bedrock()", 1)[-1].split("\n}", 1)[0] if "cc-bedrock()" in txt else ""
        if "AWS_PROFILE" in body or "AWS_REGION" in body:
            problems.append("claude-profiles.sh overrides AWS_PROFILE/AWS_REGION in cc-bedrock")
    if not shutil.which("aws"):
        notes.append("aws CLI not installed")
    else:
        try:
            r = subprocess.run(["aws", "configure", "list-profiles"],
                               capture_output=True, text=True, timeout=15)
            if r.returncode == 0 and prof not in r.stdout.split():
                problems.append(f"aws profile '{prof}' is not configured")
        except (OSError, subprocess.SubprocessError):
            notes.append("could not list aws profiles")
    if problems:
        return BAD, "; ".join(problems)
    return OK, f"{prof} / {region}" + (f" ({'; '.join(notes)})" if notes else "")


def check_atlassian():
    src = read_json(MCP_SRC, {})
    s = (src.get("servers") or {}).get("atlassian")
    if not s:
        return WARN, "no atlassian server in mcp-servers.json"
    url = s.get("url", "")
    if url != ATLASSIAN_MCP_URL:
        return BAD, f"endpoint is {url or '(unset)'}, expected {ATLASSIAN_MCP_URL}"
    if s.get("transport") != "http":
        return BAD, f"transport is {s.get('transport')}, expected http"
    return OK, "endpoint current — OAuth is verified inside a Claude session (/mcp)"


def check_docx():
    if shutil.which("pandoc"):
        return OK, "pandoc"
    try:
        import docx  # noqa: F401
        return OK, "python-docx"
    except ImportError:
        return BAD, "install pandoc, or: pip install python-docx --break-system-packages"


def check_confluence():
    base = os.environ.get("CONFLUENCE_BASE_URL", "")
    email = os.environ.get("CONFLUENCE_EMAIL", "")
    tok = os.environ.get("CONFLUENCE_API_TOKEN", "")
    if base and email and tok:
        return OK, f"{base} as {email}"
    missing = [n for n, v in (("base url", base), ("email", email), ("token", tok)) if not v]
    return WARN, "missing: " + ", ".join(missing)


def check_runs_dir():
    try:
        RUNS.mkdir(parents=True, exist_ok=True)
        probe = RUNS / f".probe-{os.getpid()}"
        probe.write_text("x")
        probe.unlink()
        return OK, str(RUNS)
    except OSError as e:
        return BAD, f"{RUNS}: {e}"


def _git(args, cwd):
    try:
        return subprocess.run(["git", *args], cwd=str(cwd), capture_output=True,
                              text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None


def check_toolkit_source():
    if not SHARED.is_dir():
        return BAD, f"{SHARED} does not exist"
    if not AGENTS_FILE.exists():
        return BAD, f"no {AGENTS_FILE}"
    try:
        load_agents()
    except SystemExit as e:
        return BAD, getattr(e, "msg", "agents.json invalid")
    r = _git(["status", "--porcelain"], SHARED)
    if r is None or r.returncode != 0:
        return WARN, f"{SHARED} (not a git repository)"
    dirty = [l for l in r.stdout.splitlines() if l.strip()]
    return (WARN, f"dirty — {len(dirty)} uncommitted change(s)") if dirty else (OK, "clean")


def check_git_remote():
    r = _git(["remote", "-v"], SHARED)
    if r is None or r.returncode != 0:
        return WARN, "not a git repository"
    if not r.stdout.strip():
        return WARN, "no remote — this machine is the only copy"
    first = r.stdout.splitlines()[0].split()
    return OK, first[1] if len(first) > 1 else "configured"


SAFETY_EXEMPT = "fde-safety-exempt"


def scan_for_bypass_flags(roots):
    """Find sandbox-bypass flags anywhere they could reach a real invocation.

    A line may opt out with the marker below, and only for the honest cases: the
    list of flags this checker looks for, and the guards that refuse them. If you
    find yourself adding the marker to a line that actually runs codex, stop."""
    hits = []
    for root in roots:
        if not root.exists():
            continue
        files = [root] if root.is_file() else [q for q in root.rglob("*") if q.is_file()]
        for q in files:
            if q.suffix in (".png", ".jpg", ".jpeg", ".pdf", ".zip", ".pyc") or f"{os.sep}.git{os.sep}" in str(q):
                continue
            try:
                txt = q.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            for n, line in enumerate(txt.splitlines(), 1):
                if SAFETY_EXEMPT in line:
                    continue
                for flag in FORBIDDEN_CODEX_FLAGS:
                    if flag in line:
                        hits.append(f"{q}:{n}: {flag}")
    return hits


def check_codex_safety():
    """Nothing in this toolkit may ever reach for a sandbox bypass."""
    hits = scan_for_bypass_flags([SHARED / "bin", SHARED / "fde-toolkit", SHARED / "shell"])
    return (BAD, "; ".join(hits[:5])) if hits else (OK, "no sandbox-bypass flags present")


def check_harness_config():
    plugin = TOOLKIT_ROOT
    script = plugin / "scripts" / "audit_agent_config.py"
    if not script.is_file():
        return BAD, f"missing harness audit script: {script}"
    try:
        result = subprocess.run(
            [sys.executable, str(script), "--plugin-root", str(plugin),
             "--shared-root", str(SHARED), "--json"],
            capture_output=True, text=True, timeout=30,
        )
        report = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        return BAD, f"harness audit could not run: {exc}"
    errors = report.get("errors") or []
    warnings = report.get("warnings") or []
    if errors:
        return BAD, f"{len(errors)} error(s): {errors[0]}"
    if warnings:
        return WARN, f"clean with {len(warnings)} authority warning(s)"
    return OK, "manifests, roles, MCP scope, secrets and bypass flags clean"


def check_design_sources():
    """The vendored design references, against their checked-in lock.

    Reads only files inside the toolkit: no network, no upstream call, and
    nothing from those sources is executed to answer this."""
    tool = TOOLKIT_ROOT / "vendor" / "bin" / "design-sources"
    lock = TOOLKIT_ROOT / "vendor" / "design-sources.lock.json"
    if not lock.is_file():
        return WARN, "not vendored — design panels have no references or guidance packs"
    if not tool.is_file():
        return BAD, f"lock present but {tool} is missing"
    try:
        result = subprocess.run([sys.executable, str(tool), "audit", "--json"],
                                capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        return BAD, f"audit could not run: {exc}"
    try:
        report = json.loads(result.stdout)
    except json.JSONDecodeError:
        return BAD, "audit produced no readable report"
    sources = vendor_lock()
    pins = ", ".join(f"{name} {record.get('commit', '')[:7]}"
                     for name, record in sorted(sources.items()))
    if report.get("ok"):
        return OK, f"{report.get('checkedFiles', 0)} files match the lock — {pins}"
    first = (report.get("problems") or ["unknown drift"])[0]
    return BAD, f"{len(report.get('problems') or [])} problem(s): {first}"


def cmd_doctor(args):
    rows = []
    agents = None
    try:
        agents = load_agents()
    except SystemExit:
        pass

    for prof, label in (("work", "Claude work"), ("msc", "Claude msc"), ("alt", "Claude alt")):
        st, detail = check_claude_profile(prof)
        _row(rows, label, st, detail)

    st, detail = check_bedrock()
    _row(rows, "Claude Bedrock", st, detail, required=True)

    _row(rows, "Codex", *( (OK, shutil.which("codex")) if shutil.which("codex")
                           else (WARN, "not installed — npm i -g @openai/codex") ))
    _row(rows, "Gemini", *( (OK, shutil.which("gemini")) if shutil.which("gemini")
                            else (WARN, "not installed — npm i -g @google/gemini-cli") ))

    if directline_secret(quiet=True):
        src = "macOS Keychain" if shutil.which("security") else "environment"
        _row(rows, "Microsoft Copilot Studio", OK, f"Direct Line secret present ({src})")
    elif os.environ.get("COPILOT_TOKEN_ENDPOINT"):
        _row(rows, "Microsoft Copilot Studio", OK, "token endpoint configured")
    else:
        _row(rows, "Microsoft Copilot Studio", WARN,
             "unconfigured — security add-generic-password -a \"$USER\" -s fde-copilot-directline -w")

    _row(rows, "Atlassian MCP", *check_atlassian(), required=True)
    _row(rows, "Confluence CLI", *check_confluence())
    _row(rows, "DOCX intake", *check_docx())
    _row(rows, "Run directory", *check_runs_dir(), required=True)
    _row(rows, "Toolkit source", *check_toolkit_source(), required=True)
    _row(rows, "Git remote", *check_git_remote())
    _row(rows, "Codex flag safety", *check_codex_safety(), required=True)
    _row(rows, "Agent harness audit", *check_harness_config(), required=True)
    _row(rows, "Vendored design sources", *check_design_sources())

    if shutil.which("copilot"):
        _row(rows, "GitHub Copilot CLI", WARN,
             "installed but NOT part of this ecosystem — nothing here calls it")

    mark = {OK: "ok", WARN: "--", BAD: "BROKEN"}
    width = max(len(r[0]) for r in rows)
    print()
    for name, st, detail, required in rows:
        tag = mark[st] + ("*" if required and st == BAD else "")
        print(f"  {name:<{width}}  {tag:<7} {detail}")
    broken = [r for r in rows if r[1] == BAD and r[3]]
    warned = [r for r in rows if r[1] == WARN]
    print()
    print(f"  {len(rows)} checks — {len(broken)} required broken, {len(warned)} advisory")
    if agents:
        print(f"  {len(agents['agents'])} identities registered; roles are assigned per run, never here.")
    print("  (no secret values are read or printed by this command)")
    return 1 if broken else 0


