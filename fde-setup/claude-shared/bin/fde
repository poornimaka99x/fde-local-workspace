#!/usr/bin/env python3
"""fde — the local workflow controller for forward-deployed engineering runs.

One run = one requirement taken from intake to publication. The controller owns
three things the agents must not own themselves:

  1. Roles.       Who does what is decided by the user, per run, before anything
                  else happens. Identities are not roles; nothing is inherited
                  from the previous run.
  2. Approvals.   Codex may write only under a one-time, hash-bound, expiring
                  approval. Anything leaving this machine — Jira, Confluence,
                  SharePoint, Bitbucket, GitHub, deployment, email or Teams —
                  needs its own.
  3. The record.  Every state change, invocation and approval is appended to the
                  run's events.jsonl, so "what did the agents actually do" has a
                  answer that does not depend on anyone's memory.

Python 3, standard library only.
"""
from __future__ import annotations

import argparse
import datetime as _dt
import hashlib
import json
import os
import pathlib
import re
import secrets
import shutil
import subprocess
import sys

# ---------------------------------------------------------------- locations --

HOME = pathlib.Path(os.environ.get("HOME", pathlib.Path.home()))
SHARED = pathlib.Path(os.environ.get("CLAUDE_SHARED", HOME / ".claude-shared"))
RUNS = pathlib.Path(os.environ.get("FDE_RUNS_DIR", SHARED / "runs"))
PROFILES_DIR = pathlib.Path(os.environ.get("CLAUDE_PROFILES_DIR", HOME / ".claude-profiles"))
AGENTS_FILE = SHARED / "config" / "agents.json"
MCP_SRC = SHARED / "mcp" / "mcp-servers.json"
TOOLKIT_ROOT = pathlib.Path(os.environ.get(
    "FDE_TOOLKIT_ROOT", SHARED / "fde-toolkit" / "plugins" / "fde-core"))

BEDROCK_AWS_PROFILE = "bedrock-dev"
BEDROCK_AWS_REGION = "eu-west-1"
ATLASSIAN_MCP_URL = "https://mcp.atlassian.com/v1/mcp/authv2"

DEFAULT_APPROVAL_TTL_MIN = 30

# Flags that must never appear anywhere in this toolkit.
# One line on purpose: the exemption marker below covers exactly the line it is
# on, and this list is the one honest place these strings are allowed to appear.
FORBIDDEN_CODEX_FLAGS = ("--yolo", "danger-full-access", "--dangerously-bypass-approvals-and-sandbox")  # fde-safety-exempt: the list itself

# ------------------------------------------------------------- state machine --

# Every state a run CAN be in. Which of them a given run actually visits is
# decided by its plan. Most real work is a slice of the full pipeline — research
# that needs validating and presenting; a presentation plus a Jira breakdown —
# and marching such a job through eleven irrelevant states is how a tool starts
# getting worked around instead of used.
STATES = [
    "awaiting_orchestrator",
    "awaiting_plan",
    "awaiting_roles",
    "roles_confirmed",
    "intake",
    "research",
    "solutioning",
    "review",
    "reconciliation",
    "presentation",
    "planning",
    "awaiting_implementation_approval",
    "implementation",
    "verification",
    "awaiting_deployment_approval",
    "deployment",
    "observability",
    "awaiting_publication_approval",
    "publication",
    "complete",
    "blocked",
]

# You pick the orchestrator first, before you even state the ask. It is the
# identity that will read your sentence and propose what the run should do, so
# choosing it is not a detail to fill in later — it is the first decision.
PRELUDE = ["awaiting_orchestrator", "awaiting_plan", "awaiting_roles", "roles_confirmed"]

# The work stages, in the only order they can sensibly run. A plan is a subset of
# this list; it never reorders it.
STAGE_ORDER = [
    "intake",
    "research",
    "solutioning",
    "review",
    "reconciliation",
    "presentation",
    "planning",
    "implementation",
    "verification",
    "deployment",
    "observability",
    "publication",
]

STAGE_LABEL = {
    "intake": "intake",
    "research": "research",
    "solutioning": "solution architecture",
    "review": "adversarial review",
    "reconciliation": "reconciliation",
    "presentation": "presentation",
    "planning": "development plan",
    "implementation": "implementation",
    "verification": "verification",
    "deployment": "deployment",
    "observability": "observability and monitoring",
    "publication": "publication",
}

# A gate state is inserted automatically before the stage it guards, and only
# when that stage is in the plan. You cannot plan your way past an approval.
STAGE_GATE = {
    "implementation": "awaiting_implementation_approval",
    "deployment": "awaiting_deployment_approval",
    "publication": "awaiting_publication_approval",
}

GATE_STATES = {gate: stage for stage, gate in STAGE_GATE.items()}

# Shorthand for the shapes that come up often. Free text is the normal way in —
# these exist so a shape you run every week does not need re-describing.
SHAPES = {
    "research": ["intake", "research"],
    "research-to-adr": ["intake", "research", "solutioning", "review", "reconciliation"],
    "review-only": ["intake", "review"],
    "presentation": ["intake", "presentation"],
    "delivery-plan": ["intake", "planning"],
    "build": ["intake", "implementation", "verification"],
    "pr-review": ["intake", "review", "verification"],
    "design-to-build": ["intake", "solutioning", "presentation", "planning", "implementation", "verification"],
    "release": ["verification", "deployment", "observability"],
    "operate": ["intake", "observability"],
    "full": list(STAGE_ORDER),
}

# Which role a stage needs filled. An identity may hold several roles, so if you
# want the orchestrator to also write the delivery plan, assign it both.
STAGE_ROLES = {
    "intake": ["orchestrator"],
    "research": ["research"],
    "solutioning": ["solutioning"],
    "review": ["review"],
    "reconciliation": ["orchestrator"],
    "presentation": ["presentation"],
    "planning": ["deliveryPlanning"],
    "implementation": ["implementation"],
    "verification": ["testEngineering"],
    "deployment": ["releaseManagement"],
    "observability": ["observability"],
    "publication": ["orchestrator"],
}

# Specialist roles are offered only when their stage is in the plan. They may be
# assigned to any capable identity, assigned to the same identity as another
# role, or explicitly left empty. Subagents provide the specialist method; this
# registry decides which account is authorised to invoke them for this run.
OPTIONAL_ROLES = {
    "productManagement": {"intake", "research", "planning"},
    "uiUxDesign": {"solutioning", "presentation", "implementation", "verification"},
    "designSystem": {"solutioning", "implementation", "verification"},
    "prReview": {"review"},
    "standardsReview": {"review", "verification"},
    "securityReview": {"review", "verification"},
    "ciInvestigation": {"verification"},
    "microsoftContext": {"intake", "research"},
}

# What a stage normally feeds on — any one of these is enough. Advisory: fde says
# what is missing and then does what you asked. Reviewing raw research without an
# architecture in between is a real thing to want, not a mistake.
STAGE_PREREQ = {
    "research": ["intake"],
    "solutioning": ["research"],
    "review": ["solutioning", "research"],
    "reconciliation": ["review"],
    "presentation": ["reconciliation", "solutioning", "research"],
    "planning": ["reconciliation", "solutioning", "research"],
    "implementation": ["planning", "solutioning"],
    "verification": ["implementation"],
    "deployment": ["verification"],
    "observability": ["deployment", "implementation"],
    "publication": [],
}

STAGE_ARTIFACTS = {
    "intake": [],
    "research": [("research", "research-brief.md")],
    "solutioning": [("architecture", "architecture-options.md"), ("architecture", "adr.md")],
    "review": [("review", "review.md")],
    "reconciliation": [("review", "reconciliation.md")],
    "presentation": [("presentation", "solution-presentation.pptx")],
    "planning": [("delivery-plan", "development-plan.md"), ("delivery-plan", "jira-plan.json")],
    "implementation": [("implementation", "implementation-task.md")],
    "verification": [("implementation", "verification-report.md")],
    "deployment": [("deployment", "deployment-report.md")],
    "observability": [("observability", "observability-plan.md")],
    "publication": [(".", "publication-manifest.json")],
}

STAGE_DIR = {
    "intake": "research",
    "research": "research",
    "solutioning": "architecture",
    "review": "review",
    "reconciliation": "review",
    "presentation": "presentation",
    "planning": "delivery-plan",
    "implementation": "implementation",
    "verification": "implementation",
    "deployment": "deployment",
    "observability": "observability",
    "publication": "delivery-plan",
}

# Derived: which stages a role may act in. Built from STAGE_ROLES so the two can
# never drift apart.
ROLE_STAGES = {}
for _stage, _roles in STAGE_ROLES.items():
    for _r in _roles:
        ROLE_STAGES.setdefault(_r, set()).add(_stage)
for _r, _stages in OPTIONAL_ROLES.items():
    ROLE_STAGES.setdefault(_r, set()).update(_stages)

ALL_ROLES = list(STAGE_ROLES) and [
    "orchestrator", "productManagement", "research", "solutioning",
    "uiUxDesign", "designSystem", "review", "prReview", "standardsReview",
    "securityReview", "deliveryPlanning", "presentation", "implementation",
    "testEngineering", "ciInvestigation", "releaseManagement",
    "observability", "microsoftContext",
]

MULTI_ROLES = {"research", "review"}

PUBLICATION_TARGETS = (
    "jira", "confluence", "sharepoint", "bitbucket", "github", "deployment",
    "email", "teams",
)

ARTIFACT_DIRS = [
    "research", "architecture", "review", "presentation", "delivery-plan",
    "implementation", "deployment", "observability", "evidence", "learning",
]


def expand_stages(stages):
    """A plan, in canonical order, with its approval gates inserted."""
    chosen = [s for s in STAGE_ORDER if s in set(stages)]
    out = []
    for s in chosen:
        if s in STAGE_GATE:
            out.append(STAGE_GATE[s])
        out.append(s)
    return chosen, out


def state_sequence(stages):
    _chosen, expanded = expand_stages(stages)
    return PRELUDE + expanded + ["complete"]


def transitions_for(stages):
    seq = state_sequence(stages)
    tr = {a: {b} for a, b in zip(seq, seq[1:])}
    tr.setdefault("complete", set())
    for s in seq:
        tr[s].add("blocked")
    tr["blocked"] = set(seq)
    return tr


def roles_needed(stages):
    """Which roles this plan actually requires, in the canonical display order."""
    need = {"orchestrator"}
    for s in stages:
        need.update(STAGE_ROLES.get(s, []))
    for r, when in OPTIONAL_ROLES.items():
        if when & set(stages):
            need.add(r)
    return [r for r in ALL_ROLES if r in need]


def prereq_warnings(run_stages):
    """Advisory only. Names what a stage normally feeds on when the plan omits it."""
    have = set(run_stages)
    out = []
    for s in run_stages:
        feeders = STAGE_PREREQ.get(s, [])
        if feeders and not (have & set(feeders)):
            out.append(f"{STAGE_LABEL[s]} normally follows "
                       f"{' or '.join(STAGE_LABEL[f] for f in feeders)}, which this plan skips — "
                       f"supply that input yourself or expect thin output")
    return out

# ------------------------------------------------------------------ plumbing --


class Fail(SystemExit):
    def __init__(self, msg, code=1):
        super().__init__(code)
        self.msg = msg


def die(msg, code=1):
    sys.stdout.flush()
    print(f"fde: {msg}", file=sys.stderr)
    raise SystemExit(code)


def now():
    return _dt.datetime.now(_dt.timezone.utc).astimezone()


def iso(ts=None):
    return (ts or now()).isoformat(timespec="seconds")


def parse_iso(s):
    return _dt.datetime.fromisoformat(s)


def slug(s, n=40):
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", (s or "").lower())).strip("-")[:n] or "run"


def write_atomic(path: pathlib.Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def write_json(path: pathlib.Path, data):
    write_atomic(path, json.dumps(data, indent=2) + "\n")


def read_json(path: pathlib.Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def append_jsonl(path: pathlib.Path, record):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, sort_keys=True) + "\n")
        fh.flush()
        os.fsync(fh.fileno())


def read_jsonl(path: pathlib.Path):
    out = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line:
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except FileNotFoundError:
        pass
    return out


def sha256_file(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


# -------------------------------------------------------------------- agents --


def load_agents():
    data = read_json(AGENTS_FILE)
    if data is None:
        die(f"no agent registry at {AGENTS_FILE} — is the toolkit installed?", 2)
    if "agents" not in data:
        die(f"{AGENTS_FILE} has no 'agents' key", 2)
    for aid, a in data["agents"].items():
        for banned in ("role", "defaultRole", "preferred", "default"):
            if banned in a:
                die(f"{AGENTS_FILE}: agent '{aid}' declares '{banned}'. "
                    "Identities must not carry roles — roles are assigned per run.", 2)
    return data


def agent_label(agents, aid):
    a = agents["agents"].get(aid)
    return a.get("label", aid) if a else aid


def agent_available(agents, aid):
    """(available: bool, detail: str). Availability is about the local surface,
    not about whether the identity is any good at the job."""
    a = agents["agents"].get(aid)
    if not a:
        return False, "unknown identity"
    kind = a.get("kind")
    if kind == "claude":
        p = a.get("profile", "")
        d = PROFILES_DIR / p
        if not d.is_dir():
            return False, f"no profile dir at {d} — run claude-profile-new {p}"
        return True, f"profile {p}"
    if kind == "codex":
        return (True, "codex CLI") if shutil.which("codex") else (False, "codex CLI not installed")
    if kind == "gemini":
        return (True, "gemini CLI") if shutil.which("gemini") else (False, "gemini CLI not installed")
    if kind == "copilot-studio":
        if directline_secret(quiet=True) or os.environ.get("COPILOT_TOKEN_ENDPOINT"):
            return True, "Direct Line configured"
        return False, "no Direct Line secret or token endpoint"
    return False, f"unknown kind '{kind}'"


def directline_secret(quiet=False):
    """Keychain first, environment second. Never printed by anything that logs."""
    if shutil.which("security"):
        try:
            r = subprocess.run(
                ["security", "find-generic-password", "-a", os.environ.get("USER", ""),
                 "-s", "fde-copilot-directline", "-w"],
                capture_output=True, text=True, timeout=10)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    return os.environ.get("COPILOT_DIRECTLINE_SECRET", "").strip()


# ----------------------------------------------------------------- run store --


class Run:
    def __init__(self, run_id):
        self.id = run_id
        self.dir = RUNS / run_id
        if not self.dir.is_dir():
            die(f"no such run: {run_id}\n       try: fde list", 4)

    # -- paths
    @property
    def manifest_path(self): return self.dir / "manifest.json"
    @property
    def roles_path(self): return self.dir / "roles.json"
    @property
    def plan_path(self): return self.dir / "plan.json"
    @property
    def events_path(self): return self.dir / "events.jsonl"
    @property
    def approvals_path(self): return self.dir / "approvals.jsonl"
    @property
    def checkpoints_path(self): return self.dir / "checkpoints.jsonl"
    @property
    def tasks_dir(self): return self.dir / "tasks"
    @property
    def artifacts_dir(self): return self.dir / "artifacts"

    # -- manifest
    def manifest(self):
        m = read_json(self.manifest_path)
        if m is None:
            die(f"run {self.id} has no manifest.json", 4)
        return m

    def save_manifest(self, m):
        m["updatedAt"] = iso()
        write_json(self.manifest_path, m)

    @property
    def state(self):
        return self.manifest().get("state", "awaiting_roles")

    # -- log
    def event(self, kind, **fields):
        append_jsonl(self.events_path, {"at": iso(), "event": kind, "runId": self.id, **fields})

    def events(self):
        return read_jsonl(self.events_path)

    def approvals(self):
        return read_jsonl(self.approvals_path)

    def checkpoints(self):
        return read_jsonl(self.checkpoints_path)

    def latest_checkpoint(self, stage):
        matches = [c for c in self.checkpoints() if c.get("stage") == stage]
        return matches[-1] if matches else None

    def require_passing_checkpoint(self, stage, artifacts):
        missing = [str(p.relative_to(self.dir)) for p in artifacts if not p.is_file()]
        if missing:
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: required evidence "
                f"artifact(s) missing: {', '.join(missing)}", 9)
        checkpoint = self.latest_checkpoint(stage)
        if not checkpoint:
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: no checkpoint is "
                f"recorded.\n       run: fde checkpoint {self.id} --stage {stage} "
                f"--status pass --evidence <file-or-note>", 9)
        if checkpoint.get("status") != "pass":
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: latest checkpoint "
                f"is '{checkpoint.get('status')}', not 'pass'.", 9)
        if not checkpoint.get("evidence"):
            die(f"run {self.id} cannot leave {STAGE_LABEL[stage]}: the passing "
                f"checkpoint contains no evidence.", 9)

    def write_requirement(self, text):
        m = self.manifest()
        write_atomic(self.dir / "requirement.md", (
            f"# Requirement\n\n"
            f"- captured: {iso()}\n"
            f"- jira: {m.get('jiraKey') or '(none given)'}\n"
            f"- source: given by the user; nothing has been fetched\n\n"
            f"---\n\n{text}\n"))
        m["requirement"] = text[:400]
        km = re.match(r"^([A-Z][A-Z0-9]+-\d+)\b", text.strip())
        if km and not m.get("jiraKey"):
            m["jiraKey"] = km.group(1)
        self.save_manifest(m)

    def orchestrator(self):
        who = self.assignees("orchestrator")
        return who[0] if who else None

    def guard_orchestrator(self, what):
        if not self.orchestrator():
            die(f"run {self.id} has no orchestrator yet, so {what} is not permitted.\n"
                f"       run: fde orchestrator {self.id} <identity>", 6)

    # -- plan
    def plan(self):
        return read_json(self.plan_path)

    def planned(self):
        p = self.plan()
        return bool(p and p.get("confirmedAt"))

    def stages(self):
        """This run's stages. A run created before plans existed is a full one."""
        p = self.plan()
        if p and p.get("stages"):
            return [s for s in STAGE_ORDER if s in set(p["stages"])]
        return list(STAGE_ORDER)

    def skipped(self):
        return [s for s in STAGE_ORDER if s not in set(self.stages())]

    def sequence(self):
        return state_sequence(self.stages())

    def roles_needed(self):
        return roles_needed(self.stages())

    def plan_line(self):
        return "  →  ".join(STAGE_LABEL[s] for s in self.stages())

    # -- roles
    def roles(self):
        return read_json(self.roles_path)

    def roles_confirmed(self):
        s = self.state
        if s == "blocked":
            s = self.manifest().get("blockedFrom") or "awaiting_orchestrator"
        return s not in ("awaiting_orchestrator", "awaiting_plan", "awaiting_roles")

    def assignees(self, role):
        r = self.roles() or {}
        v = (r.get("assignments") or {}).get(role)
        if v in (None, "none", ""):
            return []
        return list(v) if isinstance(v, list) else [v]

    def role_of(self, agent_id, stage=None):
        """Which assigned role, if any, lets this identity act (in this stage)."""
        r = self.roles() or {}
        hits = []
        for role in (r.get("assignments") or {}):
            if agent_id in self.assignees(role):
                if stage is None or stage in ROLE_STAGES.get(role, set()):
                    hits.append(role)
        return hits

    # -- state
    def set_state(self, new, reason=""):
        if new not in STATES:
            die(f"unknown state '{new}'. Known: {', '.join(STATES)}", 2)
        m = self.manifest()
        old = m.get("state")
        if new == old:
            return old
        if old == "verification" and new == "awaiting_deployment_approval":
            self.require_passing_checkpoint("verification", [
                self.artifacts_dir / "implementation" / "verification-report.md",
            ])
        if old == "observability" and new in ("awaiting_publication_approval", "complete"):
            self.require_passing_checkpoint("observability", [
                self.artifacts_dir / "observability" / "observability-plan.md",
            ])
        if old in GATE_STATES and new == GATE_STATES[old]:
            self.check_gate(old, new)
        if new not in transitions_for(self.stages()).get(old, set()):
            nxt = self.next_state(old)
            hint = f" Next in this run's plan is '{nxt}'." if nxt else ""
            die(f"illegal transition {old} -> {new}.{hint}\n"
                f"       This run's plan: {self.plan_line()}", 5)
        if new == "blocked":
            m["blockedFrom"] = old
        if old == "blocked":
            m.pop("blockedFrom", None)
        m["state"] = new
        self.save_manifest(m)
        self.event("state", **{"from": old, "to": new, "reason": reason})
        return old

    def check_gate(self, gate, stage):
        """Leaving an approval gate requires the approval that gate exists for."""
        apps = approval_state(self)
        if gate == "awaiting_implementation_approval":
            live = [a for a in apps.values()
                    if a["type"] == "codex-approval"
                    and approval_status(a) in ("valid", "consumed")]
            if live:
                return
            if "chatgpt_codex" in self.assignees("implementation"):
                die(f"run {self.id} cannot enter implementation: Codex holds that role "
                    f"and no write approval has been granted.\n"
                    f"       run: fde approve-codex {self.id} implementation "
                    f"--task-file <file> --repo <path>", 7)
            # A Claude identity implements inside a session you are sitting in, so
            # the approval is you, in that session, turn by turn. Say so out loud
            # rather than pretending a gate was cleared.
            self.event("approval.implementation.not-required",
                       reason="implementer is not Codex; work happens interactively "
                              "under the user's own supervision")
            return
        if gate == "awaiting_deployment_approval":
            live = [a for a in apps.values()
                    if a["type"] == "publication-approval"
                    and a.get("target") == "deployment"
                    and approval_status(a) in ("valid", "consumed")]
            if not live:
                die(f"run {self.id} cannot deploy: no deployment has been approved.\n"
                    f"       run: fde approve-publish {self.id} deployment "
                    f"--summary '<environment and release>'", 7)
            return
        if gate == "awaiting_publication_approval":
            live = [a for a in apps.values()
                    if a["type"] == "publication-approval"
                    and a.get("target") != "deployment"
                    and approval_status(a) in ("valid", "consumed")]
            if not live:
                die(f"run {self.id} cannot publish: nothing has been approved for "
                    f"publication.\n"
                    f"       run: fde approve-publish {self.id} "
                    f"<jira|confluence|sharepoint|bitbucket|email|teams>", 7)

    def next_state(self, current=None):
        seq = self.sequence()
        cur = current or self.state
        if cur == "blocked":
            cur = self.manifest().get("blockedFrom") or seq[0]
        try:
            return seq[seq.index(cur) + 1]
        except (ValueError, IndexError):
            return None

    def guard_plan(self, what):
        if not self.planned():
            die(f"run {self.id} has no confirmed plan, so {what} is not permitted yet.\n"
                f"       run: fde plan {self.id} --stages <stages>   (or --shape <name>)", 6)

    def guard_roles(self, what):
        if not self.roles_confirmed():
            die(f"run {self.id} is in state '{self.state}'. Roles are not confirmed, so "
                f"{what} is not permitted yet.\n       run: fde roles {self.id}", 6)


def new_run(requirement: str = "") -> Run:
    key = (requirement or "").strip()
    m = re.match(r"^([A-Z][A-Z0-9]+-\d+)\b", key)
    jira_key = m.group(1) if m else None
    stem = f"{now():%Y%m%d}-{slug(jira_key or key or 'run')}-{secrets.token_hex(2)}"
    d = RUNS / stem
    if d.exists():
        die(f"run directory already exists: {d}", 1)
    for sub in ["tasks", "inputs"] + [f"artifacts/{a}" for a in ARTIFACT_DIRS]:
        (d / sub).mkdir(parents=True, exist_ok=True)
    write_json(d / "manifest.json", {
        "runId": stem,
        "createdAt": iso(),
        "updatedAt": iso(),
        "state": "awaiting_orchestrator",
        "jiraKey": jira_key,
        "requirement": key[:400],
        "toolkit": "fde-core",
    })
    r = Run(stem)
    if key:
        r.write_requirement(key)
    r.event("run.created", jiraKey=jira_key, hasRequirement=bool(key))
    r.event("note", note="Created in awaiting_orchestrator. Choosing an orchestrator and "
                         "scoping the work read nothing; no connector, repository or "
                         "client-context access is permitted until roles are confirmed.")
    return r


def list_runs():
    if not RUNS.is_dir():
        return []
    out = []
    for d in sorted(RUNS.iterdir()):
        if d.is_dir() and (d / "manifest.json").exists():
            out.append(read_json(d / "manifest.json", {}))
    return out


# ---------------------------------------------------------------- approvals --


def approval_state(run: Run):
    """Replay approvals.jsonl into {approvalId: record}, applying consumption."""
    by_id = {}
    for rec in run.approvals():
        t = rec.get("type")
        if t in ("codex-approval", "publication-approval"):
            by_id[rec["approvalId"]] = dict(rec)
        elif t in ("codex-approval-consumed", "publication-approval-consumed"):
            a = by_id.get(rec.get("approvalId"))
            if a is not None:
                a["consumed"] = True
                a["consumedAt"] = rec.get("at")
        elif t == "approval-revoked":
            a = by_id.get(rec.get("approvalId"))
            if a is not None:
                a["revoked"] = True
    return by_id


def approval_status(a, at=None):
    at = at or now()
    if a.get("revoked"):
        return "revoked"
    if a.get("consumed"):
        return "consumed"
    try:
        if parse_iso(a["expiresAt"]) <= at:
            return "expired"
    except (KeyError, ValueError):
        return "malformed"
    return "valid"


def require_typed_confirmation(expected: str):
    print(f"\nType exactly:  {expected}")
    print("(anything else cancels)")
    try:
        typed = sys.stdin.readline()
    except KeyboardInterrupt:
        typed = ""
    if (typed or "").strip() != expected:
        die("not approved — the confirmation phrase did not match. Nothing was recorded.", 7)


# ------------------------------------------------------------------- doctor --

OK, WARN, BAD = "ok", "warn", "bad"


def _row(rows, name, status, detail="", required=False):
    rows.append((name, status, detail, required))


def check_claude_profile(name):
    d = PROFILES_DIR / name
    if not d.is_dir():
        return WARN, "not created"
    if (d / ".credentials.json").exists() or (d / "projects").is_dir():
        return OK, "authenticated"
    return WARN, "created, not signed in"


def check_bedrock():
    """One source of truth: the bedrock profile's settings.json. The shell
    wrapper must not override it, and env.sh must not contradict it."""
    d = PROFILES_DIR / "bedrock"
    problems, notes = [], []
    settings = read_json(d / "settings.json", {}) if d.is_dir() else None
    if settings is None:
        return WARN, "profile not created"
    env = (settings or {}).get("env", {})
    prof, region = env.get("AWS_PROFILE"), env.get("AWS_REGION")
    if not prof or not region:
        return WARN, f"settings.json has no AWS_PROFILE/AWS_REGION (expected {BEDROCK_AWS_PROFILE}/{BEDROCK_AWS_REGION})"
    if prof != BEDROCK_AWS_PROFILE:
        problems.append(f"settings AWS_PROFILE={prof}, expected {BEDROCK_AWS_PROFILE}")
    if region != BEDROCK_AWS_REGION:
        problems.append(f"settings AWS_REGION={region}, expected {BEDROCK_AWS_REGION}")

    wrapper = SHARED / "shell" / "claude-profiles.sh"
    if wrapper.exists():
        txt = wrapper.read_text(encoding="utf-8", errors="replace")
        body = txt.split("cc-bedrock()", 1)[-1].split("\n}", 1)[0] if "cc-bedrock()" in txt else ""
        if "AWS_PROFILE" in body or "AWS_REGION" in body:
            problems.append("claude-profiles.sh overrides AWS_PROFILE/AWS_REGION in cc-bedrock")
    if not shutil.which("aws"):
        notes.append("aws CLI not installed")
    else:
        try:
            r = subprocess.run(["aws", "configure", "list-profiles"],
                               capture_output=True, text=True, timeout=15)
            if r.returncode == 0 and prof not in r.stdout.split():
                problems.append(f"aws profile '{prof}' is not configured")
        except (OSError, subprocess.SubprocessError):
            notes.append("could not list aws profiles")
    if problems:
        return BAD, "; ".join(problems)
    return OK, f"{prof} / {region}" + (f" ({'; '.join(notes)})" if notes else "")


def check_atlassian():
    src = read_json(MCP_SRC, {})
    s = (src.get("servers") or {}).get("atlassian")
    if not s:
        return WARN, "no atlassian server in mcp-servers.json"
    url = s.get("url", "")
    if url != ATLASSIAN_MCP_URL:
        return BAD, f"endpoint is {url or '(unset)'}, expected {ATLASSIAN_MCP_URL}"
    if s.get("transport") != "http":
        return BAD, f"transport is {s.get('transport')}, expected http"
    return OK, "endpoint current — OAuth is verified inside a Claude session (/mcp)"


def check_docx():
    if shutil.which("pandoc"):
        return OK, "pandoc"
    try:
        import docx  # noqa: F401
        return OK, "python-docx"
    except ImportError:
        return BAD, "install pandoc, or: pip install python-docx --break-system-packages"


def check_confluence():
    base = os.environ.get("CONFLUENCE_BASE_URL", "")
    email = os.environ.get("CONFLUENCE_EMAIL", "")
    tok = os.environ.get("CONFLUENCE_API_TOKEN", "")
    if base and email and tok:
        return OK, f"{base} as {email}"
    missing = [n for n, v in (("base url", base), ("email", email), ("token", tok)) if not v]
    return WARN, "missing: " + ", ".join(missing)


def check_runs_dir():
    try:
        RUNS.mkdir(parents=True, exist_ok=True)
        probe = RUNS / f".probe-{os.getpid()}"
        probe.write_text("x")
        probe.unlink()
        return OK, str(RUNS)
    except OSError as e:
        return BAD, f"{RUNS}: {e}"


def _git(args, cwd):
    try:
        return subprocess.run(["git", *args], cwd=str(cwd), capture_output=True,
                              text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None


def check_toolkit_source():
    if not SHARED.is_dir():
        return BAD, f"{SHARED} does not exist"
    if not AGENTS_FILE.exists():
        return BAD, f"no {AGENTS_FILE}"
    try:
        load_agents()
    except SystemExit as e:
        return BAD, getattr(e, "msg", "agents.json invalid")
    r = _git(["status", "--porcelain"], SHARED)
    if r is None or r.returncode != 0:
        return WARN, f"{SHARED} (not a git repository)"
    dirty = [l for l in r.stdout.splitlines() if l.strip()]
    return (WARN, f"dirty — {len(dirty)} uncommitted change(s)") if dirty else (OK, "clean")


def check_git_remote():
    r = _git(["remote", "-v"], SHARED)
    if r is None or r.returncode != 0:
        return WARN, "not a git repository"
    if not r.stdout.strip():
        return WARN, "no remote — this machine is the only copy"
    first = r.stdout.splitlines()[0].split()
    return OK, first[1] if len(first) > 1 else "configured"


SAFETY_EXEMPT = "fde-safety-exempt"


def scan_for_bypass_flags(roots):
    """Find sandbox-bypass flags anywhere they could reach a real invocation.

    A line may opt out with the marker below, and only for the honest cases: the
    list of flags this checker looks for, and the guards that refuse them. If you
    find yourself adding the marker to a line that actually runs codex, stop."""
    hits = []
    for root in roots:
        if not root.exists():
            continue
        files = [root] if root.is_file() else [q for q in root.rglob("*") if q.is_file()]
        for q in files:
            if q.suffix in (".png", ".jpg", ".jpeg", ".pdf", ".zip", ".pyc") or f"{os.sep}.git{os.sep}" in str(q):
                continue
            try:
                txt = q.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            for n, line in enumerate(txt.splitlines(), 1):
                if SAFETY_EXEMPT in line:
                    continue
                for flag in FORBIDDEN_CODEX_FLAGS:
                    if flag in line:
                        hits.append(f"{q}:{n}: {flag}")
    return hits


def check_codex_safety():
    """Nothing in this toolkit may ever reach for a sandbox bypass."""
    hits = scan_for_bypass_flags([SHARED / "bin", SHARED / "fde-toolkit", SHARED / "shell"])
    return (BAD, "; ".join(hits[:5])) if hits else (OK, "no sandbox-bypass flags present")


def check_harness_config():
    plugin = TOOLKIT_ROOT
    script = plugin / "scripts" / "audit_agent_config.py"
    if not script.is_file():
        return BAD, f"missing harness audit script: {script}"
    try:
        result = subprocess.run(
            [sys.executable, str(script), "--plugin-root", str(plugin),
             "--shared-root", str(SHARED), "--json"],
            capture_output=True, text=True, timeout=30,
        )
        report = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        return BAD, f"harness audit could not run: {exc}"
    errors = report.get("errors") or []
    warnings = report.get("warnings") or []
    if errors:
        return BAD, f"{len(errors)} error(s): {errors[0]}"
    if warnings:
        return WARN, f"clean with {len(warnings)} authority warning(s)"
    return OK, "manifests, roles, MCP scope, secrets and bypass flags clean"


def cmd_doctor(args):
    rows = []
    agents = None
    try:
        agents = load_agents()
    except SystemExit:
        pass

    for prof, label in (("work", "Claude work"), ("msc", "Claude msc"), ("alt", "Claude alt")):
        st, detail = check_claude_profile(prof)
        _row(rows, label, st, detail)

    st, detail = check_bedrock()
    _row(rows, "Claude Bedrock", st, detail, required=True)

    _row(rows, "Codex", *( (OK, shutil.which("codex")) if shutil.which("codex")
                           else (WARN, "not installed — npm i -g @openai/codex") ))
    _row(rows, "Gemini", *( (OK, shutil.which("gemini")) if shutil.which("gemini")
                            else (WARN, "not installed — npm i -g @google/gemini-cli") ))

    if directline_secret(quiet=True):
        src = "macOS Keychain" if shutil.which("security") else "environment"
        _row(rows, "Microsoft Copilot Studio", OK, f"Direct Line secret present ({src})")
    elif os.environ.get("COPILOT_TOKEN_ENDPOINT"):
        _row(rows, "Microsoft Copilot Studio", OK, "token endpoint configured")
    else:
        _row(rows, "Microsoft Copilot Studio", WARN,
             "unconfigured — security add-generic-password -a \"$USER\" -s fde-copilot-directline -w")

    _row(rows, "Atlassian MCP", *check_atlassian(), required=True)
    _row(rows, "Confluence CLI", *check_confluence())
    _row(rows, "DOCX intake", *check_docx())
    _row(rows, "Run directory", *check_runs_dir(), required=True)
    _row(rows, "Toolkit source", *check_toolkit_source(), required=True)
    _row(rows, "Git remote", *check_git_remote())
    _row(rows, "Codex flag safety", *check_codex_safety(), required=True)
    _row(rows, "Agent harness audit", *check_harness_config(), required=True)

    if shutil.which("copilot"):
        _row(rows, "GitHub Copilot CLI", WARN,
             "installed but NOT part of this ecosystem — nothing here calls it")

    mark = {OK: "ok", WARN: "--", BAD: "BROKEN"}
    width = max(len(r[0]) for r in rows)
    print()
    for name, st, detail, required in rows:
        tag = mark[st] + ("*" if required and st == BAD else "")
        print(f"  {name:<{width}}  {tag:<7} {detail}")
    broken = [r for r in rows if r[1] == BAD and r[3]]
    warned = [r for r in rows if r[1] == WARN]
    print()
    print(f"  {len(rows)} checks — {len(broken)} required broken, {len(warned)} advisory")
    if agents:
        print(f"  {len(agents['agents'])} identities registered; roles are assigned per run, never here.")
    print("  (no secret values are read or printed by this command)")
    return 1 if broken else 0


# ----------------------------------------------------------- the role prompt --

AGENT_LABELS = {
    "claude_work": "Claude: work", "claude_msc": "Claude: msc",
    "claude_alt": "Claude: alt", "claude_bedrock": "Claude Code: Bedrock",
    "chatgpt_codex": "ChatGPT/Codex", "gemini": "Gemini",
    "microsoft_copilot": "Microsoft Copilot",
}

IDENTITY_MENU = """Available identities:
- Claude: work
- Claude: msc
- Claude: alt
- Claude Code: Bedrock
- ChatGPT/Codex
- Gemini
- Microsoft Copilot"""

ROLE_PROMPTS = [
    ("orchestrator", "Orchestrator", False),
    ("productManagement", "Product manager / analyst", False),
    ("research", "Researcher(s)", True),
    ("solutioning", "Solution architect", False),
    ("uiUxDesign", "UI/UX designer", False),
    ("designSystem", "Design-system steward", False),
    ("review", "Reviewer(s)", True),
    ("prReview", "PR analyst", False),
    ("standardsReview", "Coding-standards reviewer", False),
    ("securityReview", "Security reviewer", False),
    ("deliveryPlanning", "Delivery planner", False),
    ("presentation", "Presentation author", False),
    ("implementation", "Implementation agent", False),
    ("testEngineering", "Test engineer", False),
    ("ciInvestigation", "CI investigator", False),
    ("releaseManagement", "Release manager", False),
    ("observability", "SRE / observability engineer", False),
    ("microsoftContext", "Microsoft context source", False),
]

# Optional specialist roles are still chosen explicitly; "none" is a valid
# choice. Nothing is silently assigned because an identity held it last time.
ROLE_LINE_SUFFIX = {role: ": assign / none" for role in OPTIONAL_ROLES}

PROMPT_LABEL = {r: l for r, l, _m in ROLE_PROMPTS}


def role_question(run=None, stages=None):
    """The role question, narrowed to the roles this run's plan actually needs.

    A research-only run has no implementation agent to assign, and asking for one
    invites an answer that means nothing. The wording is otherwise unchanged."""
    stages = list(stages if stages is not None else (run.stages() if run else STAGE_ORDER))
    need = roles_needed(stages)
    lines = ["Before I initialize this task, assign the roles.", ""]
    if run is not None or stages != STAGE_ORDER:
        chosen = "  →  ".join(STAGE_LABEL[s] for s in stages)
        lines += [f"Plan for this run: {chosen}"]
        skipped = [s for s in STAGE_ORDER if s not in set(stages)]
        if skipped:
            lines += [f"Not doing: {', '.join(STAGE_LABEL[s] for s in skipped)}"]
        lines += [""]
    fixed = run.orchestrator() if run is not None else None
    lines += [IDENTITY_MENU, "", "Choose:"]
    for role, label, _multi in ROLE_PROMPTS:
        if role not in need:
            continue
        if role == "orchestrator" and fixed:
            lines.append(f"- {label}: {AGENT_LABELS.get(fixed, fixed)}  (already chosen)")
            continue
        lines.append(f"- {label}{ROLE_LINE_SUFFIX.get(role, ':')}")
    lines += [
        "",
        'An identity may hold more than one role. Use "none" where a role is unnecessary.',
        "I will not initialize the task or access connected systems until you confirm.",
    ]
    return "\n".join(lines)


ORCHESTRATOR_QUESTION = """Who orchestrates this run?

The orchestrator reads your request, proposes what the run should actually do,
and holds the engagement together. Pick it before you state the ask — it is the
identity that will interpret the ask.

  Claude: work          Claude: msc          Claude: alt
  Claude Code: Bedrock  ChatGPT/Codex

Gemini and Microsoft Copilot cannot orchestrate: Gemini is a one-shot headless
call with no session state, and Copilot is a chat endpoint over the Microsoft
estate. Either can still hold research, review or context roles.

Nothing is read by choosing. Nothing is read until roles are confirmed."""


PLAN_QUESTION = """What do you want done for this requirement?

Say it however you like — "research this and get it reviewed", "just the slides
and a Jira breakdown", "the full thing". The stages available are:

  intake                what the ask actually is; loads client context
  research              evidence, prior art, gaps
  solution architecture options with their costs, and an ADR
  adversarial review    someone whose job is to find what is wrong
  reconciliation        deciding which objections stand, and saying so
  presentation          slides for the stakeholder conversation
  development plan      breakdown, estimates, and a Jira preview (not Jira issues)
  implementation        code, behind a one-time approval
  verification          independent tests, standards/security checks, CI evidence
  deployment            approved release and rollback evidence
  observability         telemetry, SLOs, alerts, dashboards and runbooks
  publication           the step where other people start seeing it

Nothing is read until roles are confirmed, and roles come after this."""

ALIASES = {
    "claude: work": "claude_work", "claude work": "claude_work", "work": "claude_work",
    "claude: msc": "claude_msc", "claude msc": "claude_msc", "msc": "claude_msc",
    "claude: alt": "claude_alt", "claude alt": "claude_alt", "alt": "claude_alt",
    "claude code: bedrock": "claude_bedrock", "bedrock": "claude_bedrock",
    "chatgpt/codex": "chatgpt_codex", "chatgpt": "chatgpt_codex", "codex": "chatgpt_codex",
    "gemini": "gemini",
    "microsoft copilot": "microsoft_copilot", "ms copilot": "microsoft_copilot",
    "copilot": "microsoft_copilot", "m365 copilot": "microsoft_copilot",
    "exclude": "none", "include": "microsoft_copilot",
}

# Stage names people actually type, mapped to the canonical ones.
STAGE_ALIASES = {
    "context": "intake", "load": "intake", "scope": "intake",
    "research": "research", "discovery": "research", "investigate": "research",
    "architecture": "solutioning", "solution": "solutioning", "design": "solutioning",
    "adr": "solutioning", "solutioning": "solutioning",
    "review": "review", "critique": "review", "validate": "review", "validation": "review",
    "reconcile": "reconciliation", "reconciliation": "reconciliation",
    "presentation": "presentation", "present": "presentation", "slides": "presentation",
    "deck": "presentation",
    "plan": "planning", "planning": "planning", "delivery": "planning",
    "breakdown": "planning", "jira": "planning", "development-plan": "planning",
    "implementation": "implementation", "implement": "implementation", "build": "implementation",
    "code": "implementation",
    "verification": "verification", "verify": "verification", "test": "verification",
    "deployment": "deployment", "deploy": "deployment", "release": "deployment",
    "observability": "observability", "monitoring": "observability", "operate": "observability",
    "publication": "publication", "publish": "publication",
}


def resolve_stage(token):
    s = (token or "").strip().lower().replace("_", "-").replace(" ", "-")
    if s in STAGE_ORDER:
        return s
    if s in STAGE_ALIASES:
        return STAGE_ALIASES[s]
    die(f"unknown stage '{token}'. Known: {', '.join(STAGE_ORDER)}\n"
        f"       shapes: {', '.join(SHAPES)}", 2)


def resolve_shape(name):
    """A shape name, or several joined with '+'."""
    stages = []
    for part in str(name).split("+"):
        part = part.strip().lower()
        if part not in SHAPES:
            die(f"unknown shape '{part}'. Known: {', '.join(SHAPES)}", 2)
        stages += SHAPES[part]
    return [s for s in STAGE_ORDER if s in set(stages)]


def resolve_agent(agents, token):
    t = (token or "").strip()
    if t.lower() in ("", "none", "-", "n/a"):
        return None
    if t in agents["agents"]:
        return t
    a = ALIASES.get(t.lower())
    if a == "none":
        return None
    if a:
        return a
    die(f"unknown identity '{token}'. Known: {', '.join(sorted(agents['agents']))}", 2)


# -------------------------------------------------------------- run commands --


def cmd_start(args):
    req = " ".join(args.requirement or []).strip()
    run = new_run(req)
    print(f"run    {run.id}")
    print(f"dir    {run.dir}")
    print(f"state  awaiting_orchestrator\n")
    print("Nothing has been read: no Jira, Confluence, SharePoint, email, repository")
    print("or client context. That stays true until roles are confirmed.\n")

    if args.orchestrator:
        return _set_orchestrator(run, args.orchestrator, shape=args.shape)

    print("-" * 72)
    print(ORCHESTRATOR_QUESTION)
    print("-" * 72)
    print(f"\n  fde orchestrator {run.id} <identity>        (work | msc | alt | bedrock | codex)")
    if not req:
        print(f"\nYou can state the ask now or after choosing:")
        print(f"  fde request {run.id} \"<what you want>\"")
    return 0


def _set_orchestrator(run, token, shape=None):
    agents = load_agents()
    aid = resolve_agent(agents, token)
    if not aid:
        die("give an identity to orchestrate this run", 2)
    a = agents["agents"][aid]
    if "orchestration" not in a.get("capabilities", []):
        die(f"{agent_label(agents, aid)} cannot orchestrate — it has no 'orchestration' "
            f"capability.\n       Candidates: "
            + ", ".join(agent_label(agents, k) for k, v in agents["agents"].items()
                        if "orchestration" in v.get("capabilities", [])), 2)
    ok, detail = agent_available(agents, aid)
    if not ok:
        die(f"{agent_label(agents, aid)} is not available on this machine: {detail}\n"
            f"       Choose another orchestrator.", 3)

    doc = run.roles() or {}
    existing = doc.get("assignments", {})
    existing["orchestrator"] = aid
    doc["assignments"] = existing
    doc["orchestratorChosenAt"] = iso()
    write_json(run.roles_path, doc)
    run.event("orchestrator.chosen", agent=aid)
    if run.state == "awaiting_orchestrator":
        run.set_state("awaiting_plan", f"orchestrator: {aid}")

    print(f"orchestrator  {agent_label(agents, aid)}")

    if shape:
        return _record_plan(run, resolve_shape(shape), intent=f"--shape {shape}", source="shape")

    if not (run.dir / "requirement.md").exists():
        print(f"\nNow state the ask:\n  fde request {run.id} \"<what you want done>\"")
        return 0

    print(f"\nask    {run.manifest().get('requirement', '')[:200]}\n")
    print("-" * 72)
    print(PLAN_QUESTION)
    print("-" * 72)
    print(f"\nHave {agent_label(agents, aid)} propose a plan, then record it:")
    print(f"  fde plan {run.id} --stages <stages>       (or --shape <name>)")
    return 0


def cmd_orchestrator(args):
    run = Run(args.run_id)
    if not args.identity:
        agents = load_agents()
        cur = run.orchestrator()
        if cur:
            print(f"orchestrator  {agent_label(agents, cur)}")
            return 0
        print(ORCHESTRATOR_QUESTION)
        print(f"\n  fde orchestrator {run.id} <identity>")
        return 0
    if run.orchestrator() and not args.reassign:
        die(f"run {run.id} is already orchestrated by "
            f"{agent_label(load_agents(), run.orchestrator())}. "
            "Pass --reassign to change it.", 5)
    return _set_orchestrator(run, args.identity, shape=args.shape)


def cmd_request(args):
    run = Run(args.run_id)
    text = " ".join(args.text).strip()
    if not text:
        die("say what you want done", 2)
    run.guard_orchestrator("recording the request")
    run.write_requirement(text)
    run.event("request.recorded", chars=len(text))
    agents = load_agents()
    print(f"run    {run.id}")
    print(f"ask    {text[:200]}\n")
    print("-" * 72)
    print(PLAN_QUESTION)
    print("-" * 72)
    print(f"\nHave {agent_label(agents, run.orchestrator())} propose a plan, then record it:")
    print(f"  fde plan {run.id} --stages <stages>       (or --shape <name>)")
    return 0


def cmd_list(args):
    runs = list_runs()
    if not runs:
        print("no runs yet — fde start")
        return 0
    for m in runs:
        print(f"  {m.get('runId','?'):<38} {m.get('state','?'):<26} "
              f"{(m.get('requirement') or '(not stated)')[:40]}")
    return 0


def _record_plan(run, stages, intent="", source="flags", amend=False):
    stages = [s for s in STAGE_ORDER if s in set(stages)]
    if not stages:
        die("a plan needs at least one stage", 2)
    warnings = prereq_warnings(stages)

    plan = {
        "confirmedAt": iso(),
        "intent": intent,
        "stages": stages,
        "skipped": [s for s in STAGE_ORDER if s not in set(stages)],
        "rolesNeeded": roles_needed(stages),
        "warnings": warnings,
        "source": source,
    }
    write_json(run.plan_path, plan)
    run.event("plan.amended" if amend else "plan.confirmed",
              stages=stages, intent=intent[:200], source=source)

    print(f"plan   {run.plan_line()}")
    if plan["skipped"]:
        print(f"skip   {', '.join(STAGE_LABEL[s] for s in plan['skipped'])}")
    for w in warnings:
        print(f"note   {w}")

    if run.state == "awaiting_plan":
        run.set_state("awaiting_roles", "plan confirmed by the user")
    elif run.state == "awaiting_orchestrator":
        die("choose an orchestrator first", 6)

    missing = [r for r in plan["rolesNeeded"] if not run.assignees(r)]
    if run.planned() and run.roles_confirmed() and not missing:
        print(f"\nstate  {run.state}")
        print(f"next   fde resume {run.id}")
        return 0

    print()
    print("-" * 72)
    print(role_question(run, stages=stages))
    print("-" * 72)
    print(f"\nThen:  fde roles {run.id} {role_set_hint(run)}")
    return 0


def cmd_plan(args):
    run = Run(args.run_id)
    if args.stages or args.shape or args.add or args.remove:
        run.guard_orchestrator("scoping the run")
        if not (run.dir / "requirement.md").exists():
            die(f"run {run.id} has no stated ask yet.\n"
                f'       run: fde request {run.id} "<what you want done>"', 6)

    if args.show or not (args.stages or args.shape or args.add or args.remove):
        plan = run.plan()
        if not plan:
            print(f"run {run.id} has no plan yet.\n")
            print(PLAN_QUESTION)
            print(f"\n  fde plan {run.id} --stages research,review,presentation")
            print(f"  fde plan {run.id} --shape research")
            return 0
        print(f"\nrun    {run.id}")
        print(f"intent {plan.get('intent') or '(none recorded)'}")
        print(f"plan   {run.plan_line()}")
        if plan["skipped"]:
            print(f"skip   {', '.join(STAGE_LABEL[s] for s in plan['skipped'])}")
        print(f"roles  {', '.join(plan['rolesNeeded'])}")
        for w in plan.get("warnings", []):
            print(f"note   {w}")
        print()
        return 0

    amend = run.planned()
    if args.shape:
        stages = resolve_shape(args.shape)
    elif args.stages:
        stages = []
        for chunk in args.stages:
            stages += [resolve_stage(x) for x in chunk.split(",") if x.strip()]
    else:
        stages = list(run.stages()) if amend else []

    for x in (args.add or []):
        for one in x.split(","):
            if one.strip():
                stages.append(resolve_stage(one))
    for x in (args.remove or []):
        for one in x.split(","):
            if one.strip():
                s = resolve_stage(one)
                stages = [y for y in stages if y != s]

    stages = [s for s in STAGE_ORDER if s in set(stages)]

    if amend and run.state not in ("awaiting_plan", "awaiting_roles", "roles_confirmed"):
        seq = run.sequence()
        pos = seq.index(run.state) if run.state in seq else 0
        gone_by = [s for s in stages
                   if s not in run.stages()
                   and s in state_sequence(stages)
                   and state_sequence(stages).index(s) < pos]
        if gone_by:
            die(f"this run is already at '{run.state}'; it cannot go back and do "
                f"{', '.join(STAGE_LABEL[s] for s in gone_by)}.\n"
                f"       Do that work out of band, or start a fresh run for it.", 5)
        for s in set(run.stages()) - set(stages):
            if s in seq and seq.index(s) <= pos:
                die(f"'{STAGE_LABEL[s]}' has already been passed and cannot be removed "
                    f"from the plan.", 5)

    return _record_plan(run, stages, intent=args.intent or "", 
                        source="shape" if args.shape else "flags", amend=amend)


def cmd_shapes(args):
    print("\nNamed shapes — shorthand for the plans that come up often.\n")
    width = max(len(s) for s in SHAPES)
    for name, stages in SHAPES.items():
        chain = "  →  ".join(STAGE_LABEL[s] for s in stages)
        print(f"  {name:<{width}}  {chain}")
    print("\nCombine them with '+':  fde start MAX-1 --shape presentation+delivery-plan")
    print("Or name stages directly: fde plan <run-id> --stages research,review,presentation")
    print(f"\nStages: {', '.join(STAGE_ORDER)}\n")
    return 0


def cmd_roles(args):
    agents = load_agents()
    run = Run(args.run_id)
    run.guard_plan("assigning roles")
    if run.state not in ("awaiting_roles", "roles_confirmed", "blocked") and not args.reassign:
        die(f"run {run.id} already has confirmed roles (state {run.state}). "
            "Pass --reassign to change them, or start a new run.", 5)

    needed = run.roles_needed()
    prompts = [(r, l, m) for r, l, m in ROLE_PROMPTS if r in needed]
    chosen = {}

    if args.same_as:
        # Valid only because the user said so explicitly on the command line.
        prev = Run(args.same_as)
        pr = prev.roles()
        if not pr:
            die(f"run {args.same_as} has no confirmed roles to copy", 4)
        chosen = {k: v for k, v in pr["assignments"].items() if k in needed}
        print(f"copying the role assignment the user explicitly named: {args.same_as}")
    elif args.from_file:
        data = read_json(pathlib.Path(args.from_file))
        if not data:
            die(f"cannot read role assignments from {args.from_file}", 2)
        chosen = dict(data.get("assignments", data))
    elif args.set:
        for pair in args.set:
            if "=" not in pair:
                die(f"--set expects role=identity, got '{pair}'", 2)
            role, val = pair.split("=", 1)
            role = role.strip()
            if role not in ALL_ROLES:
                die(f"unknown role '{role}'. Known: {', '.join(ALL_ROLES)}", 2)
            if role not in needed:
                die(f"'{role}' is not a role this run needs — its plan is "
                    f"{run.plan_line()}.\n"
                    f"       Roles needed: {', '.join(needed)}\n"
                    f"       To widen the run: fde plan {run.id} --add <stage>", 2)
            parts = [p for p in (v.strip() for v in val.split(",")) if p]
            chosen[role] = parts if role in MULTI_ROLES else (parts[0] if parts else "none")
    else:
        if not sys.stdin.isatty():
            print(role_question(run))
            die("\nno assignment given. Re-run with --set role=identity ... , "
                "--from roles.json, or interactively from a terminal.", 2)
        print(role_question(run))
        print()
        already = (run.roles() or {}).get("assignments", {})
        for role, label, multi in prompts:
            if already.get(role):
                continue
            raw = input(f"  {label}{ROLE_LINE_SUFFIX.get(role, '')}: ").strip()
            parts = [p for p in (v.strip() for v in raw.split(",")) if p]
            chosen[role] = parts if multi else (parts[0] if parts else "none")

    # Resolve, validate capability, check availability.
    assignments, unavailable = {}, []
    cap_of = agents.get("roleCapability", {})
    for role, _label, multi in prompts:
        if role not in chosen:
            continue
        raw = chosen[role]
        toks = raw if isinstance(raw, list) else [raw]
        ids = [x for x in (resolve_agent(agents, tk) for tk in toks) if x]
        for aid in ids:
            need = cap_of.get(role)
            caps = agents["agents"][aid].get("capabilities", [])
            if need and need not in caps:
                die(f"{agent_label(agents, aid)} cannot hold the '{role}' role — "
                    f"it has no '{need}' capability. Choose another identity.", 2)
            ok, detail = agent_available(agents, aid)
            if not ok:
                unavailable.append((role, aid, detail))
        assignments[role] = (ids if multi else (ids[0] if ids else None)) if ids else ([] if multi else None)

    if unavailable and not args.allow_unavailable:
        print("\nStopping: an assigned identity is not available on this machine.\n")
        for role, aid, detail in unavailable:
            print(f"  {role:<18} {agent_label(agents, aid):<26} {detail}")
        die("\n       Choose a replacement and re-run, or pass --allow-unavailable "
            "if you will make it available before that stage runs.", 3)

    existing_now = (run.roles() or {}).get("assignments", {})
    if not (assignments.get("orchestrator") or existing_now.get("orchestrator")):
        die(f"a run needs an orchestrator — that role cannot be 'none'.\n"
            f"       run: fde orchestrator {run.id} <identity>", 2)

    merged = dict(existing_now)
    merged.update({k: v for k, v in assignments.items() if v})
    missing = [r for r in needed
               if r not in OPTIONAL_ROLES
               and not (merged.get(r) if isinstance(merged.get(r), list)
                        else [merged.get(r)] if merged.get(r) else [])]
    if missing and not args.allow_unassigned:
        die(f"this run's plan needs {', '.join(missing)}, which you left unassigned.\n"
            f"       Plan: {run.plan_line()}\n"
            f"       Either assign them, drop the stage "
            f"(fde plan {run.id} --remove <stage>), or pass --allow-unassigned.", 2)

    doc = run.roles() or {}
    existing = doc.get("assignments", {})
    existing.update(assignments)
    doc["assignments"] = existing
    doc["confirmedAt"] = iso()
    write_json(run.roles_path, doc)
    run.event("roles.confirmed", assignments=assignments,
              source=("same-as:" + args.same_as) if args.same_as else
                     ("file:" + args.from_file) if args.from_file else
                     ("flags" if args.set else "interactive"))
    if run.state == "awaiting_roles":
        run.set_state("roles_confirmed", "roles assigned by the user")

    # Role-restricted connectors become available now, and only to the holder.
    sync = SHARED / "bin" / "mcp-sync"
    if sync.exists():
        r = subprocess.run([sys.executable, str(sync), "--run", run.id],
                           capture_output=True, text=True)
        if r.returncode == 0:
            run.event("mcp.run-scoped", detail=r.stdout.strip()[:400])
        else:
            print(f"  (run-scoped MCP config not written: {r.stderr.strip()[:200]})", file=sys.stderr)

    print(f"\nroles confirmed for {run.id}")
    print(f"plan   {run.plan_line()}\n")
    for role, label, _m in prompts:
        v = existing.get(role)
        shown = ", ".join(agent_label(agents, x) for x in v) if isinstance(v, list) else (
            agent_label(agents, v) if v else "none")
        print(f"  {label:<28} {shown or 'none'}")
    print(f"\nstate  {run.state}")
    print(f"next   fde resume {run.id}")
    return 0


STAGE_HINT = {
    "intake": "fde invoke {id} <agent> tasks/intake.md",
    "research": "fde invoke {id} <agent> tasks/research.md",
    "solutioning": "fde invoke {id} <agent> tasks/solutioning.md",
    "review": "fde invoke {id} <agent> tasks/review.md",
    "reconciliation": "orchestrator reconciles → artifacts/review/reconciliation.md",
    "presentation": "presentation author builds artifacts/presentation/solution-presentation.pptx",
    "planning": "write development-plan.md and jira-plan.json (preview only — no Jira issues yet)",
    "implementation": "fde invoke {id} <agent> artifacts/implementation/implementation-task.md --write",
    "verification": "write verification-report.md, then: fde checkpoint {id} --stage verification --status pass --evidence artifacts/implementation/verification-report.md",
    "deployment": "release manager deploys the approved release and writes artifacts/deployment/deployment-report.md",
    "observability": "SRE verifies telemetry, writes observability-plan.md, then records a passing checkpoint",
    "publication": "publish only what was approved, then: fde resume {id} --advance complete",
    "awaiting_implementation_approval":
        "fde approve-codex {id} implementation --task-file <file> --repo <path>",
    "awaiting_deployment_approval":
        "fde approve-publish {id} deployment --summary '<environment and release>'",
    "awaiting_publication_approval":
        "fde approve-publish {id} <jira|confluence|sharepoint|bitbucket|email|teams>",
}


def next_action(run):
    state = run.state
    if state == "awaiting_orchestrator":
        return f"fde orchestrator {run.id} <identity>   — work | msc | alt | bedrock | codex"
    if state == "awaiting_plan":
        if not (run.dir / "requirement.md").exists():
            return f'fde request {run.id} "<what you want done>"'
        return f"fde plan {run.id} --stages <stages>   — scope the work; reads nothing"
    if state == "awaiting_roles":
        return f"fde roles {run.id} {role_set_hint(run)}"
    if state == "blocked":
        return f"fde resume {run.id} --unblock"
    if state == "complete":
        return "nothing — run is closed"
    if state == "roles_confirmed":
        nxt = run.next_state()
        return f"fde resume {run.id} --advance {nxt}" if nxt else "nothing left in this plan"
    hint = STAGE_HINT.get(state)
    if hint:
        return hint.format(id=run.id)
    return f"fde resume {run.id} --advance {run.next_state() or 'complete'}"


def role_set_hint(run):
    """The --set flags still outstanding. The orchestrator was chosen first, so it
    is not among them."""
    have = (run.roles() or {}).get("assignments", {})
    out = []
    for r in run.roles_needed():
        if have.get(r):
            continue
        out.append(f"--set {r}=" + ("none" if r in OPTIONAL_ROLES else "<identity>"))
    return " ".join(out)


def artifact_report(run):
    """Only the artifacts this run's plan is actually going to produce."""
    out = []
    for stage in run.stages():
        for sub, name in STAGE_ARTIFACTS.get(stage, []):
            base = run.dir if sub == "." else run.artifacts_dir / sub
            path = base / name
            found = path.exists()
            if not found and name.endswith(".pptx"):
                alts = list(base.glob("solution-presentation.*"))
                if alts:
                    found, name = True, alts[0].name
            label = name if sub == "." else f"{sub}/{name}"
            out.append((stage, label, found))
    return out


def cmd_status(args):
    agents = load_agents()
    run = Run(args.run_id)
    m = run.manifest()
    print(f"\nrun        {run.id}")
    print(f"state      {m.get('state')}" + (f"  (blocked from {m['blockedFrom']})" if m.get("blockedFrom") else ""))
    print(f"created    {m.get('createdAt')}")
    print(f"jira       {m.get('jiraKey') or '(none)'}")
    print(f"dir        {run.dir}")
    _who = run.orchestrator()
    print(f"orchestr.  {agent_label(agents, _who) if _who else '(not chosen yet)'}")

    plan = run.plan()
    print("\nplan")
    if not plan:
        print("  none — this run has not been scoped yet")
        print(f"  fde plan {run.id} --stages <stages>")
    else:
        if plan.get("intent"):
            print(f"  asked for  {plan['intent'][:200]}")
        seq = run.sequence()
        here = m.get("state")
        pos = seq.index(here) if here in seq else -1
        for s in run.stages():
            mark = "done" if here in seq and seq.index(s) < pos else (
                "now " if s == here else "    ")
            print(f"  [{mark}] {STAGE_LABEL[s]}")
        if plan.get("skipped"):
            print(f"  not doing: {', '.join(STAGE_LABEL[s] for s in plan['skipped'])}")
        for w in plan.get("warnings", []):
            print(f"  note: {w}")

    r = run.roles()
    print("\nroles")
    if not r:
        print("  none assigned — this run may not read Jira, Confluence, SharePoint,")
        print("  email, repositories or client context yet.")
    else:
        print(f"  confirmed  {r.get('confirmedAt') or '(orchestrator only, so far)'}")
        for role, label, _m in ROLE_PROMPTS:
            if role not in run.roles_needed():
                continue
            v = r["assignments"].get(role)
            shown = ", ".join(agent_label(agents, x) for x in v) if isinstance(v, list) else (
                agent_label(agents, v) if v else "none")
            print(f"  {label:<28} {shown or 'none'}")

    report = artifact_report(run)
    print("\nartifacts")
    if not report:
        print("  none expected from this plan")
    for _stage, name, found in report:
        print(f"  [{'x' if found else ' '}] {name}")

    apps = approval_state(run)
    print("\napprovals")
    if not apps:
        print("  none")
    for aid, a in apps.items():
        st = approval_status(a)
        kind = "codex" if a["type"] == "codex-approval" else "publish"
        what = a.get("stage") or a.get("target")
        print(f"  {aid}  {kind:<8} {what:<16} {st:<9} expires {a.get('expiresAt')}")

    checkpoints = run.checkpoints()
    print("\ncheckpoints")
    if not checkpoints:
        print("  none")
    for c in checkpoints[-6:]:
        print(f"  {c.get('checkpointId','?')}  {c.get('stage','?'):<16} "
              f"{c.get('status','?'):<12} {len(c.get('evidence') or [])} evidence item(s)")

    ev = run.events()
    print(f"\nevents ({len(ev)}) — last 6")
    for e in ev[-6:]:
        extra = e.get("to") or e.get("agent") or e.get("target") or e.get("note", "")
        print(f"  {e['at']}  {e['event']:<22} {str(extra)[:60]}")

    print(f"\nnext\n  {next_action(run)}\n")
    return 0


def cmd_resume(args):
    run = Run(args.run_id)
    m = run.manifest()
    if args.block:
        run.set_state("blocked", args.block)
        print(f"{run.id} -> blocked: {args.block}")
        return 0
    if args.unblock:
        if m.get("state") != "blocked":
            die(f"run {run.id} is not blocked", 5)
        back = m.get("blockedFrom") or "roles_confirmed"
        run.set_state(back, "unblocked")
        print(f"{run.id} -> {back}")
        return 0
    if args.advance or args.next:
        if not run.roles_confirmed():
            run.guard_roles("advancing the pipeline")
        target = args.advance or run.next_state()
        if not target:
            die(f"run {run.id} has nothing after '{run.state}' in its plan", 5)
        old = run.set_state(target, args.reason or "advanced by the orchestrator")
        print(f"{run.id}: {old} -> {target}")
        return 0

    print(f"\nrun    {run.id}")
    print(f"state  {m.get('state')}")
    print(f"ask    {m.get('requirement','') or '(not stated yet)'}"[:220])
    agents = load_agents()
    who = run.orchestrator()
    print(f"orch   {agent_label(agents, who) if who else '(not chosen yet)'}")
    if not who:
        print("\n" + "-" * 72)
        print(ORCHESTRATOR_QUESTION)
        print("-" * 72)
        print(f"\n  {next_action(run)}")
        return 0
    if not run.planned():
        print("\nThis run has not been scoped yet.\n")
        print("-" * 72)
        print(PLAN_QUESTION)
        print("-" * 72)
        print(f"\n  fde plan {run.id} --stages <stages>")
        return 0
    print(f"plan   {run.plan_line()}")
    if not run.roles_confirmed():
        print("\nRoles are not confirmed. Ask again — do not reuse the previous run's roles.\n")
        print("-" * 72)
        print(role_question(run))
        print("-" * 72)
        print(f"\n  {next_action(run)}")
        return 0
    done = [n for _s, n, f in artifact_report(run) if f]
    print(f"\ndone   {len(done)} artifact(s): {', '.join(done) or 'none yet'}")
    print(f"\nnext\n  {next_action(run)}\n")
    return 0


def cmd_guard(args):
    """Called by skills before touching anything external."""
    run = Run(args.run_id)
    run.guard_roles(args.activity)
    if args.role:
        who = run.assignees(args.role)
        if not who:
            die(f"no identity holds the '{args.role}' role in run {run.id}", 6)
        print(" ".join(who))
    else:
        print("ok")
    return 0


# ------------------------------------------------------------- codex gating --


def _resolve_task_file(run: Run, given: str) -> pathlib.Path:
    p = pathlib.Path(given).expanduser()
    if not p.is_absolute():
        cand = run.dir / given
        p = cand if cand.exists() else p.resolve()
    if not p.is_file():
        die(f"no task file at {p}", 2)
    return p


def _branch(repo: pathlib.Path):
    r = _git(["rev-parse", "--abbrev-ref", "HEAD"], repo)
    if r is None or r.returncode != 0:
        return "(not a git repository)"
    out = r.stdout.strip()
    wt = _git(["rev-parse", "--show-toplevel"], repo)
    top = wt.stdout.strip() if wt and wt.returncode == 0 else str(repo)
    return f"{out}  (worktree {top})"


def cmd_approve_codex(args):
    run = Run(args.run_id)
    run.guard_roles("approving a Codex invocation")
    stage = args.stage
    if stage not in STAGE_ORDER:
        die(f"unknown stage '{stage}'. Known: {', '.join(STAGE_ORDER)}", 2)
    if stage not in run.stages():
        die(f"'{STAGE_LABEL[stage]}' is not in this run's plan ({run.plan_line()}).\n"
            f"       Widen it first: fde plan {run.id} --add {stage}", 5)
    if "chatgpt_codex" not in run.assignees("implementation") and stage in ("implementation", "verification"):
        die(f"Codex does not hold the implementation role in run {run.id}. "
            "Assign it first, or approve a different agent's work.", 6)

    task = _resolve_task_file(run, args.task_file)
    digest = sha256_file(task)
    repo = pathlib.Path(args.repo or os.getcwd()).expanduser().resolve()
    if not repo.is_dir():
        die(f"repository path is not a directory: {repo}", 2)
    writable = pathlib.Path(args.writable_root or repo).expanduser().resolve()
    try:
        writable.relative_to(repo)
    except ValueError:
        die(f"writable root {writable} is outside the repository {repo}. "
            "Widening the sandbox needs a different repository path, not a broader root.", 2)
    body = task.read_text(encoding="utf-8", errors="replace")
    summary = args.summary or next((l.strip() for l in body.splitlines() if l.strip()), "(empty task)")
    ttl = int(args.ttl or DEFAULT_APPROVAL_TTL_MIN)
    issued = now()
    expires = issued + _dt.timedelta(minutes=ttl)

    print()
    print("=" * 72)
    print("  CODEX WRITE APPROVAL REQUEST")
    print("=" * 72)
    print(f"  Run ID          {run.id}")
    print(f"  Stage           {stage}")
    print(f"  Repository      {repo}")
    print(f"  Branch          {_branch(repo)}")
    print(f"  Writable root   {writable}")
    print(f"  Network         {'REQUESTED' if args.network else 'disabled'}")
    print(f"  Task file       {task}")
    print(f"  Task sha256     {digest}")
    print(f"  Task summary    {summary[:200]}")
    print(f"  Commands/tests  {args.commands or '(none declared)'}")
    print("  Sandbox         workspace-write, non-interactive, no auto-approval flag")
    print(f"  Approval        one-time, expires {iso(expires)} ({ttl} min)")
    print("-" * 72)
    print("  This authorises exactly this task file, in this repository, once.")
    print("  Any change to the task file invalidates it. Network access, another")
    print("  repository or a broader writable root need a new approval.")
    print("=" * 72)
    if args.network:
        print("\n  NOTE: network access is off by default and this toolkit does not")
        print("  enable it. Approving here records the request; the sandbox still")
        print("  runs without network. Do that step yourself if you truly need it.")

    require_typed_confirmation(f"APPROVE CODEX {run.id}")

    approval_id = secrets.token_hex(6)
    append_jsonl(run.approvals_path, {
        "type": "codex-approval",
        "approvalId": approval_id,
        "runId": run.id,
        "stage": stage,
        "taskFile": str(task),
        "taskFileHash": digest,
        "repositoryPath": str(repo),
        "writableRoot": str(writable),
        "network": bool(args.network),
        "commands": args.commands or "",
        "issuedAt": iso(issued),
        "expiresAt": iso(expires),
        "consumed": False,
    })
    run.event("approval.codex.granted", approvalId=approval_id, stage=stage,
              repositoryPath=str(repo), taskFileHash=digest, expiresAt=iso(expires))
    if stage == "implementation" and run.state == "awaiting_implementation_approval":
        run.set_state("implementation", f"codex approval {approval_id}")
    print(f"\napproved  {approval_id}  valid until {iso(expires)}  (one use)")
    return 0


def cmd_consume_approval(args):
    """Internal. Called by ask-codex immediately before launching Codex."""
    run = Run(args.run_id)
    task = _resolve_task_file(run, args.task_file)
    digest = sha256_file(task)
    apps = approval_state(run)
    candidates = [a for a in apps.values()
                  if a["type"] == "codex-approval" and a.get("stage") == args.stage]
    if not candidates:
        run.event("approval.codex.denied", stage=args.stage, reason="no approval on record")
        die(f"no Codex write approval on record for run {run.id} stage '{args.stage}'.\n"
            f"       run: fde approve-codex {run.id} {args.stage} --task-file {args.task_file}", 7)

    reasons = []
    for a in sorted(candidates, key=lambda x: x["issuedAt"], reverse=True):
        if a.get("taskFileHash") != digest:
            reasons.append(f"{a['approvalId']}: task file changed since approval")
            continue
        st = approval_status(a)
        if st != "valid":
            reasons.append(f"{a['approvalId']}: approval {st}")
            continue
        # Consume BEFORE the process starts. A crash after this point costs one
        # approval; the alternative costs an unbounded number of writes.
        append_jsonl(run.approvals_path, {
            "type": "codex-approval-consumed", "approvalId": a["approvalId"], "at": iso()})
        run.event("approval.codex.consumed", approvalId=a["approvalId"], stage=args.stage,
                  taskFileHash=digest)
        print(json.dumps({
            "approvalId": a["approvalId"],
            "repositoryPath": a["repositoryPath"],
            "writableRoot": a["writableRoot"],
            "network": bool(a.get("network")),
            "taskFile": str(task),
        }))
        return 0

    run.event("approval.codex.denied", stage=args.stage, reason="; ".join(reasons))
    die("Codex write refused. No usable approval:\n       " + "\n       ".join(reasons) +
        f"\n       run: fde approve-codex {run.id} {args.stage} --task-file {args.task_file}", 7)


# ---------------------------------------------------------- publish gating --


def cmd_approve_publish(args):
    run = Run(args.run_id)
    run.guard_roles("approving a publication")
    target = args.target.lower()
    if target not in PUBLICATION_TARGETS:
        die(f"unknown target '{target}'. Known: {', '.join(PUBLICATION_TARGETS)}", 2)
    ttl = int(args.ttl or DEFAULT_APPROVAL_TTL_MIN)
    issued = now()
    expires = issued + _dt.timedelta(minutes=ttl)
    items = []
    if args.items:
        p = _resolve_task_file(run, args.items)
        items = [l.strip() for l in p.read_text(encoding="utf-8").splitlines() if l.strip()]

    print()
    print("=" * 72)
    print("  PUBLICATION APPROVAL REQUEST — this writes outside your machine")
    print("=" * 72)
    print(f"  Run ID     {run.id}")
    print(f"  Target     {target}")
    print(f"  Summary    {args.summary or '(none given)'}")
    if items:
        print(f"  Items      {len(items)}")
        for i in items[:12]:
            print(f"             - {i[:80]}")
        if len(items) > 12:
            print(f"             ... and {len(items) - 12} more")
    print(f"  Expires    {iso(expires)} ({ttl} min, one use)")
    print("=" * 72)
    print("  A plan existing is not a reason to create anything. This is the")
    print("  step where other people start seeing your output.")

    require_typed_confirmation(f"APPROVE PUBLISH {run.id}")

    approval_id = secrets.token_hex(6)
    append_jsonl(run.approvals_path, {
        "type": "publication-approval",
        "approvalId": approval_id,
        "runId": run.id,
        "target": target,
        "summary": args.summary or "",
        "items": items,
        "issuedAt": iso(issued),
        "expiresAt": iso(expires),
        "consumed": False,
    })
    run.event("approval.publish.granted", approvalId=approval_id, target=target)

    manifest_path = run.dir / "publication-manifest.json"
    man = read_json(manifest_path, {"runId": run.id, "entries": []})
    man["entries"].append({"approvalId": approval_id, "target": target,
                           "summary": args.summary or "", "items": items,
                           "approvedAt": iso(issued), "published": False})
    write_json(manifest_path, man)
    if target == "deployment" and run.state == "awaiting_deployment_approval":
        run.set_state("deployment", f"deployment approval {approval_id}")
    elif run.state == "awaiting_publication_approval" and target != "deployment":
        run.set_state("publication", f"publication approval {approval_id}")
    print(f"\napproved  {approval_id}  target {target}  valid until {iso(expires)}")
    print(f"manifest  {manifest_path}")
    return 0


# ------------------------------------------------------------------- invoke --


def _bin(name):
    local = SHARED / "bin" / name
    return str(local) if local.exists() else (shutil.which(name) or str(local))


def build_invocation(agents, run: Run, agent_id: str, stage: str, task: pathlib.Path, write: bool):
    a = agents["agents"][agent_id]
    kind = a.get("kind")
    body = task.read_text(encoding="utf-8", errors="replace")
    env = {}
    if kind == "claude":
        prof = a["profile"]
        env["CLAUDE_CONFIG_DIR"] = str(PROFILES_DIR / prof)
        env["CLAUDE_PROFILE"] = prof
        if prof == "bedrock":
            env["CLAUDE_CODE_USE_BEDROCK"] = "1"
        return ["claude", "-p", body], env
    if kind == "codex":
        if write:
            return [_bin("ask-codex"), "--write", "--run", run.id,
                    "--stage", stage, "--task-file", str(task)], env
        return [_bin("ask-codex"), "--read-only", "--task-file", str(task)], env
    if kind == "gemini":
        return [_bin("ask-gemini"), body], env
    if kind == "copilot-studio":
        return [_bin("ask-ms-copilot"), body], env
    die(f"no invocation defined for kind '{kind}'", 2)


def cmd_invoke(args):
    agents = load_agents()
    run = Run(args.run_id)
    run.guard_plan("invoking an agent")
    run.guard_roles("invoking an agent")

    agent_id = resolve_agent(agents, args.agent_id)
    if not agent_id:
        die("give an identity to invoke", 2)
    stage = args.stage or (run.state if run.state in STAGE_ORDER else None)
    if not stage:
        die(f"run is in state '{run.state}', which is not a stage an agent runs.\n"
            f"       This run's plan: {run.plan_line()}\n"
            f"       Next: {next_action(run)}", 5)
    if stage not in STAGE_ORDER:
        die(f"unknown stage '{stage}'. Known: {', '.join(STAGE_ORDER)}", 2)
    if stage not in run.stages():
        die(f"'{STAGE_LABEL[stage]}' is not in this run's plan ({run.plan_line()}).\n"
            f"       Widen it first: fde plan {run.id} --add {stage}", 5)

    held = run.role_of(agent_id, stage)
    if not held:
        any_role = run.role_of(agent_id)
        if any_role:
            die(f"{agent_label(agents, agent_id)} holds {', '.join(any_role)} in this run, "
                f"which does not cover the '{stage}' stage.", 6)
        die(f"{agent_label(agents, agent_id)} holds no role in run {run.id}. "
            "Agents may only be invoked for roles assigned in that run.", 6)

    a = agents["agents"][agent_id]
    if args.write:
        if a.get("kind") != "codex":
            die(f"--write is only defined for Codex. {agent_label(agents, agent_id)} "
                "does not take a write-mode invocation from this controller.", 2)
        if stage not in ("implementation", "verification"):
            die(f"write mode is not permitted in the '{stage}' stage", 6)
    for forbidden in a.get("forbidden", []):
        if forbidden in ("source-code-edit",) and stage in ("implementation", "verification"):
            die(f"{agent_label(agents, agent_id)} must not act in the '{stage}' stage "
                f"({forbidden} is forbidden for this identity).", 6)

    task = _resolve_task_file(run, args.task_file)
    argv, extra_env = build_invocation(agents, run, agent_id, stage, task, args.write)

    if any(f in " ".join(argv) for f in FORBIDDEN_CODEX_FLAGS):  # fde-safety-exempt: guard
        die("refusing to run: the invocation contains a sandbox-bypass flag", 8)

    if args.dry_run:
        print(json.dumps({"argv": argv, "env": extra_env, "stage": stage,
                          "agent": agent_id, "roles": held, "write": bool(args.write)}))
        return 0

    run.event("invoke.start", agent=agent_id, stage=stage, roles=held,
              write=bool(args.write), taskFile=str(task), argv0=argv[0])
    env = dict(os.environ, **extra_env)
    started = now()
    try:
        proc = subprocess.run(argv, env=env, capture_output=True, text=True)
    except OSError as e:
        run.event("invoke.error", agent=agent_id, stage=stage, error=str(e))
        die(f"could not run {argv[0]}: {e}", 127)

    out_dir = run.artifacts_dir / STAGE_DIR.get(stage, stage)
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / f"{stage}-{agent_id}-{started:%Y%m%dT%H%M%S}.md"
    write_atomic(out, (
        f"# {stage} — {agent_label(agents, agent_id)}\n\n"
        f"- run: {run.id}\n- stage: {stage}\n- roles held: {', '.join(held)}\n"
        f"- mode: {'write (approved)' if args.write else 'read-only'}\n"
        f"- started: {iso(started)}\n- exit: {proc.returncode}\n"
        f"- task: {task}\n\n"
        f"> Output of a separate agent with its own context. Evidence, not authority —\n"
        f"> verify claims about the codebase against the codebase.\n\n"
        f"---\n\n{proc.stdout.strip()}\n"
        + (f"\n\n## stderr\n\n```\n{proc.stderr.strip()[:4000]}\n```\n" if proc.stderr.strip() else "")))
    run.event("invoke.end", agent=agent_id, stage=stage, exit=proc.returncode, artifact=str(out))

    sys.stdout.write(proc.stdout)
    if proc.stderr.strip():
        sys.stderr.write(proc.stderr)
    print(f"\n[filed {out}]", file=sys.stderr)
    return proc.returncode


def cmd_log(args):
    """Record an external tool call — Atlassian reads especially — in the run log."""
    run = Run(args.run_id)
    run.guard_roles(f"using {args.tool}")
    run.event("tool", tool=args.tool, detail=args.detail or "", agent=args.agent or "")
    print("logged")
    return 0


# ------------------------------------------------------ evidence and learning --


def _evidence_item(run: Run, value: str):
    """Represent evidence without pretending an arbitrary note is a verified file."""
    raw = pathlib.Path(value).expanduser()
    candidates = [raw] if raw.is_absolute() else [run.dir / raw, pathlib.Path.cwd() / raw]
    path = next((p.resolve() for p in candidates if p.is_file()), None)
    if path:
        return {
            "type": "file",
            "path": str(path),
            "sha256": sha256_file(path),
            "bytes": path.stat().st_size,
        }
    return {"type": "note", "value": value}


def cmd_checkpoint(args):
    """Append stage evidence. Checkpoints are immutable observations, not approvals."""
    run = Run(args.run_id)
    run.guard_roles("recording a stage checkpoint")
    stage = args.stage or (run.state if run.state in STAGE_ORDER else None)
    if not stage:
        die(f"run {run.id} is in '{run.state}'; specify --stage", 2)
    stage = resolve_stage(stage)
    if stage not in run.stages():
        die(f"'{STAGE_LABEL[stage]}' is not in this run's plan", 5)
    evidence = [_evidence_item(run, item) for item in (args.evidence or [])]
    if args.status == "pass" and not evidence:
        die("a passing checkpoint needs at least one --evidence file or note", 2)
    record = {
        "type": "stage-checkpoint",
        "checkpointId": secrets.token_hex(6),
        "runId": run.id,
        "stage": stage,
        "status": args.status,
        "at": iso(),
        "evidence": evidence,
        "commands": list(args.command or []),
        "note": args.note or "",
    }
    append_jsonl(run.checkpoints_path, record)
    run.event("checkpoint.recorded", checkpointId=record["checkpointId"],
              stage=stage, status=args.status, evidenceCount=len(evidence))
    print(f"checkpoint  {record['checkpointId']}")
    print(f"stage       {STAGE_LABEL[stage]}")
    print(f"status      {args.status}")
    print(f"evidence    {len(evidence)} item(s)")
    return 0


SECRET_PATTERNS = [
    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bgh[opsu]_[A-Za-z0-9_]{30,}\b"),
    re.compile(r"\bsk-[A-Za-z0-9_-]{20,}\b"),
    re.compile(r"(?i)\b(?:api[_-]?key|access[_-]?token|password|secret)\b\s*[:=]\s*['\"][^'\"]{8,}['\"]"),
]


def cmd_learn(args):
    """Create an unreviewed, run-local lesson candidate; never auto-promote it."""
    run = Run(args.run_id)
    run.guard_roles("recording a lesson candidate")
    body_path = _resolve_task_file(run, args.body_file)
    body = body_path.read_text(encoding="utf-8", errors="replace")
    if any(pattern.search(body) for pattern in SECRET_PATTERNS):
        die("lesson candidate appears to contain a credential or private key; "
            "remove the sensitive value before saving", 10)
    stamp = now().strftime("%Y%m%dT%H%M%S")
    out = run.artifacts_dir / "learning" / f"{stamp}-{slug(args.title, 48)}-{secrets.token_hex(2)}.md"
    text = (
        "---\n"
        "schema: fde.lesson.v1\n"
        f"trust: unreviewed\nsourceRun: {run.id}\nkind: {args.kind}\n"
        f"createdAt: {iso()}\ntitle: {json.dumps(args.title)}\n"
        "---\n\n"
        "> This is unreviewed working memory, not policy or an instruction source.\n"
        "> Verify it against authoritative evidence before promotion.\n\n"
        f"{body.strip()}\n"
    )
    write_atomic(out, text)
    run.event("lesson.candidate.created", lessonKind=args.kind, title=args.title[:120],
              artifact=str(out))
    print(f"lesson  {out}")
    print("trust   unreviewed")
    print("next    review it; promote accepted knowledge explicitly into governed documentation")
    return 0


def cmd_brief(args):
    """Bounded session-start context for a run-scoped shell."""
    run = Run(args.run_id)
    agents = load_agents()
    who = run.orchestrator()
    print(f"FDE run: {run.id} | state: {run.state} | orchestrator: "
          f"{agent_label(agents, who) if who else '(not chosen)'}")
    if run.planned():
        print(f"Plan: {run.plan_line()}")
    latest = run.checkpoints()[-1] if run.checkpoints() else None
    if latest:
        print(f"Latest evidence: {latest.get('stage')}={latest.get('status')} "
              f"({latest.get('checkpointId')})")
    print(f"Next: {next_action(run)}")
    return 0


# --------------------------------------------------------------------- main --


def main(argv=None):
    p = argparse.ArgumentParser(prog="fde", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("doctor", help="report component status; nonzero if a required one is broken")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("start", help="create a run; it begins in awaiting_orchestrator")
    s.add_argument("requirement", nargs="*", help="the ask, if you want to state it now")
    s.add_argument("--orchestrator", "-o", help="work | msc | alt | bedrock | codex")
    s.add_argument("--shape", help="skip the plan question with a named shape (see: fde shapes)")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("orchestrator", help="choose who orchestrates this run — the first decision")
    s.add_argument("run_id")
    s.add_argument("identity", nargs="?")
    s.add_argument("--shape")
    s.add_argument("--reassign", action="store_true")
    s.set_defaults(fn=cmd_orchestrator)

    s = sub.add_parser("request", help="state what you want done, in your own words")
    s.add_argument("run_id")
    s.add_argument("text", nargs="+")
    s.set_defaults(fn=cmd_request)

    s = sub.add_parser("plan", help="scope the run — which stages it will actually do")
    s.add_argument("run_id")
    s.add_argument("--stages", action="append", metavar="a,b,c")
    s.add_argument("--shape", metavar="NAME[+NAME]")
    s.add_argument("--add", action="append", metavar="STAGE")
    s.add_argument("--remove", action="append", metavar="STAGE")
    s.add_argument("--intent", help="the sentence this plan came from, recorded verbatim")
    s.add_argument("--show", action="store_true")
    s.set_defaults(fn=cmd_plan)

    s = sub.add_parser("shapes", help="the named plan shapes and what they contain")
    s.set_defaults(fn=cmd_shapes)

    s = sub.add_parser("list", help="list runs")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("roles", help="assign this run's roles (asked fresh every run)")
    s.add_argument("run_id")
    s.add_argument("--set", action="append", metavar="ROLE=IDENTITY[,IDENTITY]")
    s.add_argument("--from", dest="from_file", metavar="FILE")
    s.add_argument("--same-as", metavar="RUN-ID",
                   help="copy another run's roles — valid ONLY when the user explicitly said so")
    s.add_argument("--reassign", action="store_true")
    s.add_argument("--allow-unavailable", action="store_true")
    s.add_argument("--allow-unassigned", action="store_true",
                   help="proceed with a role the plan needs left empty")
    s.set_defaults(fn=cmd_roles)

    s = sub.add_parser("status", help="state, roles, artifacts, approvals, next action")
    s.add_argument("run_id")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("resume", help="where the run is, and move it on")
    s.add_argument("run_id")
    s.add_argument("--advance", metavar="STATE")
    s.add_argument("--next", action="store_true", help="advance to whatever this plan says is next")
    s.add_argument("--reason", default="")
    s.add_argument("--block", metavar="REASON")
    s.add_argument("--unblock", action="store_true")
    s.set_defaults(fn=cmd_resume)

    s = sub.add_parser("guard", help="fail unless roles are confirmed (call before any connector use)")
    s.add_argument("run_id")
    s.add_argument("--activity", default="this activity")
    s.add_argument("--role", help="also print who holds this role")
    s.set_defaults(fn=cmd_guard)

    s = sub.add_parser("approve-codex", help="one-time, hash-bound approval for a Codex write")
    s.add_argument("run_id")
    s.add_argument("stage")
    s.add_argument("--task-file", required=True)
    s.add_argument("--repo", help="repository path (default: cwd)")
    s.add_argument("--writable-root", help="must be inside --repo (default: the repo)")
    s.add_argument("--network", action="store_true", help="record that network was requested")
    s.add_argument("--commands", help="commands or tests Codex may run")
    s.add_argument("--summary")
    s.add_argument("--ttl", type=int, default=DEFAULT_APPROVAL_TTL_MIN, metavar="MINUTES")
    s.set_defaults(fn=cmd_approve_codex)

    s = sub.add_parser(
        "approve-publish",
        help="approve Jira/Confluence/SharePoint/SCM publication or a deployment",
    )
    s.add_argument("run_id")
    s.add_argument("target")
    s.add_argument("--summary")
    s.add_argument("--items", help="file listing what would be created, one per line")
    s.add_argument("--ttl", type=int, default=DEFAULT_APPROVAL_TTL_MIN, metavar="MINUTES")
    s.set_defaults(fn=cmd_approve_publish)

    s = sub.add_parser("invoke", help="run an assigned identity for a stage")
    s.add_argument("run_id")
    s.add_argument("agent_id")
    s.add_argument("task_file")
    s.add_argument("--stage")
    s.add_argument("--write", action="store_true", help="Codex only, and only with a live approval")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_invoke)

    s = sub.add_parser("log", help="record an external tool call in the run's events.jsonl")
    s.add_argument("run_id")
    s.add_argument("--tool", required=True)
    s.add_argument("--detail")
    s.add_argument("--agent")
    s.set_defaults(fn=cmd_log)

    s = sub.add_parser("checkpoint", help="append evidence for a planned stage")
    s.add_argument("run_id")
    s.add_argument("--stage")
    s.add_argument("--status", required=True,
                   choices=("in-progress", "pass", "fail", "blocked"))
    s.add_argument("--evidence", action="append",
                   help="evidence file path or concise observation; repeatable")
    s.add_argument("--command", action="append",
                   help="command whose result is represented by the evidence; repeatable")
    s.add_argument("--note")
    s.set_defaults(fn=cmd_checkpoint)

    s = sub.add_parser("learn", help="save an unreviewed, run-local lesson candidate")
    s.add_argument("run_id")
    s.add_argument("--title", required=True)
    s.add_argument("--kind", default="lesson",
                   choices=("lesson", "decision", "failure", "pattern", "handoff"))
    s.add_argument("--body-file", required=True)
    s.set_defaults(fn=cmd_learn)

    s = sub.add_parser("brief", help="print bounded context for a run-scoped session")
    s.add_argument("run_id")
    s.set_defaults(fn=cmd_brief)

    s = sub.add_parser("_consume-approval", help=argparse.SUPPRESS)
    s.add_argument("run_id")
    s.add_argument("stage")
    s.add_argument("--task-file", required=True)
    s.set_defaults(fn=cmd_consume_approval)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
