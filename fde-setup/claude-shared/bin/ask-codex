#!/usr/bin/env bash
# ask-codex — the only sanctioned way to reach the ChatGPT-authenticated Codex CLI.
#
# Two modes, and they are not interchangeable:
#
#   ask-codex --read-only "is this migration reversible?"
#   ask-codex --read-only --task-file tasks/review.md --context-file evidence/jira.md
#   ask-codex --write --run <run-id> --stage <stage> --task-file <file>
#
# Read-only is authorised by the run's role assignment: if the user gave Codex a
# read-only role, it may read within that stage. Write is not. Every write-capable
# invocation needs an explicit, just-in-time approval from the user, granted with
#   fde approve-codex <run-id> <stage> --task-file <file> --repo <path>
# and consumed here, once, immediately before the process starts.
#
# Codex's sandbox decides what it CAN touch. The gate is outer (this script +
# fde). Read mode uses a read-only permission profile with network access for
# research; write mode remains workspace-write with network off. `codex exec`
# is non-interactive by default; never pass an auto-approval or sandbox-bypass
# option here.
#
# Optional --model and --effort come from the controller's approved route. They
# are validated and passed as separate arguments; there is no shell
# interpolation, and a value cannot smuggle an option through them.
#
# Accounts: CODEX_HOME selects which ChatGPT account this call signs in as. The
# controller exports it from the account's provider template; unset, the CLI uses
# its own default (~/.codex), which is exactly what happened before accounts
# existed. This script never reads auth.json — it only checks that the directory
# an explicit CODEX_HOME names has one, so "signed out" is reported as itself
# instead of surfacing as a confusing mid-run authentication prompt.
#
# There is no bypass flag here and there must never be one.
set -uo pipefail

die() { printf 'ask-codex: %s\n' "$*" >&2; exit 1; }

codex_account_check() {
  # Prints where this call's credentials come from. Never prints a credential.
  if [[ -n "${CODEX_HOME:-}" ]]; then
    if [[ ! -d "$CODEX_HOME" ]]; then
      printf 'ask-codex: CODEX_HOME=%s does not exist\n' "$CODEX_HOME" >&2
      return 1
    fi
    if [[ ! -f "$CODEX_HOME/auth.json" ]]; then
      printf 'ask-codex: no credential in CODEX_HOME=%s — this account is signed out\n' \
        "$CODEX_HOME" >&2
      return 1
    fi
    printf 'Codex: signed in for this account (%s)\n' "$CODEX_HOME"
    return 0
  fi
  if [[ -f "${HOME}/.codex/auth.json" ]]; then
    printf 'Codex: signed in with the CLI default (%s/.codex)\n' "$HOME"
    return 0
  fi
  printf 'ask-codex: no Codex credential found — run: codex login\n' >&2
  return 1
}

if [[ "${1:-}" == "--check" ]]; then codex_account_check; exit $?; fi

# The standing brief goes FIRST and byte-identical on every call: both Gemini and
# Codex do automatic prefix caching, and a prefix that shifts by one byte is a
# full cache miss. The variable question goes LAST, after the separator, for the
# same reason. Set FDE_NO_PREAMBLE=1 to send the bare question.
compose_prompt() {  # compose_prompt <question> [context-file ...]
  local question="$1"; shift
  local pre="${FDE_SIDECAR_PREAMBLE:-${CLAUDE_SHARED:-$HOME/.claude-shared}/prompts/sidecar-preamble.md}"
  if [[ "${FDE_NO_PREAMBLE:-}" == "1" || ! -r "$pre" ]]; then
    if [[ $# -eq 0 ]]; then printf '%s' "$question"; return 0; fi
    for f in "$@"; do
      [[ -f "$f" && ! -L "$f" && -r "$f" ]] || die "context file is not a readable regular file: $f"
      [[ $(wc -c < "$f") -le 524288 ]] || die "context file is over the 512 KiB limit: $f"
      printf '# Reference: %s\n\n%s\n\n' "$(basename "$f")" "$(cat "$f")"
    done
    printf '# Question\n\n%s' "$question"; return 0
  fi
  printf '%s' "$(cat "$pre")"
  # FDE_SIDECAR_CONTEXT: colon-separated files of reference material that is the
  # same for every call of this kind — a standards section, an ADR, an API spec.
  # It sits in the cacheable position, so both providers' minimum cacheable
  # prefix (~1k tokens; the brief alone is under it) is reached on a review or
  # implementation call, and every later call in the run reads from cache.
  #   FDE_SIDECAR_CONTEXT="$(standards path)" ask-codex --read-only "..."
  local IFS=:
  local f
  for f in ${FDE_SIDECAR_CONTEXT:-}; do
    [[ -r "$f" ]] || continue
    printf '\n\n# Reference: %s\n\n%s' "$(basename "$f")" "$(cat "$f")"
  done
  for f in "$@"; do
    [[ -f "$f" && ! -L "$f" && -r "$f" ]] || die "context file is not a readable regular file: $f"
    [[ $(wc -c < "$f") -le 524288 ]] || die "context file is over the 512 KiB limit: $f"
    printf '\n\n# Reference: %s\n\n%s' "$(basename "$f")" "$(cat "$f")"
  done
  printf '\n\n# Question\n\n%s' "$question"
}

command -v codex >/dev/null || die "codex CLI not installed: npm i -g @openai/codex"

# An explicitly selected account that is signed out is refused here, before a
# prompt is composed or a task file is read: the alternative is Codex asking to
# authenticate in the middle of a non-interactive run, where nobody can answer.
if [[ -n "${CODEX_HOME:-}" && ! -f "${CODEX_HOME}/auth.json" ]]; then
  die "the selected Codex account is signed out (no auth.json in $CODEX_HOME).
            sign it in:  fde accounts login <account-id>"
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FDE="$here/fde"; [[ -x "$FDE" ]] || FDE="$(command -v fde || true)"

mode=""; run=""; stage=""; task_file=""; prompt=""; model=""; effort=""
context_files=()
config_options=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --read-only) mode="read"; shift ;;
    --write)     mode="write"; shift ;;
    --run)       run="${2:-}"; shift 2 ;;
    --stage)     stage="${2:-}"; shift 2 ;;
    --task-file) task_file="${2:-}"; shift 2 ;;
    --context-file) context_files+=("${2:-}"); shift 2 ;;
    --model)     model="${2:-}"; shift 2 ;;
    --effort)    effort="${2:-}"; shift 2 ;;
    --config-override)
      value="${2:-}"
      [[ "$value" =~ ^mcp_servers\.[A-Za-z0-9_-]{1,64}\.(url|command|args|bearer_token_env_var|startup_timeout_sec|tool_timeout_sec|enabled_tools|env\.[A-Za-z_][A-Za-z0-9_]*|env_http_headers\.\"[A-Za-z0-9_-]{1,64}\")= ]] ||
        die "refusing an invalid MCP config override"
      config_options+=(-c "$value"); shift 2 ;;
    --yolo|--dangerously-bypass-approvals-and-sandbox|--sandbox) # fde-safety-exempt: refusal, not an invocation
      die "refusing: '$1' is not available through this toolkit. Sandbox and approval
            policy are decided here, not by the caller." ;;
    --check)     codex_account_check; exit $? ;;
    -h|--help)   sed -n '2,36p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)          shift; prompt="$prompt $*"; break ;;
    *)           prompt="$prompt $1"; shift ;;
  esac
done
prompt="${prompt# }"
[[ -z "$mode" ]] && mode="read"   # bare `ask-codex "..."` stays read-only

if [[ -n "${FDE_RUN_ID:-}" && "${FDE_ROUTED_INVOCATION:-}" != "1" ]]; then
  die "inside FDE run $FDE_RUN_ID, invoke the assigned Codex identity through:
            fde invoke $FDE_RUN_ID <codex-identity> <task-file> --stage <stage>
       Direct sidecar calls bypass role checks and run-scoped connectors."
fi

# Model and reasoning effort come from the controller's approved route, or not at
# all. They are validated here and appended as separate argv elements: nothing is
# interpolated into a shell string, so a value cannot carry an option or a
# command with it. An empty value leaves the CLI's own default alone.
model_options=()
if [[ -n "$model" && "$model" != "default" ]]; then
  [[ "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$ ]] || die "unusable --model value"
  model_options+=(--model "$model")
fi
if [[ -n "$effort" && "$effort" != "auto" ]]; then
  case "$effort" in
    minimal|low|medium|high|xhigh|max) ;;
    *) die "unusable --effort value: $effort" ;;
  esac
  # A config override rather than a flag: Codex exposes reasoning effort as
  # model_reasoning_effort, and which values a given build accepts is the CLI's
  # business. If it refuses one, that refusal is the honest answer and is not
  # swallowed here.
  model_options+=(-c "model_reasoning_effort=$effort")
fi

# ---------------------------------------------------------------- read-only --
if [[ "$mode" == "read" ]]; then
  if [[ -n "$task_file" ]]; then
    [[ -f "$task_file" ]] || die "no task file at $task_file"
    prompt="$(cat "$task_file")"
  fi
  [[ -n "${prompt// }" ]] || die "nothing to ask"
  exec codex exec \
    -c 'default_permissions="fde-readonly-network"' \
    -c 'permissions.fde-readonly-network.extends=":read-only"' \
    -c 'permissions.fde-readonly-network.network.enabled=true' \
    -c 'web_search="live"' \
    --skip-git-repo-check \
    ${model_options[@]+"${model_options[@]}"} \
    ${config_options[@]+"${config_options[@]}"} \
    "$(compose_prompt "$prompt" ${context_files[@]+"${context_files[@]}"})"
fi

# -------------------------------------------------------------------- write --
[[ ${#context_files[@]} -eq 0 ]] || die "write mode does not accept --context-file; put the exact context in the approved task file"
[[ -n "$run" && -n "$stage" && -n "$task_file" ]] || die \
"write mode needs --run, --stage and --task-file. A free-text --write prompt is
            no longer accepted: the approval is bound to the exact bytes of a task file.
              fde approve-codex <run-id> <stage> --task-file <file> --repo <path>"
[[ -n "$FDE" && -x "$FDE" ]] || die "cannot find the fde controller; write mode is unavailable"
[[ -f "$task_file" ]] || die "no task file at $task_file"

# Verify, then consume, the one-time approval. This re-hashes the task file, so
# an edit since approval fails here — the approval is not widened, it is refused.
grant="$("$FDE" _consume-approval "$run" "$stage" --task-file "$task_file")" || exit 7

# NUL-separated, read into an array. A field must never be recovered by shell
# word-splitting: a repository path containing a space would shift every later
# field, and one of those fields is the writable root that bounds the sandbox.
grant_fields=()
while IFS= read -r -d '' field; do grant_fields+=("$field"); done < <(
  printf '%s' "$grant" | python3 -c '
import json,sys
g = json.load(sys.stdin)
for key in ("approvalId", "repositoryPath", "writableRoot", "taskFile", "taskFileSha256"):
    sys.stdout.write(str(g[key]) + "\0")
sys.stdout.write(("true" if g.get("network") else "false") + "\0")
'
)
[[ ${#grant_fields[@]} -eq 6 ]] || die "could not read the approval grant"
approval_id="${grant_fields[0]}"
repo="${grant_fields[1]}"
writable="${grant_fields[2]}"
approved_task="${grant_fields[3]}"
approved_sha="${grant_fields[4]}"
network="${grant_fields[5]}"

[[ -d "$writable" ]] || die "approved writable root no longer exists: $writable"
[[ "$approved_task" == /* ]] || die "the controller returned a relative task path; refusing"

# Read the approved bytes HERE, from the absolute path the controller resolved
# and hashed, and before the cd below. The earlier version re-read the caller's
# relative --task-file after changing directory, so the bytes Codex was handed
# came from <repo>/<given> while the hash had been taken over <run.dir>/<given>
# — the gate checked one file and Codex wrote from another. One read, digest
# verified against the grant, and the content is carried in a variable from
# here on: nothing re-opens the file after the check.
approved_prompt="$(python3 - "$approved_task" "$approved_sha" <<'VERIFY'
import hashlib, sys
path, expected = sys.argv[1], sys.argv[2]
try:
    data = open(path, "rb").read()
except OSError as exc:
    sys.stderr.write("cannot read the approved task file: %s\n" % exc)
    raise SystemExit(1)
if hashlib.sha256(data).hexdigest() != expected:
    sys.stderr.write("task file no longer matches the approved digest\n")
    raise SystemExit(1)
sys.stdout.write(data.decode("utf-8", "replace"))
VERIFY
)" || die "the approved task file changed after the approval was consumed. The
            approval is spent; re-approve the file you actually mean to run:
              fde approve-codex $run $stage --task-file <file> --repo <path>"

printf 'ask-codex: approval %s consumed — workspace-write in %s, network off\n' \
  "$approval_id" "$writable" >&2
if [[ "$network" == "true" ]]; then
  printf 'ask-codex: network was requested at approval time but is NOT enabled.\n' >&2
  printf '           Re-approve a narrower task, or do that step yourself.\n' >&2
fi

cd "$writable" || die "cannot enter $writable"

# The standing brief is NOT prepended here. The approval is hash-bound to the
# exact bytes of the task file, and the value of that gate is that what Codex is
# told in write mode is exactly what the user approved — not that plus whatever
# a shared preamble file happened to say at call time. Read mode gets the brief;
# write mode gets the approved bytes.
#
# workspace-write bounds writes to this directory tree; network stays disabled.
# codex exec is non-interactive by default (codex-cli 0.151.0 removed
# --ask-for-approval from exec; the opt-in is now --approve-for-me, which we do
# not pass). Omitting it means Codex fails closed rather than prompting, which is
# the property this outer gate relies on.
exec codex exec \
  --sandbox workspace-write \
  --skip-git-repo-check \
  ${model_options[@]+"${model_options[@]}"} \
  ${config_options[@]+"${config_options[@]}"} \
  "$approved_prompt"
