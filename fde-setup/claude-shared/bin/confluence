#!/usr/bin/env python3
"""Minimal Confluence Cloud client — the write path for both Microsoft options.

Env (put these in ~/.claude-shared/env.sh, which is gitignored):
  CONFLUENCE_BASE_URL   https://<your-site>.atlassian.net
  CONFLUENCE_EMAIL      your Atlassian account email
  CONFLUENCE_API_TOKEN  from id.atlassian.com/manage-profile/security/api-tokens

Usage:
  confluence spaces
  confluence search "authentication ADR"
  confluence get <page-id>
  confluence create <space-key> "<title>" <file.md> [--parent <page-id>]
  confluence update <page-id> "<title>" <file.md>
  confluence attach <page-id> <file>

Markdown is converted to Confluence storage format well enough for headings,
lists, code fences, bold/italic, links and tables. Anything more elaborate,
write as storage-format HTML and it passes through.
"""
import base64, html, json, os, sys, urllib.error, urllib.request, mimetypes, uuid, re

BASE = os.environ.get("CONFLUENCE_BASE_URL", "").rstrip("/")
EMAIL = os.environ.get("CONFLUENCE_EMAIL", "")
TOKEN = os.environ.get("CONFLUENCE_API_TOKEN", "")


def need_env():
    missing = [k for k, v in (("CONFLUENCE_BASE_URL", BASE), ("CONFLUENCE_EMAIL", EMAIL),
                              ("CONFLUENCE_API_TOKEN", TOKEN)) if not v]
    if missing:
        sys.exit("missing env: " + ", ".join(missing) + "\nsee ~/.claude-shared/env.sh.example")


def auth_header():
    raw = f"{EMAIL}:{TOKEN}".encode()
    return "Basic " + base64.b64encode(raw).decode()


def call(method, path, body=None, extra_headers=None, raw_body=None):
    url = path if path.startswith("http") else BASE + path
    headers = {"Authorization": auth_header(), "Accept": "application/json"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    elif raw_body is not None:
        data = raw_body
    headers.update(extra_headers or {})
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req) as r:
            payload = r.read().decode()
            return json.loads(payload) if payload else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode()[:900]
        sys.exit(f"HTTP {e.code} on {method} {url}\n{detail}")


# ---------- markdown -> confluence storage format ----------
def md_to_storage(md):
    out, in_code, in_list, lang = [], False, None, ""
    def esc(t):
        t = html.escape(t, quote=False)
        t = re.sub(r"`([^`]+)`", lambda m: "<code>" + m.group(1) + "</code>", t)
        t = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", t)
        t = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<em>\1</em>", t)
        t = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', t)
        return t

    def close_list():
        nonlocal in_list
        if in_list:
            out.append(f"</{in_list}>")
            in_list = None

    lines = md.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        fence = re.match(r"^```(\w*)", line)
        if fence:
            if in_code:
                out.append("]]></ac:plain-text-body></ac:structured-macro>")
                in_code = False
            else:
                close_list()
                lang = fence.group(1) or "text"
                out.append(f'<ac:structured-macro ac:name="code"><ac:parameter ac:name="language">{lang}</ac:parameter><ac:plain-text-body><![CDATA[')
                in_code = True
            i += 1
            continue
        if in_code:
            out.append(line)
            i += 1
            continue

        # table
        if line.startswith("|") and i + 1 < len(lines) and re.match(r"^\|[\s:|-]+\|$", lines[i + 1]):
            close_list()
            hdr = [c.strip() for c in line.strip("|").split("|")]
            out.append("<table><tbody><tr>" + "".join(f"<th>{esc(c)}</th>" for c in hdr) + "</tr>")
            i += 2
            while i < len(lines) and lines[i].startswith("|"):
                cells = [c.strip() for c in lines[i].strip("|").split("|")]
                out.append("<tr>" + "".join(f"<td>{esc(c)}</td>" for c in cells) + "</tr>")
                i += 1
            out.append("</tbody></table>")
            continue

        h = re.match(r"^(#{1,6})\s+(.*)", line)
        if h:
            close_list()
            out.append(f"<h{len(h.group(1))}>{esc(h.group(2))}</h{len(h.group(1))}>")
        elif re.match(r"^\s*[-*+]\s+", line):
            if in_list != "ul":
                close_list(); out.append("<ul>"); in_list = "ul"
            item = esc(re.sub(r"^\s*[-*+]\s+", "", line))
            out.append("<li>" + item + "</li>")
        elif re.match(r"^\s*\d+\.\s+", line):
            if in_list != "ol":
                close_list(); out.append("<ol>"); in_list = "ol"
            item = esc(re.sub(r"^\s*\d+\.\s+", "", line))
            out.append("<li>" + item + "</li>")
        elif not line.strip():
            close_list()
        else:
            close_list()
            out.append(f"<p>{esc(line)}</p>")
        i += 1
    if in_code:
        out.append("]]></ac:plain-text-body></ac:structured-macro>")
    close_list()
    return "\n".join(out)


def body_from(path):
    text = open(path, encoding="utf-8").read()
    return text if path.endswith((".html", ".storage")) else md_to_storage(text)


# ---------- commands ----------
def cmd_spaces(_):
    r = call("GET", "/wiki/api/v2/spaces?limit=100")
    for s in r.get("results", []):
        print(f"{s['key']:12s} {s['id']:12s} {s.get('name','')}")


def cmd_search(a):
    import urllib.parse
    cql = urllib.parse.quote(f'text ~ "{a[0]}"')
    r = call("GET", f"/wiki/rest/api/search?cql={cql}&limit=20")
    for x in r.get("results", []):
        c = x.get("content", {})
        print(f"{c.get('id','?'):12s} {c.get('type',''):8s} {x.get('title','')}")


def cmd_get(a):
    r = call("GET", f"/wiki/api/v2/pages/{a[0]}?body-format=storage")
    print(f"# {r.get('title')}  (v{r.get('version',{}).get('number')})\n")
    print(r.get("body", {}).get("storage", {}).get("value", ""))


def cmd_create(a):
    space_key, title, path = a[0], a[1], a[2]
    parent = a[a.index("--parent") + 1] if "--parent" in a else None
    sp = call("GET", f"/wiki/api/v2/spaces?keys={space_key}")
    results = sp.get("results", [])
    if not results:
        sys.exit(f"space '{space_key}' not found")
    payload = {"spaceId": results[0]["id"], "status": "current", "title": title,
               "body": {"representation": "storage", "value": body_from(path)}}
    if parent:
        payload["parentId"] = parent
    r = call("POST", "/wiki/api/v2/pages", payload)
    print(f"created {r['id']}: {BASE}/wiki/spaces/{space_key}/pages/{r['id']}")


def cmd_update(a):
    page_id, title, path = a[0], a[1], a[2]
    cur = call("GET", f"/wiki/api/v2/pages/{page_id}")
    payload = {"id": page_id, "status": "current", "title": title,
               "body": {"representation": "storage", "value": body_from(path)},
               "version": {"number": cur["version"]["number"] + 1, "message": "updated by fde toolkit"}}
    r = call("PUT", f"/wiki/api/v2/pages/{page_id}", payload)
    print(f"updated {r['id']} to v{r['version']['number']}")


def cmd_attach(a):
    page_id, path = a[0], a[1]
    name = os.path.basename(path)
    ctype = mimetypes.guess_type(name)[0] or "application/octet-stream"
    boundary = uuid.uuid4().hex
    body = b"".join([
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{name}\"\r\n"
        f"Content-Type: {ctype}\r\n\r\n".encode(),
        open(path, "rb").read(),
        f"\r\n--{boundary}--\r\n".encode()])
    r = call("POST", f"/wiki/rest/api/content/{page_id}/child/attachment", raw_body=body,
             extra_headers={"Content-Type": f"multipart/form-data; boundary={boundary}",
                            "X-Atlassian-Token": "no-check"})
    print(f"attached {name}")


CMDS = {"spaces": cmd_spaces, "search": cmd_search, "get": cmd_get,
        "create": cmd_create, "update": cmd_update, "attach": cmd_attach}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        sys.exit(__doc__)
    need_env()
    CMDS[sys.argv[1]](sys.argv[2:])
