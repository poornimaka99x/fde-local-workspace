#!/usr/bin/env bash
# Start or resume an interactive FDE orchestrator conversation.
#
# The first Claude process scopes the request without run-scoped connectors.
# After the user approves the combined plan and roles, exiting that process lets
# this launcher resume the same conversation with the orchestrator's run-scoped
# MCP config and autonomous (but not permission-bypassing) execution mode.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FDE="${FDE_CONTROLLER:-$here/fde}"
MCP_SYNC="${FDE_MCP_SYNC:-$here/mcp-sync}"
CLAUDE_BIN="${FDE_CLAUDE_BIN:-claude}"
RUNS="${FDE_RUNS_DIR:-${CLAUDE_SHARED:-$HOME/.claude-shared}/runs}"
SHARED="${CLAUDE_SHARED:-$HOME/.claude-shared}"

usage() {
  cat <<'USAGE'
usage:
  fde-start [--orchestrator IDENTITY] [--model ALIAS-OR-ID]
            [--effort auto|low|medium|high|xhigh|max]
  fde-start --resume <run-id>

Starts a chat with the selected orchestrator. In that chat:
  1. give the request;
  2. review its proposed stages, specialist agents and roles;
  3. select the identity for every role;
  4. type APPROVE PLAN <run-id> when the combined proposal is correct;
  5. type /exit once prompted; fde-start resumes the same conversation with
     run-scoped connectors and executes the approved plan.

IDENTITY is any registered Claude account — an id or a name (see:
fde accounts list). Codex remains assignable to any supported role, including
orchestrator, but the continuous two-process chat launcher currently requires a
Claude profile; the controller says so by name when you pick one that cannot.
USAGE
}

orchestrator=""
orchestrator_id=""
profile_dir=""
resume_id=""
model=""
effort=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --orchestrator|-o) orchestrator="${2:-}"; shift 2 ;;
    --resume|-r) resume_id="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --effort) effort="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "fde-start: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

command -v "$CLAUDE_BIN" >/dev/null 2>&1 || {
  echo "fde-start: Claude CLI not found: $CLAUDE_BIN" >&2; exit 1; }
[[ -x "$FDE" ]] || { echo "fde-start: controller not executable: $FDE" >&2; exit 1; }

read_json_field() {
  python3 - "$1" "$2" <<'PY'
import json, pathlib, sys
path, field = pathlib.Path(sys.argv[1]), sys.argv[2]
data = json.loads(path.read_text())
value = data
for part in field.split("."):
    value = value.get(part) if isinstance(value, dict) else None
print(value or "")
PY
}

# Capability switches are an operator policy, applied only to new processes.
# Built-in Claude tools get a real CLI deny rule; the remaining disabled
# harness components are stated in the system prompt so the orchestrator cannot
# select or delegate to them through FDE.
capability_note=""
capability_args=()
policy_file="$SHARED/config/capability-policy.json"
if [[ -f "$policy_file" ]]; then
  capability_note="$(python3 - "$policy_file" <<'PY'
import json, pathlib, sys
doc = json.loads(pathlib.Path(sys.argv[1]).read_text())
disabled = doc.get("disabled")
if doc.get("schemaVersion") != 1 or not isinstance(disabled, list):
    raise SystemExit("fde-start: invalid capability policy; refusing to widen availability")
items = [str(item) for item in disabled if isinstance(item, str)]
if items:
    print("Operator capability policy: switched off: " + ", ".join(sorted(items)) +
          ". Do not invoke, delegate to, or rely on these capabilities.")
PY
)"
  disabled_tools="$(python3 - "$policy_file" <<'PY'
import json, pathlib, re, sys
doc = json.loads(pathlib.Path(sys.argv[1]).read_text())
disabled = doc.get("disabled")
if doc.get("schemaVersion") != 1 or not isinstance(disabled, list):
    raise SystemExit("fde-start: invalid capability policy; refusing to widen availability")
tools = [item[5:] for item in disabled
         if isinstance(item, str) and item.startswith("tool:")
         and re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,63}", item[5:])]
print(",".join(sorted(set(tools))))
PY
)"
  [[ -n "$disabled_tools" ]] && capability_args=(--disallowedTools "$disabled_tools")
fi

# Which identities exist, which of them can hold a continuous conversation, and
# the environment that selects one, are all the controller's answers. This
# launcher used to restate them as two case statements, which meant an account
# the operator added was unlaunchable until someone edited this file.
#
# launch_env is built from NUL-delimited KEY=VALUE pairs and passed to env(1) as
# an array: nothing goes through a shell, so a directory with a space or a dollar
# sign in it survives intact.
launch_env=()
launch_json=""

# One helper reads one field out of the controller's JSON. Kept as a separate
# function so nothing here interpolates a shell value into a Python source
# string, and so no f-string needs a quote escaped inside it — an f-string
# expression cannot contain a backslash before Python 3.12, and getting that
# wrong once made the interactive prompt unreachable on every older
# interpreter.
launch_field() {  # launch_field <dotted.path>
  printf '%s' "$launch_json" | FIELD="$1" python3 -c '
import json, os, sys
value = json.load(sys.stdin)
for part in os.environ["FIELD"].split("."):
    value = value.get(part) if isinstance(value, dict) else None
print("" if value is None else value)
'
}

load_launch() {  # load_launch <identity-token>
  # The controller answers with a plan; a refusal is a typed envelope with its
  # own sentence, and that sentence is the useful part. Its stderr is not
  # discarded: for an ambiguous or unknown identity it is the only place the
  # candidates are named.
  launch_json="$("$FDE" accounts launch "$1" --json)" || true
  [[ -n "$launch_json" ]] && printf '%s' "$launch_json" | python3 -c '
import json, sys
json.load(sys.stdin)
' 2>/dev/null || {
    echo "fde-start: the controller could not describe identity '$1'" >&2
    echo "  see: fde accounts list" >&2
    return 2; }
  local refusal
  refusal="$(launch_field error.message)"
  if [[ -n "$refusal" ]]; then
    echo "fde-start: $refusal" >&2
    local hint; hint="$(launch_field error.hint)"
    [[ -n "$hint" ]] && echo "  $hint" >&2
    return 4
  fi
  if [[ "$(launch_field launch.interactive)" != "True" ]]; then
    local reason; reason="$(launch_field launch.reason)"
    echo "fde-start: ${reason:-this identity cannot hold an interactive session}" >&2
    return 3
  fi
  orchestrator="$(launch_field launch.account)"
  orchestrator_id="$(launch_field launch.accountId)"
  profile_dir="$(launch_field launch.configDir)"
  [[ -n "$profile_dir" ]] || {
    echo "fde-start: identity '$1' has no Claude profile directory" >&2; return 3; }

  # The environment comes from a second call, and its status is checked: a
  # process substitution reports none, so a failure there would leave
  # launch_env empty and start Claude against its DEFAULT credential
  # directory — the one thing per-account isolation exists to prevent.
  local env_file; env_file="$(mktemp)"
  if ! "$FDE" accounts launch "$1" --env0 > "$env_file"; then
    rm -f "$env_file"
    echo "fde-start: the controller could not describe the environment for '$1'" >&2
    return 3
  fi
  launch_env=()
  while IFS= read -r -d "" pair; do launch_env+=("$pair"); done < "$env_file"
  rm -f "$env_file"
  # A Claude session must carry its account's config directory. Starting one
  # without it is not a degraded launch, it is the wrong account.
  local found=0 pair
  for pair in ${launch_env[@]+"${launch_env[@]}"}; do
    [[ "$pair" == "CLAUDE_CONFIG_DIR=$profile_dir" ]] && found=1
  done
  (( found )) || {
    echo "fde-start: the controller did not return CLAUDE_CONFIG_DIR for '$1';" >&2
    echo "  refusing to start a session that would use the default account" >&2
    return 3; }
  return 0
}

if [[ -n "$resume_id" ]]; then
  run_id="$resume_id"
  run_dir="$RUNS/$run_id"
  [[ -d "$run_dir" ]] || { echo "fde-start: no such run: $run_id" >&2; exit 4; }
  orchestrator_id="$(read_json_field "$run_dir/roles.json" assignments.orchestrator)"
  [[ -n "$orchestrator_id" ]] || {
    echo "fde-start: run $run_id has no orchestrator assigned yet" >&2; exit 3; }
  load_launch "$orchestrator_id" || exit $?
else
  if [[ -z "$orchestrator" ]]; then
    echo "Choose the orchestrator for this run:"
    "$FDE" accounts list --json | python3 -c '
import json, sys
accounts = json.load(sys.stdin).get("accounts") or []
launchable = [a for a in accounts if a.get("kind") == "claude"]
if not launchable:
    print("  (no Claude account is registered)")
    print("  add one:  fde accounts add --provider claude --name work")
for a in launchable:
    state = "signed in" if a.get("loggedIn") else "SIGNED OUT"
    print("  {:<24} {}  [{}]".format(a["id"], a["label"], state))
'
    read -r -p "orchestrator: " orchestrator
  fi
  load_launch "$orchestrator" || exit $?
  start_args=(start)
  [[ -n "$model" ]] && start_args+=(--model "$model")
  [[ -n "$effort" ]] && start_args+=(--effort "$effort")
  start_output="$("$FDE" "${start_args[@]}")"
  run_id="$(printf '%s\n' "$start_output" | awk '$1 == "run" {print $2; exit}')"
  [[ -n "$run_id" ]] || { echo "fde-start: controller did not return a run id" >&2; exit 1; }
  "$FDE" orchestrator "$run_id" "$orchestrator_id"
  run_dir="$RUNS/$run_id"
fi

[[ -d "$profile_dir" ]] || {
  echo "fde-start: account '$orchestrator_id' has no profile directory at $profile_dir" >&2
  echo "  create it:  fde accounts add --provider claude --name $orchestrator" >&2
  exit 3; }

session_file="$run_dir/orchestrator-session-id"
[[ -n "$model" ]] || model="$(read_json_field "$run_dir/manifest.json" sessionConfig.model)"
[[ -n "$effort" ]] || effort="$(read_json_field "$run_dir/manifest.json" sessionConfig.effort)"
case "$effort" in
  ""|auto|low|medium|high|xhigh|max) ;;
  *) echo "fde-start: unsupported effort in run manifest: $effort" >&2; exit 2 ;;
esac
[[ -z "$model" || "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$ ]] || {
  echo "fde-start: unsupported model in run manifest" >&2; exit 2; }
if [[ -s "$session_file" ]]; then
  session_id="$(tr -d '[:space:]' < "$session_file")"
  have_session=1
else
  session_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  printf '%s\n' "$session_id" > "$session_file"
  have_session=0
fi

# The launcher writes the UUID before Claude starts. If Claude exits before it
# persists the conversation, that durable pointer becomes stale and every
# later retry otherwise fails with `--resume` forever. Claude stores sessions
# under the selected profile as <uuid>.jsonl; check names only, never content.
if (( have_session )) && \
   ! find "$profile_dir/projects" -type f -name "$session_id.jsonl" -print -quit \
      2>/dev/null | grep -q .; then
  old_session_id="$session_id"
  session_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  printf '%s\n' "$session_id" > "$session_file"
  have_session=0
  echo "fde-start: recorded Claude session $old_session_id was not persisted; starting a fresh session"
fi

run_claude() {
  # The account's environment comes from the controller, whole: which variable
  # points Claude at which credentials, and whether this account routes through
  # Bedrock, are recorded once in the provider template and not restated here.
  local session_options=()
  [[ -n "$model" && "$model" != "default" ]] && session_options+=(--model "$model")
  [[ -n "$effort" && "$effort" != "auto" ]] && session_options+=(--effort "$effort")
  env ${launch_env[@]+"${launch_env[@]}"} FDE_RUN_ID="$run_id" "$CLAUDE_BIN" \
    ${session_options[@]+"${session_options[@]}"} "$@"
}

state="$(read_json_field "$run_dir/manifest.json" state)"
if [[ "$state" == "awaiting_plan" || "$state" == "awaiting_roles" ]]; then
  if [[ -s "$run_dir/requirement.md" ]]; then
    request_scope="The controller already has this run's request in requirement.md.
Inspect fde status $run_id and use its recorded requirement as authoritative.
Do not ask me to repeat or re-record the request. Ask only targeted clarification
questions that are genuinely needed to propose the plan and roles."
  else
    request_scope="The controller does not yet have a recorded request. Ask for my
request in my own words and record it verbatim before proposing the plan."
  fi
  scope_prompt="/engage $run_id
Hold an interactive scoping conversation. $request_scope
Propose the smallest suitable plan and the specialist agents/roles it needs,
let me choose the identities, then show one combined plan-and-role summary. Do
not record the plan or roles as approved until I type APPROVE PLAN $run_id
exactly. Read no connected system or repository during scoping. After approval,
tell me to type /exit so fde-start can resume this same conversation with
run-scoped access."
  scope_system="This is the scoping process for FDE run $run_id. Accounts have
capabilities, not fixed roles. Ask whenever intent, scope, target, authority or
acceptance criteria are ambiguous. The controller's status is authoritative for
whether this run already has a request; never claim it is missing when status
reports requirement.hasFile=true. Do not access connected systems or source
repositories before combined plan approval. $capability_note"
  if (( have_session )); then
    run_claude --resume "$session_id" --name "FDE $run_id" \
      --permission-mode auto ${capability_args[@]+"${capability_args[@]}"} --append-system-prompt "$scope_system" "$scope_prompt"
  else
    run_claude --session-id "$session_id" --name "FDE $run_id" \
      --permission-mode auto ${capability_args[@]+"${capability_args[@]}"} --append-system-prompt "$scope_system" "$scope_prompt"
  fi
  # A successful scoping process has now persisted this session. The execution
  # process below must resume it rather than trying to create the UUID again.
  have_session=1
fi

state="$(read_json_field "$run_dir/manifest.json" state)"
if [[ "$state" == "awaiting_plan" || "$state" == "awaiting_roles" || \
      "$state" == "awaiting_orchestrator" ]]; then
  echo
  echo "Run $run_id is not approved yet (state: $state)."
  echo "Resume the same orchestrator chat with: fde-start --resume $run_id"
  exit 0
fi

"$MCP_SYNC" --run "$run_id" >/dev/null
mcp_file="$run_dir/mcp/claude-$orchestrator.mcp.json"
[[ -f "$mcp_file" ]] || {
  echo "fde-start: expected run-scoped MCP config was not generated: $mcp_file" >&2
  exit 6
}

execution_prompt="/engage $run_id
The combined plan and roles are approved. Continue this same conversation and
execute only the approved stages. Use configured tools autonomously where the
scope is clear. If any requirement, target, permission, destructive effect or
acceptance criterion is ambiguous, stop and ask me before acting."
execution_system="Execute FDE run $run_id autonomously within its approved plan
and role assignment. You have the normal configured tool surface and run-scoped
connectors. Never infer permission for Codex writes, deployments, publication,
destructive actions or scope expansion; their explicit gates still apply. $capability_note"

if (( have_session )); then
  run_claude --resume "$session_id" --name "FDE $run_id" \
    --mcp-config "$mcp_file" --permission-mode auto --tools default ${capability_args[@]+"${capability_args[@]}"} \
    --append-system-prompt "$execution_system" "$execution_prompt"
else
  run_claude --session-id "$session_id" --name "FDE $run_id" \
    --mcp-config "$mcp_file" --permission-mode auto --tools default ${capability_args[@]+"${capability_args[@]}"} \
    --append-system-prompt "$execution_system" "$execution_prompt"
fi

echo
echo "Run: $run_id"
echo "Status: $FDE status $run_id"
