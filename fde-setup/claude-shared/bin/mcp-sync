#!/usr/bin/env python3
"""Generate every agent CLI's MCP config from one governed source file.

Claude Code, Gemini CLI and Codex CLI all speak MCP, but each stores it
somewhere different and in a different shape:

  Claude Code   <plugin>/.mcp.json          JSON  {"mcpServers": {...}}  type optional
  Gemini CLI    ~/.gemini/settings.json     JSON  streamable HTTP is "httpUrl", not "url"
  Codex CLI     ~/.codex/config.toml        TOML  [mcp_servers.<name>]

GitHub Copilot is not part of this ecosystem. Nothing here reads or writes
~/.copilot; if that directory exists it is left exactly as it is.

Two things decide what gets written, and both are refusals by default:

  targets     ["claude", "gemini", "codex"]  global — written into those CLIs'
                                             user config
              ["role:orchestrator"]          run-scoped — written for whoever
                                             holds that role in a given run, and
                                             only after the user has confirmed
                                             that run's roles

  readiness   a catalogue entry is not a grant. A server whose executable is
              missing, whose configuration is incomplete, whose sign-in has not
              happened, or whose mutation tools cannot be governed by the target
              client is reported and skipped — never written and never described
              as available.

Run-scoped servers never enter a global config. That is the point: there is no
permanently privileged orchestrator identity, so a connector that speaks for the
whole engagement must not be sitting in every profile waiting to be used.

Antigravity currently has no safe per-invocation MCP configuration argument.
FDE therefore does not write a misleading run-level Gemini config: the
orchestrator retrieves the approved evidence and passes the exact bounded files
through `fde invoke --context-file` instead.

  mcp-sync                      global targets only
  mcp-sync claude gemini        global, restricted to those CLIs
  mcp-sync --run <run-id>       write live run-scoped configs for clients that
                                support per-invocation MCP injection
  mcp-sync --profile data       restrict the effective set to one FDE profile
  mcp-sync --dry-run            show what would change; write, start and
                                download nothing
  mcp-sync --gateway-plan       show which direct entries a Docker MCP Gateway
                                would replace, and change nothing
  mcp-sync --json               machine-readable report for the console

Writes are merged, not overwritten: servers this tool manages are listed in
`_fdeManaged`, so a server you added by hand survives, and one this tool used to
manage but no longer targets is removed rather than left behind.
"""
import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
HOME = pathlib.Path(os.environ.get("HOME", pathlib.Path.home()))
SHARED = pathlib.Path(os.environ.get("CLAUDE_SHARED", HOME / ".claude-shared"))
for _candidate in (HERE.parent / "lib", SHARED / "lib"):
    if (_candidate / "fde_mcp.py").is_file():
        sys.path.insert(0, str(_candidate))
        break
import fde_mcp as mcp  # noqa: E402

RUNS = pathlib.Path(os.environ.get("FDE_RUNS_DIR", SHARED / "runs"))
PROFILES_DIR = pathlib.Path(os.environ.get("CLAUDE_PROFILES_DIR", HOME / ".claude-profiles"))
SRC = mcp.catalog_path()
BEGIN, END = "# >>> fde-mcp (generated by mcp-sync)", "# <<< fde-mcp"

GLOBAL_TARGETS = mcp.GLOBAL_TARGETS
KIND_TARGET = {"claude": "claude", "codex": "codex", "gemini": "gemini"}

# Which clients can be given a per-server tool allowlist, and where.
#
#   codex   `enabled_tools` on the [mcp_servers.<name>] table — user config or
#           per-invocation override, so global and run-scoped both work.
#   gemini  `includeTools` on the settings.json entry — but FDE reaches Gemini
#           through `agy mcp add`, which has no place to put it, so only the
#           legacy settings.json path can enforce anything.
#   claude  permission rules, not `.mcp.json`. A run-scoped binding ships its own
#           settings file alongside the MCP config; a plugin-level global
#           `.mcp.json` has nowhere to carry one.
GLOBAL_FILTERING = {"claude": False, "gemini": False, "codex": True}


# ------------------------------------------------------------------ helpers --

def read_json(p, default=None):
    return mcp.read_json(p, default)


def commit(path, data_or_text, dry, label, report, mode=0o644):
    if dry:
        print(f"  would write  {label:8s} {path}")
        report.setdefault("wouldWrite", []).append(str(path))
        return
    text = data_or_text if isinstance(data_or_text, str) \
        else json.dumps(data_or_text, indent=2) + "\n"
    mcp.write_private(pathlib.Path(path), text, mode)
    print(f"  wrote  {label:8s} {path}")
    report.setdefault("wrote", []).append(str(path))


def merge_servers(cfg, key, rendered, managed_key="_fdeManaged"):
    """Genuine merge: replace what we manage, prune what we no longer manage,
    and never touch a server someone added by hand."""
    cfg.setdefault(key, {})
    previously = set(cfg.get(managed_key) or [])
    now_managed = set(rendered)
    for gone in previously - now_managed:
        cfg[key].pop(gone, None)
    cfg[key].update(rendered)
    cfg[managed_key] = sorted(now_managed)
    return cfg


def splice_codex(path, block):
    existing = pathlib.Path(path).read_text() if pathlib.Path(path).exists() else ""
    if BEGIN in existing and END in existing:
        head, rest = existing.split(BEGIN, 1)
        _, tail = rest.split(END, 1)
        return head + block + tail
    return (existing.rstrip() + "\n\n" if existing.strip() else "") + block + "\n"


def load_state():
    return (mcp.load_user_config(), mcp.load_health())


def settings_map(catalog, user_doc, names):
    return {name: mcp.server_settings(user_doc, name) for name in names}


def screen(catalog, user_doc, health, names, *, client=None, secrets_dir=None):
    """Split candidate servers into (usable, skipped) with an honest reason.

    `client` adds the client-specific question: can THIS client be given a tool
    allowlist? A mutation-capable server that a client cannot scope is not
    written for that client, whatever the catalogue says."""
    usable, skipped = {}, {}
    for name in names:
        server = catalog.get(name)
        settings = mcp.server_settings(user_doc, name)
        state, reason = mcp.server_state(name, server, settings, health,
                                         secrets_dir=secrets_dir)
        if state != mcp.READY:
            skipped[name] = (state, reason)
            continue
        if client is not None:
            tools = mcp.enforceable_tools(name, server, settings, health)
            if tools is not None and not GLOBAL_FILTERING.get(client, False):
                skipped[name] = (mcp.BLOCKED, (
                    f"{client} cannot scope MCP tools in its user-level configuration, "
                    f"and this server exposes tools outside its read-only subset — "
                    f"reach it through a run-scoped binding instead"))
                continue
        usable[name] = server
    return usable, skipped


def announce_skips(skipped, label, report):
    for name, (state, reason) in sorted(skipped.items()):
        print(f"  skip   {label:8s} {name}: {state} — {mcp.redact(reason)}")
        report.setdefault("skipped", []).append(
            {"server": name, "target": label.strip(), "state": state,
             "reason": mcp.redact(reason)})


# --------------------------------------------------------------------- global --

def sync_global(catalog, user_doc, health, only, dry, report, profile=None):
    wrote = 0
    selected = catalog.for_profile(profile) if profile else catalog.enabled()
    globals_ = {n: s for n, s in selected.items()
                if any(t in GLOBAL_TARGETS for t in s["targets"])}

    if not only or "claude" in only:
        wanted = [n for n, s in globals_.items() if "claude" in s["targets"]]
        usable, skipped = screen(catalog, user_doc, health, wanted, client="claude")
        announce_skips(skipped, "claude", report)
        out = SHARED / "fde-toolkit/plugins/fde-core/.mcp.json"
        cfg = read_json(out)
        cfg.setdefault("_comment", "Generated by mcp-sync from ~/.claude-shared/mcp/"
                                   "mcp-servers.json. Only globally-targeted, ready, "
                                   "read-only servers appear here; role-restricted ones "
                                   "are written per run under the run's mcp/ directory. "
                                   "Edit the source file, not this one.")
        rendered = mcp.render_claude(usable, settings_by_name=settings_map(catalog, user_doc, usable),
                                     health=health)
        commit(out, merge_servers(cfg, "mcpServers", rendered), dry, "claude", report)
        wrote += 1

    if not only or "gemini" in only:
        wanted = [n for n, s in globals_.items() if "gemini" in s["targets"]]
        usable, skipped = screen(catalog, user_doc, health, wanted, client="gemini")
        announce_skips(skipped, "gemini", report)
        agy = shutil.which(os.environ.get("FDE_AGY_BIN", "agy"))
        if agy:
            state_path = SHARED / "mcp" / "agy-managed.json"
            previous = set(read_json(state_path, {"servers": []}).get("servers", []))
            rendered = mcp.render_gemini(usable, settings_by_name=settings_map(catalog, user_doc, usable),
                                         health=health)
            manageable = {name: entry for name, entry in rendered.items()
                          if not entry.get("headers") and not entry.get("env")}
            for name in sorted(set(rendered) - set(manageable)):
                print(f"  skip   gemini   {name} carries headers/env; refusing to put "
                      f"credentials in argv")
                report.setdefault("skipped", []).append(
                    {"server": name, "target": "gemini", "state": mcp.BLOCKED,
                     "reason": "credentials would have to pass through argv"})
            if dry:
                for name in sorted(previous - set(manageable)):
                    print(f"  would remove gemini   {name}")
                for name in sorted(manageable):
                    print(f"  would write  gemini   {name} through agy mcp")
                report.setdefault("wouldWrite", []).append(f"agy mcp: {sorted(manageable)}")
            else:
                for name in sorted(previous - set(manageable)):
                    subprocess.run([agy, "mcp", "remove", name], capture_output=True, text=True)
                installed = []
                for name in sorted(manageable):
                    entry, server = manageable[name], usable[name]
                    if entry.get("httpUrl") or entry.get("url"):
                        argv = [agy, "mcp", "add", "--type", "http", name,
                                entry.get("httpUrl") or entry["url"]]
                    else:
                        argv = [agy, "mcp", "add", name, entry["command"],
                                *[str(value) for value in entry.get("args", [])]]
                    result = subprocess.run(argv, capture_output=True, text=True)
                    if result.returncode == 0:
                        installed.append(name)
                        print(f"  wrote  gemini   {name} through agy mcp")
                    else:
                        print(f"  skip   gemini   agy refused {name}: exit {result.returncode}")
                commit(state_path, {"servers": installed}, False, "gemini", report)
            wrote += 1
        else:
            out = HOME / ".gemini/settings.json"
            if not out.parent.exists():
                print("  skip   gemini   (neither agy nor legacy ~/.gemini is installed)")
            else:
                cfg = read_json(out)
                cfg = merge_servers(cfg, "mcpServers",
                                    mcp.render_gemini(usable,
                                                      settings_by_name=settings_map(catalog, user_doc, usable),
                                                      health=health))
                ctx = cfg.setdefault("context", {})
                names = ctx.get("fileName") or []
                if isinstance(names, str):
                    names = [names]
                for n in ("AGENTS.md", "GEMINI.md"):
                    if n not in names:
                        names.append(n)
                ctx["fileName"] = names
                commit(out, cfg, dry, "gemini", report)
                wrote += 1

    if not only or "codex" in only:
        wanted = [n for n, s in globals_.items() if "codex" in s["targets"]]
        usable, skipped = screen(catalog, user_doc, health, wanted, client="codex")
        announce_skips(skipped, "codex", report)
        out = HOME / ".codex/config.toml"
        if not out.parent.exists():
            print("  skip   codex    (not installed — no ~/.codex)")
        else:
            block = mcp.render_codex_block(
                usable, settings_by_name=settings_map(catalog, user_doc, usable),
                health=health, begin=BEGIN, end=END)
            commit(out, splice_codex(out, block), dry, "codex", report)
            wrote += 1

    if (HOME / ".copilot").exists():
        print("  skip   copilot  (GitHub Copilot is not part of this ecosystem — "
              "~/.copilot is left untouched)")
    return wrote


# ----------------------------------------------------------------- run-scoped --

def run_context(run_dir):
    """The approved stages, confirmed role assignments and selected profile."""
    roles = read_json(run_dir / "roles.json", {})
    plan = read_json(run_dir / "plan.json", {})
    manifest = read_json(run_dir / "manifest.json", {})
    return {
        "roles": roles,
        "assignments": roles.get("assignments") or {},
        "stages": list(plan.get("stages") or []),
        "profile": manifest.get("mcpProfile") or plan.get("mcpProfile"),
    }


def sync_run(catalog, user_doc, health, run_id, dry, report, profile=None):
    run_dir = RUNS / run_id
    if not run_dir.is_dir():
        sys.exit(f"no such run: {run_id}")
    context = run_context(run_dir)
    if not context["roles"].get("confirmedAt"):
        sys.exit(f"run {run_id} has no confirmed roles — nothing may be wired up yet")
    agents = read_json(SHARED / "config" / "agents.json", {}).get("agents", {})
    assignments = context["assignments"]
    profile = profile or context["profile"]
    stages = context["stages"]

    out_dir = run_dir / "mcp"
    # Collect every role-scoped server for an identity before writing its file.
    # Writing one server at a time would make merge_servers correctly prune the
    # server written by the previous iteration, leaving only the last binding.
    bindings, per_identity_reasons = {}, {}
    for name, (server, want_roles) in catalog.role_servers().items():
        holders = []
        held_roles = []
        for role in want_roles:
            v = assignments.get(role)
            if not v:
                continue
            held_roles.append(role)
            holders += v if isinstance(v, list) else [v]
        if not holders:
            continue
        chosen, rejected = mcp.effective_servers(
            catalog, roles=set(held_roles), stages=stages, profile=profile,
            user_doc=user_doc, health=health, selected={name}, include_global=False)
        if name not in chosen:
            state, reason = rejected.get(name, (mcp.BLOCKED, "not part of the effective set"))
            per_identity_reasons[name] = (state, reason)
            continue
        for aid in dict.fromkeys(h for h in holders if h):
            bindings.setdefault(aid, {})[name] = server
    announce_skips(per_identity_reasons, "run", report)

    written, effective = [], {}
    for aid, selected in bindings.items():
        a = agents.get(aid, {})
        kind = a.get("kind")
        target = KIND_TARGET.get(kind)
        if not target:
            names = ", ".join(selected)
            print(f"  skip   {names} for {aid}: no MCP surface for kind '{kind}'")
            report.setdefault("skipped", []).append(
                {"server": names, "target": str(kind), "state": mcp.BLOCKED,
                 "reason": f"no MCP surface for kind '{kind}'"})
            continue
        if kind == "gemini":
            names = ", ".join(sorted(selected))
            reason = ("Antigravity has no per-invocation MCP config; retrieve the approved "
                      "evidence through the orchestrator and pass it with "
                      "fde invoke --context-file")
            print(f"  handoff {names} for {aid}: {reason}")
            report.setdefault("skipped", []).append(
                {"server": names, "target": "gemini", "identity": aid,
                 "state": mcp.BLOCKED, "reason": reason})
            continue
        maps = settings_map(catalog, user_doc, selected)
        if kind == "claude":
            profile_name = a.get("profile", aid)
            p = out_dir / f"claude-{profile_name}.mcp.json"
            cfg = read_json(p, {})
            cfg = merge_servers(cfg, "mcpServers",
                                mcp.render_claude(selected, settings_by_name=maps, health=health))
            commit(p, cfg, dry, "run", report, mode=0o600)
            # Claude scopes MCP tools through permission rules, not .mcp.json.
            # The two files travel together: --mcp-config names the servers,
            # --settings names exactly which of their tools may be called.
            perms = out_dir / f"claude-{profile_name}.settings.json"
            commit(perms, mcp.render_claude_permissions(selected, settings_by_name=maps,
                                                        health=health),
                   dry, "run", report, mode=0o600)
            launch = mcp.claude_launch_env(selected)
            if launch:
                commit(out_dir / f"claude-{profile_name}.env.json", launch, dry, "run",
                       report, mode=0o600)
        else:
            p = out_dir / "codex.toml"
            commit(p, splice_codex(p, mcp.render_codex_block(
                selected, settings_by_name=maps, health=health, begin=BEGIN, end=END)),
                dry, "run", report, mode=0o600)
        for name in selected:
            written.append(f"{name} -> {aid}")
            effective.setdefault(name, []).append(aid)

    # Stale bindings: an identity that no longer holds a role, or a profile that
    # narrowed, must lose its generated files rather than keep a working one.
    prune_stale(out_dir, bindings, agents, dry, report)

    if not dry:
        commit(out_dir / "effective.json", {
            "schemaVersion": mcp.SCHEMA_VERSION,
            "runId": run_id,
            "profile": profile,
            "stages": stages,
            "servers": {name: {"identities": sorted(ids),
                               "mutation": catalog.get(name)["mutation"],
                               "classification": catalog.get(name)["classification"],
                               "allowedTools": mcp.enforceable_tools(
                                   name, catalog.get(name),
                                   mcp.server_settings(user_doc, name), health)}
                        for name, ids in effective.items()},
            "refused": {name: {"state": state, "reason": mcp.redact(reason)}
                        for name, (state, reason) in per_identity_reasons.items()},
        }, False, "run", report, mode=0o600)

    if written and not dry:
        commit(out_dir / "README.md", run_readme(run_id, out_dir, effective, catalog),
               False, "run", report)
    if not written:
        print("  none   no live run-scoped MCP binding is available for this run's identities")
    report["effective"] = effective
    return written


def prune_stale(out_dir, bindings, agents, dry, report):
    """Remove generated bindings that no longer describe this run."""
    if not out_dir.is_dir():
        return
    keep = {"effective.json"}
    has_live_binding = False
    for aid in bindings:
        kind = (agents.get(aid) or {}).get("kind")
        if kind == "claude":
            has_live_binding = True
            profile_name = (agents.get(aid) or {}).get("profile", aid)
            keep.update({f"claude-{profile_name}.mcp.json",
                         f"claude-{profile_name}.settings.json",
                         f"claude-{profile_name}.env.json"})
        elif kind == "codex":
            has_live_binding = True
            keep.add("codex.toml")
    if has_live_binding:
        keep.add("README.md")
    for path in sorted(out_dir.iterdir()):
        if not path.is_file() or path.name in keep:
            continue
        if not (path.name.startswith("claude-") or
                path.name in ("gemini.json", "codex.toml", "README.md")):
            continue
        if dry:
            print(f"  would remove run      {path.name} (no longer applicable)")
            report.setdefault("wouldRemove", []).append(str(path))
        else:
            path.unlink()
            print(f"  removed run      {path.name} (no longer applicable)")
            report.setdefault("removed", []).append(str(path))


def run_readme(run_id, out_dir, effective, catalog):
    lines = [
        f"# Run-scoped MCP configuration — {run_id}", "",
        "These connectors are restricted by role. They are deliberately absent from",
        "every identity's global config, so nothing here is reachable until the user",
        "has assigned the role — which they did for this run, and only this run.", "",
        "Wire them in per invocation, not permanently:", "",
        "```bash",
        "CLAUDE_CONFIG_DIR=~/.claude-profiles/<profile> \\",
        f"  claude --mcp-config {out_dir / 'claude-<profile>.mcp.json'} \\",
        f"         --settings {out_dir / 'claude-<profile>.settings.json'}",
        "```", "",
        "The settings file is not optional. `--mcp-config` says which servers exist;",
        "`--settings` says which of their tools may be called. Loading the first",
        "without the second hands the session tools this run never approved.", "",
        "## What this run may reach", "",
    ]
    for name in sorted(effective):
        server = catalog.get(name)
        lines.append(f"- **{name}** — {server['classification']}, {server['mutation']}; "
                     f"held by {', '.join(sorted(effective[name]))}")
        if server["readOnlyPolicy"] == "client-credential":
            lines.append("  - **unscoped:** this provider's OAuth token belongs to the MCP "
                         "client, so FDE cannot give it a tool allowlist. It reaches the "
                         "session with every tool it offers, and its writes are governed by "
                         "`fde approve-publish` alone — a gate at publication, not at the "
                         "tool call. Pin a read-only set with "
                         f"`fde mcp configure {name} --set allowTools=<comma-separated>`.")
        if server["useWhen"]:
            lines.append(f"  - use when: {server['useWhen']}")
        if server["doNotUseWhen"]:
            lines.append(f"  - not for: {server['doNotUseWhen']}")
    lines += [
        "", "Reads are permitted once roles are confirmed. Writes to Jira, Confluence,",
        "SharePoint, Bitbucket, Figma, a cloud account, a database, a browser form,",
        "email or Teams are not — those need `fde approve-publish <run-id> <target>`",
        "first, every time. No credential appears in this directory: generated",
        "configuration references environment variables, and the values are injected",
        "into the one child process that needs them.", "",
    ]
    return "\n".join(lines)


# ------------------------------------------------------------------- gateway --

def gateway_report(catalog, profile, report):
    plan = mcp.gateway_plan(catalog, profile=profile)
    report["gateway"] = plan
    print()
    print("  Docker MCP Gateway")
    print(f"    available   {plan['available']} — {plan['detail']}")
    if not plan["available"]:
        print("    Docker is optional for FDE. Nothing here depends on it; this is a")
        print("    preview of what would change if you installed it.")
    if plan["routedThroughGateway"]:
        print("    would route through the gateway (and be removed from direct config):")
        for name, docker_profile in sorted(plan["routedThroughGateway"].items()):
            print(f"      {name:16s} -> docker profile '{docker_profile}'")
    mapped = {}
    for name, server in catalog.enabled().items():
        docker_profile = (server.get("gateway") or {}).get("docker")
        if docker_profile:
            mapped.setdefault(docker_profile, []).append(name)
    print("    FDE profile -> Docker profile:")
    for docker_profile, names in sorted(mapped.items()):
        print(f"      {docker_profile:16s} {', '.join(sorted(names))}")
    print("    FDE remains the policy authority for run roles and approval gates.")
    print("    A server is never configured both directly and through the gateway.")
    return 0


# ---------------------------------------------------------------------- main --

def main():
    ap = argparse.ArgumentParser(prog="mcp-sync", description=__doc__.splitlines()[0])
    ap.add_argument("targets", nargs="*", default=[],
                    help="limit global sync to these CLIs: " + ", ".join(GLOBAL_TARGETS))
    ap.add_argument("--run", metavar="RUN-ID", help="write run-scoped configs for a confirmed run")
    ap.add_argument("--profile", metavar="NAME",
                    help="restrict the effective set to one FDE profile (see: fde mcp profiles)")
    ap.add_argument("--dry-run", action="store_true",
                    help="show what would change; write, start and download nothing")
    ap.add_argument("--gateway-plan", action="store_true",
                    help="report Docker MCP Gateway routing and change nothing")
    ap.add_argument("--json", action="store_true", help="machine-readable report on stdout")
    args = ap.parse_args()

    bad = [t for t in args.targets if t not in GLOBAL_TARGETS]
    if bad:
        sys.exit(f"unknown target(s): {', '.join(bad)}. Known: {', '.join(GLOBAL_TARGETS)}")

    if args.json:
        # Narration belongs on stderr when the caller wants a parseable answer.
        sys.stdout, real_stdout = sys.stderr, sys.stdout
    report = {"schemaVersion": mcp.SCHEMA_VERSION, "source": str(SRC),
              "dryRun": bool(args.dry_run), "profile": args.profile}

    try:
        catalog = mcp.Catalog.load(SRC)
    except mcp.CatalogError as exc:
        for problem in exc.problems:
            print(f"  invalid  {problem}", file=sys.stderr)
        sys.exit(f"{exc.message} — nothing was written")
    if args.profile and args.profile not in catalog.profiles:
        sys.exit(f"unknown profile '{args.profile}'. Known: "
                 f"{', '.join(sorted(catalog.profiles)) or '(none declared)'}")
    if catalog.migrated:
        print("  note   this catalogue is still schema version 1; it was migrated in "
              "memory. Run: fde mcp migrate", file=sys.stderr)

    user_doc, health = load_state()
    if not catalog.servers:
        sys.exit("no servers defined; nothing to do")

    if args.gateway_plan:
        gateway_report(catalog, args.profile, report)
    elif args.run:
        written = sync_run(catalog, user_doc, health, args.run, args.dry_run, report,
                           profile=args.profile)
        print(f"\n{len(written)} role-restricted server binding(s) for run {args.run}")
    else:
        selected = catalog.for_profile(args.profile) if args.profile else catalog.enabled()
        glob = {n: s for n, s in selected.items()
                if any(t in GLOBAL_TARGETS for t in s["targets"])}
        scoped = {n for n, s in selected.items()
                  if any(str(t).startswith("role:") for t in s["targets"])}
        sync_global(catalog, user_doc, health, args.targets, args.dry_run, report,
                    profile=args.profile)
        print(f"\n{len(glob)} global server(s) considered from {SRC}")
        if scoped:
            print(f"{len(scoped)} role-restricted server(s) held back: "
                  f"{', '.join(sorted(scoped))} — written per run by: mcp-sync --run <run-id>")

    if args.json:
        sys.stdout = real_stdout
        print(json.dumps(mcp.redact(report), indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
