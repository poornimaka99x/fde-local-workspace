#!/usr/bin/env python3
"""Generate every agent CLI's MCP config from one source file.

Claude Code, Gemini CLI and Codex CLI all speak MCP, but each stores it
somewhere different and in a different shape:

  Claude Code   <plugin>/.mcp.json          JSON  {"mcpServers": {...}}  type optional
  Gemini CLI    ~/.gemini/settings.json     JSON  streamable HTTP is "httpUrl", not "url"
  Codex CLI     ~/.codex/config.toml        TOML  [mcp_servers.<name>]

GitHub Copilot is not part of this ecosystem. Nothing here reads or writes
~/.copilot; if that directory exists it is left exactly as it is.

Not every server belongs to every identity. Each server declares `targets`:

  ["claude", "gemini", "codex"]   global — written into those CLIs' user config
  ["role:orchestrator"]           run-scoped — written for whoever holds that
                                  role in a given run, and only after the user
                                  has confirmed that run's roles

Run-scoped servers never enter a global config. That is the point: there is no
permanently privileged orchestrator identity, so a connector that speaks for the
whole engagement must not be sitting in every profile waiting to be used.

  mcp-sync                    global targets only
  mcp-sync claude gemini      global, restricted to those CLIs
  mcp-sync --run <run-id>     write the run-scoped configs for a confirmed run
  mcp-sync --dry-run          show what would change, write nothing

Writes are merged, not overwritten: servers this tool manages are listed in
`_fdeManaged`, so a server you added by hand survives, and one this tool used to
manage but no longer targets is removed rather than left behind.
"""
import argparse
import json
import os
import pathlib
import sys

HOME = pathlib.Path(os.environ.get("HOME", pathlib.Path.home()))
SHARED = pathlib.Path(os.environ.get("CLAUDE_SHARED", HOME / ".claude-shared"))
RUNS = pathlib.Path(os.environ.get("FDE_RUNS_DIR", SHARED / "runs"))
PROFILES_DIR = pathlib.Path(os.environ.get("CLAUDE_PROFILES_DIR", HOME / ".claude-profiles"))
SRC = SHARED / "mcp" / "mcp-servers.json"
BEGIN, END = "# >>> fde-mcp (generated by mcp-sync)", "# <<< fde-mcp"

GLOBAL_TARGETS = ("claude", "gemini", "codex")
KIND_TARGET = {"claude": "claude", "codex": "codex", "gemini": "gemini"}


# ------------------------------------------------------------------ helpers --

def load_src():
    if not SRC.exists():
        sys.exit(f"no source file at {SRC}")
    data = json.loads(SRC.read_text())
    servers = data.get("servers", {})
    for name, s in servers.items():
        if "targets" not in s:
            print(f"  note   '{name}' declares no targets — defaulting to every CLI. "
                  f"Say so explicitly in {SRC}.", file=sys.stderr)
            s["targets"] = list(GLOBAL_TARGETS)
    return servers


def split_targets(servers):
    """(global servers, role-scoped servers). A server is never in both."""
    glob, scoped = {}, {}
    for name, s in servers.items():
        roles = [t.split(":", 1)[1] for t in s["targets"] if t.startswith("role:")]
        if roles:
            scoped[name] = (s, roles)
        else:
            glob[name] = s
    return glob, scoped


def for_target(servers, target):
    return {n: s for n, s in servers.items() if target in s["targets"]}


def read_json(p, default=None):
    try:
        return json.loads(p.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {} if default is None else default


def is_http(s):
    return s.get("transport", "stdio") in ("http", "sse")


def merge_servers(cfg, key, rendered, dry):
    """Genuine merge: replace what we manage, prune what we no longer manage,
    and never touch a server someone added by hand."""
    cfg.setdefault(key, {})
    previously = set(cfg.get("_fdeManaged", []))
    now_managed = set(rendered)
    for gone in previously - now_managed:
        cfg[key].pop(gone, None)
    cfg[key].update(rendered)
    cfg["_fdeManaged"] = sorted(now_managed)
    return cfg


def commit(path, data_or_text, dry, label):
    if dry:
        print(f"  would write  {label:8s} {path}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    text = data_or_text if isinstance(data_or_text, str) else json.dumps(data_or_text, indent=2) + "\n"
    tmp = path.with_suffix(path.suffix + f".tmp{os.getpid()}")
    tmp.write_text(text)
    os.replace(tmp, path)
    print(f"  wrote  {label:8s} {path}")


# ------------------------------------------------------------------ renderers --

def render_claude(servers):
    m = {}
    for name, s in servers.items():
        if is_http(s):
            m[name] = {"type": s["transport"], "url": s["url"]}
        else:
            m[name] = {k: v for k, v in s.items() if k in ("command", "args", "env", "cwd")}
        if "headers" in s:
            m[name]["headers"] = s["headers"]
    return m


def render_gemini(servers):
    """Gemini CLI: streamable HTTP goes in `httpUrl`; `url` means SSE."""
    m = {}
    for name, s in servers.items():
        e = {}
        if s.get("transport") == "http":
            e["httpUrl"] = s["url"]
        elif s.get("transport") == "sse":
            e["url"] = s["url"]
        else:
            e["command"] = s["command"]
            if "args" in s:
                e["args"] = s["args"]
            if "env" in s:
                e["env"] = s["env"]
        if "headers" in s:
            e["headers"] = s["headers"]
        m[name] = e
    return m


def toml_str(v):
    return json.dumps(v)


def render_codex_block(servers):
    lines = [BEGIN]
    for name, s in servers.items():
        lines.append(f"[mcp_servers.{name}]")
        if is_http(s):
            lines.append(f"url = {toml_str(s['url'])}")
            if "bearer_token_env_var" in s:
                lines.append(f"bearer_token_env_var = {toml_str(s['bearer_token_env_var'])}")
        else:
            lines.append(f"command = {toml_str(s['command'])}")
            if s.get("args"):
                lines.append("args = [" + ", ".join(toml_str(a) for a in s["args"]) + "]")
        if s.get("env"):
            lines.append(f"[mcp_servers.{name}.env]")
            for k, v in s["env"].items():
                lines.append(f"{k} = {toml_str(v)}")
        lines.append("")
    lines.append("# Anything you add below this marker joins the LAST table above,")
    lines.append("# because that is how TOML scoping works. Put your own keys above it.")
    lines.append(END)
    return "\n".join(lines)


def splice_codex(path, block):
    existing = path.read_text() if path.exists() else ""
    if BEGIN in existing and END in existing:
        head, rest = existing.split(BEGIN, 1)
        _, tail = rest.split(END, 1)
        return head + block + tail
    return (existing.rstrip() + "\n\n" if existing.strip() else "") + block + "\n"


# --------------------------------------------------------------------- global --

def sync_global(servers, only, dry):
    wrote = 0

    if not only or "claude" in only:
        sel = for_target(servers, "claude")
        out = SHARED / "fde-toolkit/plugins/fde-core/.mcp.json"
        cfg = read_json(out)
        cfg.setdefault("_comment", "Generated by mcp-sync from ~/.claude-shared/mcp/"
                                   "mcp-servers.json. Edit the source file, not this one.")
        commit(out, merge_servers(cfg, "mcpServers", render_claude(sel), dry), dry, "claude")
        wrote += 1

    if not only or "gemini" in only:
        out = HOME / ".gemini/settings.json"
        if not out.parent.exists():
            print("  skip   gemini   (not installed — no ~/.gemini)")
        else:
            sel = for_target(servers, "gemini")
            cfg = read_json(out)
            cfg = merge_servers(cfg, "mcpServers", render_gemini(sel), dry)
            ctx = cfg.setdefault("context", {})
            names = ctx.get("fileName") or []
            if isinstance(names, str):
                names = [names]
            for n in ("AGENTS.md", "GEMINI.md"):
                if n not in names:
                    names.append(n)
            ctx["fileName"] = names
            commit(out, cfg, dry, "gemini")
            wrote += 1

    if not only or "codex" in only:
        out = HOME / ".codex/config.toml"
        if not out.parent.exists():
            print("  skip   codex    (not installed — no ~/.codex)")
        else:
            sel = for_target(servers, "codex")
            commit(out, splice_codex(out, render_codex_block(sel)), dry, "codex")
            wrote += 1

    if (HOME / ".copilot").exists():
        print("  skip   copilot  (GitHub Copilot is not part of this ecosystem — "
              "~/.copilot is left untouched)")
    return wrote


# ----------------------------------------------------------------- run-scoped --

def sync_run(scoped, run_id, dry):
    run_dir = RUNS / run_id
    if not run_dir.is_dir():
        sys.exit(f"no such run: {run_id}")
    roles = read_json(run_dir / "roles.json", {})
    if not roles.get("confirmedAt"):
        sys.exit(f"run {run_id} has no confirmed roles — nothing may be wired up yet")
    agents = read_json(SHARED / "config" / "agents.json", {}).get("agents", {})
    assignments = roles.get("assignments", {})

    out_dir = run_dir / "mcp"
    # Collect every role-scoped server for an identity before writing its file.
    # Writing one server at a time would make merge_servers correctly prune the
    # server written by the previous iteration, leaving only the last binding.
    bindings = {}
    for name, (s, want_roles) in scoped.items():
        holders = []
        for role in want_roles:
            v = assignments.get(role)
            holders += (v if isinstance(v, list) else [v]) if v else []
        for aid in dict.fromkeys(h for h in holders if h):
            bindings.setdefault(aid, {})[name] = s

    written = []
    for aid, selected in bindings.items():
        a = agents.get(aid, {})
        kind = a.get("kind")
        target = KIND_TARGET.get(kind)
        if not target:
            names = ", ".join(selected)
            print(f"  skip   {names} for {aid}: no MCP surface for kind '{kind}'")
            continue
        if kind == "claude":
            p = out_dir / f"claude-{a.get('profile', aid)}.mcp.json"
            cfg = read_json(p, {})
            cfg = merge_servers(cfg, "mcpServers", render_claude(selected), dry)
            commit(p, cfg, dry, "run")
        elif kind == "gemini":
            p = out_dir / "gemini.json"
            cfg = read_json(p, {})
            cfg = merge_servers(cfg, "mcpServers", render_gemini(selected), dry)
            commit(p, cfg, dry, "run")
        else:
            p = out_dir / "codex.toml"
            commit(p, splice_codex(p, render_codex_block(selected)), dry, "run")
        written.extend(f"{name} -> {aid}" for name in selected)

    if written and not dry:
        commit(out_dir / "README.md",
               f"# Run-scoped MCP configuration — {run_id}\n\n"
               "These connectors are restricted by role. They are deliberately absent from\n"
               "every identity's global config, so nothing here is reachable until the user\n"
               "has assigned the role — which they did for this run, and only this run.\n\n"
               "Wire them in per invocation, not permanently:\n\n"
               "```bash\n"
               "CLAUDE_CONFIG_DIR=~/.claude-profiles/<profile> \\\n"
               "  claude --mcp-config " + str(out_dir / "claude-<profile>.mcp.json") + "\n"
               "```\n\n"
               "Reads are permitted once roles are confirmed. Writes to Jira, Confluence,\n"
               "SharePoint, Bitbucket, Figma, email or Teams are not — those need\n"
               "`fde approve-publish <run-id> <target>` first, every time.\n\n"
               "Generated: " + ", ".join(written) + "\n", dry, "run")
    if not written:
        print("  none   no role-restricted server matches this run's assignments")
    return written


def main():
    ap = argparse.ArgumentParser(prog="mcp-sync", description=__doc__.splitlines()[0])
    ap.add_argument("targets", nargs="*", default=[],
                    help="limit global sync to these CLIs: " + ", ".join(GLOBAL_TARGETS))
    ap.add_argument("--run", metavar="RUN-ID", help="write run-scoped configs for a confirmed run")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    bad = [t for t in args.targets if t not in GLOBAL_TARGETS]
    if bad:
        sys.exit(f"unknown target(s): {', '.join(bad)}. Known: {', '.join(GLOBAL_TARGETS)}")

    servers = load_src()
    if not servers:
        sys.exit("no servers defined; nothing to do")
    glob, scoped = split_targets(servers)

    if args.run:
        written = sync_run(scoped, args.run, args.dry_run)
        print(f"\n{len(written)} role-restricted server binding(s) for run {args.run}")
        return 0

    sync_global(glob, args.targets, args.dry_run)
    print(f"\n{len(glob)} global server(s) synced from {SRC}")
    if scoped:
        print(f"{len(scoped)} role-restricted server(s) held back: "
              f"{', '.join(scoped)} — written per run by: mcp-sync --run <run-id>")
    return 0


if __name__ == "__main__":
    sys.exit(main())
