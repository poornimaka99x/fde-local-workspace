#!/usr/bin/env python3
"""Microsoft option 3 — the human-in-the-loop path, made not annoying.

Copilot Notebooks have no export API; getting content out is copy-paste or a
Word export. That is fine, as long as the drop is one step and the result lands
somewhere Claude reads automatically.

  ms-intake <file-or-->  --title "Q3 returns discovery"  [--kind meeting|doc|thread]
                         [--space ENG --parent 123456]

What it does:
  1. files the raw text under ~/.claude-shared/intake/<date>-<slug>.md with a
     header saying where it came from, so Claude has it locally straight away
  2. optionally pushes it to Confluence, so the PO and the team see it too
  3. prints the path, so you can hand it straight to a Claude session

Typical use — paste from a Copilot Notebook or a Teams recap:
  pbpaste | ms-intake - --title "Maxeda returns call 14 Mar" --kind meeting
  ms-intake ~/Downloads/CopilotNotebook.docx --title "Returns policy review"

.docx is converted if pandoc or python-docx is available; otherwise it tells you
rather than filing something empty.
"""
import datetime, os, pathlib, re, shutil, subprocess, sys

SHARED = pathlib.Path(os.environ.get("CLAUDE_SHARED", pathlib.Path.home() / ".claude-shared"))
INTAKE = SHARED / "intake"


def slug(s):
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s.lower())).strip("-")[:60]


def read_docx(path):
    if shutil.which("pandoc"):
        return subprocess.run(["pandoc", "-t", "markdown", str(path)],
                              capture_output=True, text=True, check=True).stdout
    try:
        import docx  # python-docx
    except ImportError:
        sys.exit("install pandoc or `pip install python-docx --break-system-packages` "
                 "to read .docx, or paste the text instead")
    return "\n\n".join(p.text for p in docx.Document(str(path)).paragraphs if p.text.strip())


def arg(flag, default=None):
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv else default


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    src = sys.argv[1]
    title = arg("--title") or "untitled intake"
    kind = arg("--kind", "doc")
    space, parent = arg("--space"), arg("--parent")

    if src == "-":
        text = sys.stdin.read()
        origin = "pasted from clipboard / Copilot Notebook"
    else:
        p = pathlib.Path(src).expanduser()
        if not p.exists():
            sys.exit(f"no such file: {p}")
        text = read_docx(p) if p.suffix.lower() == ".docx" else p.read_text(encoding="utf-8")
        origin = str(p)

    if not text.strip():
        sys.exit("nothing to file — the source was empty")

    INTAKE.mkdir(parents=True, exist_ok=True)
    today = datetime.date.today().isoformat()
    out = INTAKE / f"{today}-{slug(title)}.md"
    out.write_text(
        f"# {title}\n\n"
        f"- kind: {kind}\n- captured: {today}\n- origin: {origin}\n"
        f"- note: unverified source material. Verify claims before repeating them.\n\n"
        f"---\n\n{text.strip()}\n", encoding="utf-8")
    print(f"filed  {out}")

    if space:
        cli = SHARED / "bin" / "confluence"
        cmd = [str(cli), "create", space, title, str(out)]
        if parent:
            cmd += ["--parent", parent]
        r = subprocess.run(cmd)
        if r.returncode != 0:
            print("  (Confluence push failed — the local copy is still filed)", file=sys.stderr)
    else:
        print("  not pushed to Confluence (pass --space to publish)")

    print(f"\nHand to Claude with:  @{out}")


if __name__ == "__main__":
    main()
