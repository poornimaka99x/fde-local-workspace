#!/usr/bin/env bash
# Ask Gemini a question headlessly, through the Antigravity CLI (agy).
#   ask-gemini --task-file tasks/review.md --context-file evidence/jira.md
#   git diff | ask-gemini "what would break in production?"
#   ask-gemini --check          report whether a sign-in resolves (prints no credential)
#   ask-gemini --models         the models this sign-in can reach
#
# Lane: bulk reading, long context, and web-grounded research (Claude on Bedrock
# has no WebSearch, so this is the research fallback there).
#
# Accounts: Antigravity keeps its token in the operating system's keyring, not in
# a per-account directory, so this machine has ONE Antigravity sign-in and the
# controller's registry caps it at one account. Nothing here reads that keyring;
# `--check` asks agy itself.
#
# Antigravity's blanket auto-approval flag is refused here, for the same reason
# ask-codex refuses Codex's sandbox bypasses: what this toolkit may approve is
# decided by the controller and the user, not by a caller of this script. The
# refusal is below; the flag itself appears exactly once, on the line that
# refuses it, so the repo-wide scan for these strings stays meaningful.
set -uo pipefail

die() { printf 'ask-gemini: %s\n' "$*" >&2; exit 1; }

AGY="${FDE_AGY_BIN:-agy}"
missing() {
  echo "Antigravity CLI not installed: see https://antigravity.google/docs/cli" >&2
  echo "  the binary is 'agy'; set FDE_AGY_BIN if it lives somewhere unusual" >&2
  exit 127
}

gemini_account_check() {
  # Asks agy which models this sign-in can reach. Sends no prompt, so it costs
  # nothing, and a signed-out CLI cannot answer it. Prints no credential.
  local out
  if out="$("$AGY" models 2>&1)"; then
    printf 'Gemini (Antigravity): signed in — %s model(s) reachable\n' \
      "$(printf '%s\n' "$out" | grep -c .)"
    return 0
  fi
  printf 'ask-gemini: Antigravity is not signed in on this machine\n' >&2
  printf '  sign it in:  fde accounts login <account-id>   (or run: %s)\n' "$AGY" >&2
  return 1
}

case "${1:-}" in
  --check)  command -v "$AGY" >/dev/null || missing; gemini_account_check; exit $? ;;
  --models) command -v "$AGY" >/dev/null || missing; exec "$AGY" models ;;
  --dangerously-skip-permissions)  # fde-safety-exempt: refusal, not an invocation
    die "refusing: '$1' is not available through this toolkit. What may be
            approved is decided by the controller and the user, not here." ;;
esac

command -v "$AGY" >/dev/null || missing

# The standing brief goes FIRST and byte-identical on every call: Antigravity,
# Gemini and Codex all do automatic prefix caching, and a prefix that shifts by
# one byte is a full cache miss. The variable question goes LAST, after the
# separator, for the same reason. Set FDE_NO_PREAMBLE=1 to send the bare question.
compose_prompt() {  # compose_prompt <question> [context-file ...]
  local question="$1"; shift
  local pre="${FDE_SIDECAR_PREAMBLE:-${CLAUDE_SHARED:-$HOME/.claude-shared}/prompts/sidecar-preamble.md}"
  if [[ "${FDE_NO_PREAMBLE:-}" == "1" || ! -r "$pre" ]]; then
    if [[ $# -eq 0 ]]; then printf '%s' "$question"; return 0; fi
    for f in "$@"; do
      [[ -f "$f" && ! -L "$f" && -r "$f" ]] || die "context file is not a readable regular file: $f"
      [[ $(wc -c < "$f") -le 524288 ]] || die "context file is over the 512 KiB limit: $f"
      printf '# Reference: %s\n\n%s\n\n' "$(basename "$f")" "$(cat "$f")"
    done
    printf '# Question\n\n%s' "$question"; return 0
  fi
  printf '%s' "$(cat "$pre")"
  # FDE_SIDECAR_CONTEXT: colon-separated files of reference material that is the
  # same for every call of this kind — a standards section, an ADR, an API spec.
  # It sits in the cacheable position, so both providers' minimum cacheable
  # prefix (~1k tokens; the brief alone is under it) is reached on a review or
  # implementation call, and every later call in the run reads from cache.
  #   FDE_SIDECAR_CONTEXT="$(standards path)" ask-codex --read-only "..."
  local IFS=:
  local f
  for f in ${FDE_SIDECAR_CONTEXT:-}; do
    [[ -r "$f" ]] || continue
    printf '\n\n# Reference: %s\n\n%s' "$(basename "$f")" "$(cat "$f")"
  done
  for f in "$@"; do
    [[ -f "$f" && ! -L "$f" && -r "$f" ]] || die "context file is not a readable regular file: $f"
    [[ $(wc -c < "$f") -le 524288 ]] || die "context file is over the 512 KiB limit: $f"
    printf '\n\n# Reference: %s\n\n%s' "$(basename "$f")" "$(cat "$f")"
  done
  printf '\n\n# Question\n\n%s' "$question"
}

task_file=""; prompt=""; model="${GEMINI_MODEL:-}"; effort="${GEMINI_EFFORT:-}"
context_files=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --task-file) task_file="${2:-}"; shift 2 ;;
    --context-file) context_files+=("${2:-}"); shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --effort) effort="${2:-}"; shift 2 ;;
    --dangerously-skip-permissions)  # fde-safety-exempt: refusal, not an invocation
      die "refusing: '$1' is not available through this toolkit. What may be
            approved is decided by the controller and the user, not here." ;;
    --) shift; prompt="$prompt $*"; break ;;
    *) prompt="$prompt $1"; shift ;;
  esac
done
prompt="${prompt# }"
if [[ -n "$task_file" ]]; then
  [[ -f "$task_file" && ! -L "$task_file" && -r "$task_file" ]] || die "no readable task file at $task_file"
  prompt="$(cat "$task_file")"
fi
[[ -n "${prompt// }" ]] || die "nothing to ask"

if [[ -n "${FDE_RUN_ID:-}" && "${FDE_ROUTED_INVOCATION:-}" != "1" ]]; then
  die "inside FDE run $FDE_RUN_ID, invoke the assigned Gemini identity through:
            fde invoke $FDE_RUN_ID <gemini-identity> <task-file> --stage <stage>
       Direct sidecar calls bypass role checks and the run's evidence handoff."
fi

prompt="$(compose_prompt "$prompt" ${context_files[@]+"${context_files[@]}"})"

# Model and effort are validated and passed as separate argv elements, never
# interpolated into a string, so a value cannot carry an option with it. Empty
# leaves agy's own default alone.
options=()
if [[ -n "$model" && "$model" != "default" ]]; then
  [[ "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$ ]] || die "unusable GEMINI_MODEL value"
  options+=(--model "$model")
fi
if [[ -n "$effort" && "$effort" != "auto" ]]; then
  case "$effort" in
    low|medium|high) options+=(--effort "$effort") ;;
    *) die "unusable GEMINI_EFFORT value: $effort (low, medium or high)" ;;
  esac
fi

# The prompt is the value of -p and always the last argument, so a question that
# begins with a dash is text and can never become a flag.
"$AGY" ${options[@]+"${options[@]}"} --mode plan --sandbox --output-format text -p "$prompt"
rc=$?
# 0 ok | non-zero: no response, or an error. agy reports the reason itself.
[[ $rc -ne 0 ]] && echo "(agy exited $rc — run 'ask-gemini --check' if this looks like a sign-in problem)" >&2
exit $rc
