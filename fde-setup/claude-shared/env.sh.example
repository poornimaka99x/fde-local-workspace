# Copy to ~/.claude-shared/env.sh and fill in. That file is gitignored.
# Source it from your shell rc AFTER claude-profiles.sh.
#
# What does NOT belong here:
#
#   AWS_PROFILE / AWS_REGION for Bedrock.  They live in
#   ~/.claude-profiles/bedrock/settings.json and nowhere else. Two sources of
#   truth is how the wrapper ended up overriding the profile with an AWS profile
#   that did not exist.
#
#   The Copilot Studio Direct Line secret.  A globally sourced env file is
#   readable by every process you run, and Microsoft's guidance is that a Direct
#   Line secret is a service-side credential — exposed clients get
#   conversation-scoped tokens instead. Put it in the Keychain:
#
#       security add-generic-password -a "$USER" -s fde-copilot-directline -w
#
#   ask-ms-copilot reads it from there at call time and never prints it.
#   Check it resolved:  ask-ms-copilot --check

# --- Atlassian (Jira + Confluence) -------------------------------------------
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Used by the `confluence` CLI. The Rovo MCP server authenticates separately,
# over OAuth, inside a Claude session.
export CONFLUENCE_BASE_URL="https://maxedadiy.atlassian.net"
export CONFLUENCE_EMAIL="you@diymaxeda.com"
export CONFLUENCE_API_TOKEN=""

# --- Microsoft Copilot (Microsoft 365 / Copilot Studio, NOT GitHub Copilot) ---
# Only for tenants that expose a token endpoint rather than a Direct Line secret.
# If you have a secret, use the Keychain command above instead of a variable.
# export COPILOT_TOKEN_ENDPOINT=""
# export COPILOT_TIMEOUT="90"
