{
  "schemaVersion": 1,
  "name": "forward-deployed-engineer",
  "label": "Forward Deployed Engineer",
  "revision": "2026-09-11.1",
  "description": "The full forward-deployed delivery lifecycle: business intent through operations, with an independent reviewer at every stage.",
  "_ownership": "Built-in data, layer 8 of the precedence order in docs/FDE-CAPABILITY-MODEL.md. Resolution reads it and never writes it, and an upgrade that replaces this file cannot reach any operator layer.",
  "_unlisted": "A stage bundle is a selection, so a capability this file does not name is not selected for that stage. That is what `unlistedDefault` says, and it is why adding a capability to FDE does not silently widen an existing stage.",
  "_optional": "`optional` is the spec's 'when applicable' set: real capabilities this stage can use, deliberately not on by default because they are conditional on the work (a database in scope, designs in scope, a cloud in scope). The console offers them; nothing enables them on its own.",
  "_mcpScopes": "Declared here and enforced in the MCP permission phase. Recording the intended scope with the bundle keeps the two from drifting while the enforcement is built.",
  "unlistedDefault": "disabled",
  "protected": [
    "plugin:fde"
  ],
