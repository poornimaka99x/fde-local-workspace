  "_unroutable": "Identities whose surface exposes no model or effort choice. They remain fully assignable to roles; the router simply reports that it has nothing to select for them rather than inventing a combination.",
  "unroutableKinds": {
    "gemini": "one-shot headless call with no model or effort selection through this toolkit",
    "copilot-studio": "a chat endpoint over the Microsoft estate; model and effort are the tenant's, not this controller's"
  },
