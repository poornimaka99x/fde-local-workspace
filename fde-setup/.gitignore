# Runtime state, never source. Runs hold client material, task files and the
# approval ledger; they belong to the machine, not to the repository.
runs/
!fde-gui/web/src/features/runs/
!fde-gui/web/src/features/runs/**
!claude-shared/runs/
claude-shared/runs/*
!claude-shared/runs/.gitkeep

# Secrets and local material
env.sh
.env.sh
claude-shared/env.sh
claude-shared/.env.sh
intake/
claude-shared/intake/

# Archives. A gitignored secret can still ride into the repository inside a
# tarball, so no archive is ever source here.
*.tgz
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip

# Quarantine for material staged for manual deletion. Never source.
_to_delete/

# Dependencies and build output
node_modules/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vite/
*.tsbuildinfo

.DS_Store
__pycache__/
*.pyc
