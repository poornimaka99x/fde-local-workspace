# Runtime state, never source. Runs hold client material, task files and the
# approval ledger; they belong to the machine, not to the repository.
runs/
!fde-gui/web/src/features/runs/
!fde-gui/web/src/features/runs/**
!claude-shared/runs/
claude-shared/runs/*
!claude-shared/runs/.gitkeep

# The operator's own capability decisions, and the record of them. Machine
# state: the built-in defaults are config/workflows/ and config/security-policy.json.
claude-shared/config/capability-config.json
claude-shared/config/capability-policy.json
claude-shared/config/capability-policy.json.migrated
claude-shared/config/capability-events.jsonl

# Secrets and local material
env.sh
.env.sh
claude-shared/env.sh
claude-shared/.env.sh
intake/
claude-shared/intake/

# Archives. A gitignored secret can still ride into the repository inside a
# tarball, so no archive is ever source here.
*.tgz
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip

# Quarantine for material staged for manual deletion. Never source.
_to_delete/

# Superseded plugin trees kept for rollback. Machine state, not source: the
# lock file beside each installed plugin is what records its provenance.
fde-toolkit/plugins/.versions/

# Dependencies and build output
node_modules/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vite/
*.tsbuildinfo

.DS_Store
__pycache__/
*.pyc
