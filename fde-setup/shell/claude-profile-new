#!/usr/bin/env bash
# Create a new Claude Code profile: its own config dir and auth, but the same
# shared context, skills and agents as every other profile.
set -euo pipefail

name="${1:-}"
if [[ -z "$name" ]]; then
  echo "usage: claude-profile-new <name> [--bedrock --aws-profile NAME --aws-region REGION]" >&2
  echo "       claude-profile-new <name> --omniroute --combo NAME [--base-url URL]" >&2
  exit 1
fi
shift

bedrock=false
omniroute=false
base_url="http://localhost:20128"
combo=""
aws_profile="${FDE_BEDROCK_AWS_PROFILE:-bedrock-dev}"
aws_region="${FDE_BEDROCK_AWS_REGION:-eu-west-1}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bedrock) bedrock=true; shift ;;
    --omniroute) omniroute=true; shift ;;
    --base-url)
      [[ $# -ge 2 ]] || { echo "--base-url needs a value" >&2; exit 2; }
      base_url="${2%/}"; shift 2 ;;
    --combo)
      [[ $# -ge 2 ]] || { echo "--combo needs a value" >&2; exit 2; }
      combo="$2"; shift 2 ;;
    --aws-profile)
      [[ $# -ge 2 ]] || { echo "--aws-profile needs a value" >&2; exit 2; }
      aws_profile="$2"; shift 2 ;;
    --aws-region)
      [[ $# -ge 2 ]] || { echo "--aws-region needs a value" >&2; exit 2; }
      aws_region="$2"; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
# Keep the shipped `claude-profile-new bedrock` and installer behavior while
# allowing any user-chosen account name to be a Bedrock account via --bedrock.
[[ "$name" == "bedrock" ]] && bedrock=true

SHARED="${CLAUDE_SHARED:-$HOME/.claude-shared}"
dir="$HOME/.claude-profiles/$name"

mkdir -p "$dir"

# Every profile gets every plugin the fde-toolkit marketplace ships (fde-core
# carries /engage and the other FDE skills, commands and agents), whatever its
# provider: a run resumed on any profile must still have /engage. The list is
# read from marketplace.json, so a plugin added there reaches new profiles too.
# FDE_SKIP_PLUGIN_INSTALL=1 skips this (install.sh installs them itself).
install_fde_plugins() {
  [[ "${FDE_SKIP_PLUGIN_INSTALL:-0}" == "1" ]] && return 0
  local market="$SHARED/fde-toolkit" plugin missing=0
  if ! command -v claude >/dev/null 2>&1; then
    echo "(claude CLI not on PATH — FDE plugins not installed; rerun this command once it is)"
    return 0
  fi
  if [[ ! -f "$market/.claude-plugin/marketplace.json" ]]; then
    echo "(no fde-toolkit marketplace at $market — run ./install.sh first)"
    return 0
  fi
  CLAUDE_CONFIG_DIR="$dir" claude plugin marketplace add "$market" >/dev/null 2>&1 || \
    CLAUDE_CONFIG_DIR="$dir" claude plugin marketplace update fde-toolkit >/dev/null 2>&1 || true
  while IFS= read -r plugin; do
    if CLAUDE_CONFIG_DIR="$dir" claude plugin install "$plugin@fde-toolkit" >/dev/null 2>&1; then
      echo "  installed $plugin"
    else
      missing=1
      echo "  ($plugin not installed — run: CLAUDE_CONFIG_DIR=$dir claude plugin install $plugin@fde-toolkit)"
    fi
  done < <(python3 - "$market/.claude-plugin/marketplace.json" <<'PYEOF'
import json, re, sys
for entry in json.load(open(sys.argv[1], encoding="utf-8")).get("plugins", []):
    name = entry.get("name")
    if isinstance(name, str) and re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
        print(name)
PYEOF
)
  (( missing )) && echo "  (a plugin that needs sign-in first: run CLAUDE_CONFIG_DIR=$dir claude once, then rerun claude-profile-new $name)"
  return 0
}

# Shared context: symlinked, so editing it once changes every profile.
ln -sfn "$SHARED/CLAUDE.md" "$dir/CLAUDE.md"
ln -sfn "$SHARED/shared"    "$dir/shared"

# Per-profile settings live here and are NOT shared — /setup-bedrock writes into
# this file, and that must not reach your subscription profiles.
#
# Bedrock values are written for provider compatibility and are also exported
# by the FDE account launcher. The account registry is therefore the editable
# source of truth while direct CLI use of the profile still behaves correctly.
deny='"Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"'

if [[ "$omniroute" == true ]]; then
  # A session-limit fallback through a local OmniRoute gateway. Every model alias
  # resolves to the one approved combo, and the key is read from a 0600 file by
  # apiKeyHelper, so it never sits in the environment or a process list.
  [[ "$combo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && ! "$combo" =~ ^auto$ ]] || {
    echo "--omniroute needs --combo <name> (a named combo; 'auto' is refused)" >&2; exit 2; }
  [[ "$base_url" =~ ^(http://(localhost|127\.0\.0\.1)(:[0-9]{2,5})?|https://[A-Za-z0-9.-]+(:[0-9]{2,5})?)$ ]] || {
    echo "--base-url must be http://localhost[:port] or an https URL, without /v1" >&2; exit 2; }
  chmod 700 "$dir"
  if [[ ! -f "$dir/settings.json" ]]; then
    cat > "$dir/settings.json" <<JSON
{
  "includeCoAuthoredBy": false,
  "apiKeyHelper": "cat '$dir/omniroute-api-key'",
  "env": {
    "ANTHROPIC_BASE_URL": "$base_url",
    "ANTHROPIC_MODEL": "$combo",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "$combo",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "$combo",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "$combo",
    "CLAUDE_CODE_SUBAGENT_MODEL": "$combo",
    "ANTHROPIC_CUSTOM_HEADERS": "x-omniroute-compression: off"
  },
  "permissions": {
    "deny": [
      $deny,
      "Read(/$dir/omniroute-api-key)"
    ]
  }
}
JSON
    chmod 600 "$dir/settings.json"
  fi
  install_fde_plugins
  echo "omniroute profile '$name' ready at $dir"
  echo "next: store the key with  pbpaste | fde accounts set-secret omniroute_$name"
  echo "      then check it with  fde accounts verify omniroute_$name"
  exit 0
fi

if [[ ! -f "$dir/settings.json" ]]; then
  if [[ "$bedrock" == true ]]; then
    cat > "$dir/settings.json" <<JSON
{
  "includeCoAuthoredBy": false,
  "env": {
    "AWS_PROFILE": "$aws_profile",
    "AWS_REGION": "$aws_region"
  },
  "permissions": {
    "deny": [
      $deny
    ]
  }
}
JSON
  else
    cat > "$dir/settings.json" <<JSON
{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      $deny
    ]
  }
}
JSON
  fi
fi

install_fde_plugins

echo "profile '$name' ready at $dir"
echo "next: CLAUDE_CONFIG_DIR=$dir claude   # sign in; FDE plugins, skills and /engage are already installed"
